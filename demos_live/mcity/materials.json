{
  "_comment": [
    "Surface colours for Mcity scenery assets, matched by substring against the asset name.",
    "",
    "Why this file exists: the USD assets bind Omniverse MDL materials whose definitions live in",
    "an external Materials/*.mdl library, and only 3 of 139 assets carry a BaseColorMap directly",
    "in the USD. Without those MDL files every asset resolves to the same default and the scene",
    "renders uniformly grey. Rather than parse MDL, this assigns a plausible surface per asset",
    "class -- asphalt is dark, lane paint is white, vegetation is green, signal housings are",
    "near-black. It is an approximation of appearance, not a substitute for the real textures.",
    "",
    "Rules are tried in order and the first substring match wins, so put specific names above",
    "general ones. Edit freely: the converter reads this at conversion time, and nothing here is",
    "compiled in.",
    "",
    "Fields: kd diffuse, ks specular (optional), ns shininess (optional)."
  ],

  "default": { "kd": [0.62, 0.62, 0.64] },

  "rules": [
    { "match": "LaneMarking",      "kd": [0.90, 0.90, 0.88], "ks": [0.10, 0.10, 0.10], "ns": 12 },
    { "match": "Roads",            "kd": [0.20, 0.20, 0.22], "ks": [0.04, 0.04, 0.04], "ns": 8 },
    { "match": "Sidewalk",         "kd": [0.58, 0.57, 0.54] },
    { "match": "Curb",             "kd": [0.66, 0.65, 0.62] },
    { "match": "TrafficIsland",    "kd": [0.60, 0.59, 0.56] },
    { "match": "Ground",           "kd": [0.34, 0.40, 0.26] },
    { "match": "Terrain",          "kd": [0.34, 0.40, 0.26] },
    { "match": "Grass",            "kd": [0.28, 0.42, 0.20] },

    { "match": "TrafficLightCable","kd": [0.10, 0.10, 0.11] },
    { "match": "TrafficLight",     "kd": [0.12, 0.13, 0.12], "ks": [0.20, 0.20, 0.20], "ns": 30 },
    { "match": "SignPost",         "kd": [0.55, 0.56, 0.58], "ks": [0.30, 0.30, 0.30], "ns": 40 },
    { "match": "SignBlade",        "kd": [0.12, 0.32, 0.18] },
    { "match": "Sign",             "kd": [0.85, 0.85, 0.83] },
    { "match": "Rect_",            "kd": [0.85, 0.85, 0.83] },

    { "match": "mPoles01",         "kd": [0.48, 0.49, 0.52], "ks": [0.30, 0.30, 0.30], "ns": 40 },
    { "match": "StreetLight",      "kd": [0.40, 0.41, 0.44], "ks": [0.30, 0.30, 0.30], "ns": 40 },
    { "match": "CameraSensor",     "kd": [0.16, 0.16, 0.18] },
    { "match": "Pole",             "kd": [0.48, 0.49, 0.52] },
    { "match": "Bollard",          "kd": [0.72, 0.55, 0.12] },

    { "match": "JerseyBarrier",    "kd": [0.70, 0.69, 0.66] },
    { "match": "BarrierNose",      "kd": [0.80, 0.55, 0.10] },
    { "match": "SandBarrel",       "kd": [0.85, 0.45, 0.08] },
    { "match": "GuardRail",        "kd": [0.60, 0.61, 0.64], "ks": [0.35, 0.35, 0.35], "ns": 50 },
    { "match": "Fence",            "kd": [0.42, 0.44, 0.42] },
    { "match": "LeafGate",         "kd": [0.30, 0.42, 0.26] },

    { "match": "Facade",           "kd": [0.66, 0.60, 0.52] },
    { "match": "Building",         "kd": [0.66, 0.60, 0.52] },
    { "match": "WaterTower",       "kd": [0.58, 0.60, 0.63] },
    { "match": "WaterStorage",     "kd": [0.58, 0.60, 0.63] },
    { "match": "Rock",             "kd": [0.44, 0.42, 0.40] },
    { "match": "FireHydrant",      "kd": [0.72, 0.14, 0.10] },
    { "match": "TrashCan",         "kd": [0.24, 0.30, 0.24] },
    { "match": "ParkingMeter",     "kd": [0.30, 0.31, 0.34] },
    { "match": "ElectricalBox",    "kd": [0.50, 0.52, 0.50] },
    { "match": "BusStopShelter",   "kd": [0.34, 0.36, 0.40] },
    { "match": "BikeRack",         "kd": [0.36, 0.37, 0.40] },
    { "match": "BasketballHoop",   "kd": [0.55, 0.56, 0.58] },
    { "match": "Table",            "kd": [0.52, 0.42, 0.30] },
    { "match": "GPSBlocker",       "kd": [0.46, 0.47, 0.50] }
  ]
}
