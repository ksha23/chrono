{"nodes": [{"id": "doxygen_documentation_tutorials_solidworks_demo_engine_advanced_importsolidworkssystem", "label": "chrono.ImportSolidWorksSystem", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine_advanced.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Loads the exported model by module name without the .py suffix and requires an explicit './' prefix even in the current directory; returns exported items which the caller adds to a ChSystemNSC."}, {"id": "doxygen_documentation_tutorials_solidworks_demo_engine_advanced_chpythonengine_import", "label": "ChPythonEngine::ImportSolidWorksSystem (C++)", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine_advanced.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "C++ cannot load the exported .py directly, so the PYTHON module must be linked and an embedded ChPythonEngine used to obtain the same effect."}, {"id": "doxygen_documentation_tutorials_solidworks_demo_engine_advanced_searchmarker_coordinate_frames", "label": "Exported Coordinate Systems as ChMarker", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine_advanced.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adding a named SolidWorks CoordinateSystem feature and fetching it via ChSystem::SearchMarker is smarter than typing a ChFramed by hand, because the CAD already knows the exact position and axis direction."}, {"id": "doxygen_documentation_tutorials_solidworks_demo_engine_advanced_chlinkmotorrotationspeed_crank_motor", "label": "ChLinkMotorRotationSpeed Crank Motor", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine_advanced.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The exporter emits only mating constraints, never actuation, so a driving motor must be added in user code between the crankshaft and ground; the Z axis of the supplied frame is the rotation axis, SetSpindleConstraint picks the connection type and SetMotorFunction takes a ChFunction."}, {"id": "doxygen_documentation_tutorials_solidworks_demo_engine_advanced_chpovrayassetcustom", "label": "ChPovRayAssetCustom Material Override", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine_advanced.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default rendered surfaces look like white chalk; attaching a custom POVray statement fragment as an asset on a body lets per-shape pigments/finishes be injected into the generated scripts without changing the exporter."}, {"id": "doxygen_documentation_tutorials_solidworks_demo_engine_advanced_chbodyauxref_reference_frame", "label": "ChBodyAuxRef Reference Frame vs COG", "file_type": "rationale", "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine_advanced.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exported bodies are ChBodyAuxRef, not ChBody, because ChBody assumes the center of mass coincides with the body reference frame while a CAD part's origin generally does not; the COG is computed by SolidWorks from assigned material densities. For a rigid sub-assembly the reference frame is the sub-assembly origin."}, {"id": "doxygen_documentation_tutorials_solidworks_demo_engine_advanced_chcamera_attached_to_body", "label": "ChCamera Attached to a Moving Body", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine_advanced.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "doxygen_documentation_tutorials_solidworks_demo_engine_advanced_importsolidworkssystem", "target": "doxygen_documentation_tutorials_solidworks_demo_engine_engine_py_exported_system", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine_advanced.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_solidworks_demo_engine_advanced_chpythonengine_import", "target": "doxygen_documentation_tutorials_solidworks_demo_engine_advanced_importsolidworkssystem", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine_advanced.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_solidworks_demo_engine_advanced_chlinkmotorrotationspeed_crank_motor", "target": "doxygen_documentation_tutorials_solidworks_demo_engine_advanced_searchmarker_coordinate_frames", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine_advanced.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_solidworks_demo_engine_advanced_chlinkmotorrotationspeed_crank_motor", "target": "doxygen_documentation_tutorials_solidworks_demo_engine_solidworks_mate_to_chlink_export", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine_advanced.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_solidworks_demo_engine_advanced_chpovrayassetcustom", "target": "doxygen_documentation_tutorials_solidworks_demo_engine_povray_postprocessing_pipeline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/do