{"nodes": [{"id": "doxygen_documentation_manuals_solidworks_manual_chrono_solidworks_chrono_solidworks", "label": "Chrono::SolidWorks Add-In", "file_type": "document", "source_file": "doxygen/documentation/manuals/solidworks/manual_chrono_solidworks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exports Assemblies (not single Parts) with materials, appearances, Standard mates plus Mechanical>Hinge, collision shapes and Chrono motors. Each SubAssembly is treated as one rigid body unless marked Flexible, which is what keeps exported models tractable."}, {"id": "doxygen_documentation_manuals_solidworks_manual_chrono_solidworks_export_targets", "label": "SolidWorks Export Targets (Python, C++, JSON)", "file_type": "concept", "source_file": "doxygen/documentation/manuals/solidworks/manual_chrono_solidworks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Python output runs under PyChrono or is parsed from C++ via Chrono::Parsers (still needing PyChrono installed); C++ output must be compiled with the user project, limiting but useful for testing; JSON output is deserialized through the Chrono serialization feature."}, {"id": "doxygen_documentation_manuals_solidworks_manual_chrono_solidworks_collision_shape_specification", "label": "Collision Shape Specification", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/solidworks/manual_chrono_solidworks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Collision is opt-in and set on Solid Bodies rather than Parts because contact is among the most expensive simulation steps. Primitives are cheapest and are preferred by wrapping complex bodies in a simple shape whose material becomes Air; meshes cover the rest but are less robust and are sphere-swept, trading collision accuracy for robustness as the radius grows. Convex decomposition is not yet implemented, and the operation is not undoable."}, {"id": "doxygen_documentation_manuals_solidworks_manual_chrono_solidworks_motor_placeholder", "label": "Coordinate System Motor Placeholder", "file_type": "concept", "source_file": "doxygen/documentation/manuals/solidworks/manual_chrono_solidworks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A top-level Coordinate System acts as the placeholder where a ChLinkMotor is instantiated at export time; the custom motor property attached to it is transparent to SolidWorks installations without the add-in, so models stay openable."}], "edges": [{"source": "doxygen_documentation_manuals_solidworks_manual_chrono_solidworks_chrono_solidworks", "target": "doxygen_documentation_manuals_solidworks_manual_chrono_solidworks_export_targets", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/solidworks/manual_chrono_solidworks.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_solidworks_manual_chrono_solidworks_export_targets", "target": "doxygen_documentation_manuals_parsers_manual_parsers_chrono_parsers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/solidworks/manual_chrono_solidworks.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_solidworks_manual_chrono_solidworks_export_targets", "target": "doxygen_documentation_manuals_pychrono_pychrono_introduction_pychrono", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/solidworks/manual_chrono_solidworks.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_solidworks_manual_chrono_solidworks_collision_shape_specification", "target": "doxygen_documentation_manuals_solidworks_manual_chrono_solidworks_chrono_solidworks", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/solidworks/manual_chrono_solidworks.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_solidworks_manual_chrono_solidworks_chrono_solidworks", "target": "doxygen_documentation_manuals_solidworks_manual_chrono_solidworks_motor_placeholder", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/solidworks/manual_chrono_solidworks.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_solidworks_manual_chrono_solidworks_chrono_solidworks", "target": "doxygen_documentation_manuals_parsers_manual_parsers_importsolidworkssystem", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "doxygen/documentation/manuals/solidworks/manual_chrono_solidworks.md", "source_location": null, "weight": 1.0}], "hyperedges": []}