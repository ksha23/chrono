{"nodes": [{"id": "doxygen_documentation_tutorials_solidworks_demo_shapes_demo_collision_shapes", "label": "Demo Collision Shapes Tutorial", "file_type": "document", "source_file": "doxygen/documentation/tutorials/solidworks/demo_shapes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_tutorials_solidworks_demo_shapes_opt_in_collision_shapes", "label": "Opt-in Collision Shape Assignment", "file_type": "rationale", "source_file": "doxygen/documentation/tutorials/solidworks/demo_shapes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SolidWorks parts generate no collision shapes by default for two reasons: only the parts that need collisions should pay the computational overhead, and there is no reliable automatic conversion of detailed concave geometry into Chrono collision shapes (automatic convex decomposition is under development, and hand-placed convex shapes usually still win). Supported primitives are spheres, cylinders, boxes, convex hulls, and groups of these."}, {"id": "doxygen_documentation_tutorials_solidworks_demo_shapes_solid_body_as_collision_shape", "label": "SolidWorks Solid Body as Collision Primitive", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/solidworks/demo_shapes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A part may hold several SolidWorks 'solid bodies' (not Chrono rigid bodies); an extra extruded or copied body is tagged with 'Set body as collision shape'. Merge results must be unchecked or SolidWorks fuses it back into the visual body. Once tagged the body must not be edited further (e.g. cutting a hole) or it stops being recognized as a primitive at export time."}, {"id": "doxygen_documentation_tutorials_solidworks_demo_shapes_zero_density_air_material", "label": "Zero-density Air Material on Collision Bodies", "file_type": "rationale", "source_file": "doxygen/documentation/tutorials/solidworks/demo_shapes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The tool assigns the zero-density 'Air' material to the collision body so SolidWorks' mass computation is not doubled by the overlapping proxy; the visual body keeps the real material (steel, concrete...). The proxy is also recolored semi-transparent pink since it overlaps the real shape."}, {"id": "doxygen_documentation_tutorials_solidworks_demo_shapes_collision_envelope_margin", "label": "Collision Envelope and Margin Defaults", "file_type": "rationale", "source_file": "doxygen/documentation/tutorials/solidworks/demo_shapes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SetDefaultSuggestedEnvelope/Margin must be called before importing the model or creating the ChSystem, because they are defaults baked into collision models at construction. Tuning matters most for very large or very small objects; with compliant materials the envelope should be set to 0."}, {"id": "doxygen_documentation_tutorials_solidworks_demo_shapes_contact_material_compliance", "label": "Compliant Contact Material (ChContactMaterialNSC)", "file_type": "rationale", "source_file": "doxygen/documentation/tutorials/solidworks/demo_shapes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single shared surface material carries friction and, optionally, Rayleigh damping plus normal and tangential compliance. Compliance requires smaller time steps and a zero collision envelope, which is the cost of modeling elasticity this way."}, {"id": "doxygen_documentation_tutorials_solidworks_demo_shapes_restitution_coefficient", "label": "Restitution Coefficient", "file_type": "rationale", "source_file": "doxygen/documentation/tutorials/solidworks/demo_shapes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Non-compliant materials are perfectly inelastic; a non-zero restitution coefficient is the cheap way to get bounce, but it is meaningless once compliance is enabled and is not physically accurate outside very simple scenarios because it rests on the simple Newton restitution assumption."}, {"id": "doxygen_documentation_tutorials_solidworks_demo_shapes_earthquake_motion_law", "label": "Earthquake Motion Law via ChLinkLockLock", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/solidworks/demo_shapes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The CAD-fixed floor is unfixed and re-attached to the always-present 'ground' body through a lock link whose X motion is a ChFunctionOperator product of two ChFunctionSine harmonics, so shaking is imposed kinematically rather than by forces."}, {"id": "doxygen_documentation_tutorials_solidworks_demo_shapes_deactivated_mates", "label": "Deactivated Mates to Suppress Export", "file_type": "rationale", "source_file": "doxygen/documentation/tutorials/solidworks/demo_shapes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mates used only to position stacked columns are deactivated (ghosted) before export; left active they would become real Chrono joints and the building could not collapse during the earthquake."}], "edges": [{"source": "doxygen_documentation_tutorials_solidworks_demo_shapes_demo_collision_shapes", "target": "doxygen_documentation_tutorials_solidworks_demo_shapes_opt_in_collision_shapes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/solidworks/demo_shapes.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_solidworks_demo_shapes_solid_body_as_collision_shape", "target": "doxygen_documentation_tutorials_solidworks_demo_shapes_opt_in_collision_shapes", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/solidworks/demo_shapes.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_solidworks_demo_shapes_zero_density_air_material", "target": "doxygen_documentation_tutorials_solidworks_demo_shapes_solid_body_as_collision_shape", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/solidworks/demo_shapes.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_solidworks_demo_shapes_solid_body_as_collision_shape", "target": "doxygen_documentation_tutorials_solidworks_demo_engine_assembly_to_python_export", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/solidworks/demo_shapes.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_solidworks_demo_shapes_collision_envelope_margin", "target": "doxygen_documentation_tutorials_solidworks_demo_shapes_contact_material_compliance", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/solidworks/demo_shapes.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_solidworks_demo_shapes_restitution_coefficient", "target": "doxygen_documentation_tutorials_solidworks_demo_shapes_contact_material_compliance", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/solidworks/demo_shapes.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_solidworks_demo_shapes_earthquake_motion_law", "target": "doxygen_documentation_tutorials_solidworks_demo_engine_advanced_name_based_lookup", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/solidworks/demo_shapes.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_solidworks_demo_shapes_earthquake_motion_law", "target": "doxygen_documentation_tutorials_solidworks_demo_engine_advanced_chlinkmotorrotationspeed", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "doxygen/documentation/tutorials/solidworks/demo_shapes.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_solidworks_demo_shapes_deactivated_mates", "target": "doxygen_documentation_tutorials_solidworks_demo_engine_mate_to_chlink_mapping", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/solidworks/demo_shapes.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_solidworks_demo_shapes_opt_in_collision_shapes", "target": "doxygen_documentation_tutorials_pychrono_pychrono_tutorials_mesh_collision_tradeoff", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "doxygen/documentation/tutorials/solidworks/demo_shapes.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_solidworks_demo_shapes_demo_collision_shapes", "target": "doxygen_documentation_tutorials_solidworks_demo_engine_povray_rendering_pipeline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/solidworks/demo_shapes.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_solidworks_demo_shapes_opt_in_collision_shapes", "target"