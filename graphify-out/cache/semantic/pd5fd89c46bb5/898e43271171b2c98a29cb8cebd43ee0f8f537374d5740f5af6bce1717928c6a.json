{"nodes": [{"id": "doxygen_documentation_tutorials_pychrono_demo_tensorflow_deep_reinforcement_learning", "label": "Deep Reinforcement Learning with PyChrono", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/pychrono/demo_tensorflow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Training in a virtual physics environment instead of on real hardware cuts both the time and the risk of the operation, and DRL copes with unstructured, mutable environments where classical robotic control fails."}, {"id": "doxygen_documentation_tutorials_pychrono_demo_tensorflow_gym_chrono", "label": "gym-chrono OpenAI Gym Environments", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/pychrono/demo_tensorflow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Offered as an open-source alternative to MuJoCo environments for users who want to leverage OpenAI Gym and Baselines."}, {"id": "doxygen_documentation_tutorials_pychrono_demo_tensorflow_proximal_policy_optimization", "label": "Proximal Policy Optimization (PPO)", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/pychrono/demo_tensorflow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On-policy actor-critic algorithm, so the code carries two networks: a Policy that maps state to action and a Value Function that scores the state."}, {"id": "doxygen_documentation_tutorials_pychrono_demo_tensorflow_policy_and_vf_networks", "label": "Policy.py and VF.py Networks", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/pychrono/demo_tensorflow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_tutorials_pychrono_demo_tensorflow_chronopendulum_env", "labe