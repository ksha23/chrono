{"nodes": [{"id": "doxygen_documentation_manuals_sensor_lidar_sensor_chlidarsensor", "label": "ChLidarSensor", "file_type": "concept", "source_file": "doxygen/documentation/manuals/sensor/lidar_sensor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each lidar beam is sampled by a group of rays whose count and divergence angle the user sets; returned intensity is based on diffuse reflectance. A near clipping distance keeps the sensor's own housing geometry out of the returns."}, {"id": "doxygen_documentation_manuals_sensor_lidar_sensor_motion_blur_keyframes", "label": "Lidar Scan Keyframes and Motion Blur", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/sensor/lidar_sensor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The whole scan is processed in one render step for efficiency, but rays across a scan occur at different times; keyframes and motion blur let each beam trace the scene at its own timestamp so object and sensor motion during the sweep is reproduced."}, {"id": "doxygen_documentation_manuals_sensor_lidar_sensor_chfilterpcfromdepth", "label": "ChFilterPCfromDepth", "file_type": "concept", "source_file": "doxygen/documentation/manuals/sensor/lidar_sensor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_sensor_lidar_sensor_chfilterlidarnoisexyzi", "label": "ChFilterLidarNoiseXYZI", "file_type": "concept", "source_file": "doxygen/documentation/manuals/sensor/lidar_sensor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "doxygen_documentation_manuals_sensor_lidar_sensor_chlidarsensor", "target": "doxygen_documentation_manuals_sensor_camera_sensor_optix_ray_tracing", "relation": "implements", "confidence": "EXTRAC