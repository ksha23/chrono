{"nodes": [{"id": "src_chrono_vehicle_fmi_cmakelists_vehicle_fmu_main_dir", "label": "VEHICLE_FMU_MAIN_DIR Common FMU Output Directory", "file_type": "concept", "source_file": "src/chrono_vehicle/fmi/CMakeLists.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All Chrono::Vehicle FMUs are emitted into one vehicleFMU output directory and the path is exported to C++ via generated ChConfigVehicleFMI.h, so co-simulation drivers can locate FMUs at run time without hard-coded paths."}, {"id": "src_chrono_vehicle_fmi_cmakelists_fmu_forge_fetchcontent", "label": "fmu-forge FetchContent FMU Build Pattern", "file_type": "rationale", "source_file": "src/chrono_vehicle/fmi/CMakeLists.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every FMU subdirectory sets COMPONENT_NAME / COMPONENT_SOURCES / COMPONENT_CHRONO_DEPENDENCIES / COMPONENT_RESOURCES_DIR and then pulls fmu-forge's fmi2 CMake project in via FetchContent_Declare(SOURCE_DIR ...) + FetchContent_MakeAvailable. The fetched project defines the FMU target; the local file then attaches sources and libraries to it. This convention-over-configuration pattern keeps each FMU CMakeLists nearly identical and hides FMI packaging details in fmu-forge."}], "edges": [{"source": "src_chrono_vehicle_fmi_cmakelists_vehicle_fmu_main_dir", "target": "src_chrono_vehicle_fmi_cosim_cmakelists_cosim_fmu_set", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/chrono_vehicle/fmi/CMakeLists.txt", "source_location": null, "weight": 1.0}, {"source": "src_chrono_vehicle_fmi_cmakelists_vehicle_fmu_main_dir", "target": "src_chrono_vehicle_fmi_modex_cmakelists_modex_fmu_set", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/chrono_vehicle/fmi/CMakeLists.txt", "source_location": null, "weight": 1.0}, {"source": "