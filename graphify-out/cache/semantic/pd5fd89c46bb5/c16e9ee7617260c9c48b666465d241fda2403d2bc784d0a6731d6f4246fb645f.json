"file_type": "rationale", "source_file": "doxygen/documentation/tutorials/pychrono/pychrono_tutorials.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Collision detection against generic concave meshes is slower and less robust than primitive shapes, so meshes should only be used when spheres/boxes/cylinders or clusters of them are too complex to author. The recommended compromise is a detailed mesh for visualization plus a few simple primitives for collision."}, {"id": "doxygen_documentation_tutorials_pychrono_pychrono_tutorials_watertight_mesh_requirement", "label": "Watertight Mesh Requirement", "file_type": "rationale", "source_file": "doxygen/documentation/tutorials/pychrono/pychrono_tutorials.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A .obj used for collision must be watertight (no edge gaps, no repeated vertices) or the collision result is undefined; MeshLab can verify topological correctness. Visualization-only meshes need not be watertight but do need correct normals."}, {"id": "doxygen_documentation_tutorials_pychrono_pychrono_tutorials_demo_fea_beamsiga", "label": "demo_FEA_beamsIGA.py (Jeffcott rotor)", "file_type": "document", "source_file": "doxygen/documentation/tutorials/pychrono/pychrono_tutorials.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_tutorials_pychrono_pychrono_tutorials_demo_veh_hmmwv", "label": "demo_VEH_HMMWV.py", "file_type": "document", "source_file": "doxygen/documentation/tutorials/pychrono/pychrono_tutorials.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_tutorials_pychrono_pychrono_tutorials_demo_veh_wheeledjson", "label": "demo_VEH_WheeledJSON.py", "file_type": "document", "source_file": "doxygen/documentation/tutorials/pychrono/pychrono_tutorials.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_tutorials_pychrono_pychrono_tutorials_demo_cas_robot", "label": "demo_CAS_robot.py", "file_type": "document", "source_file": "doxygen/documentation/tutorials/pychrono/pychrono_tutorials.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_tutorials_pychrono_pychrono_tutorials_tensorflow_training", "label": "PyChrono + TensorFlow Actuator Control Training", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/pychrono/pychrono_tutorials.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Simulation is used as the training environment so a neural network controller can be learned without hardware in the loop."}], "edges": [{"source": "doxygen_documentation_tutorials_pychrono_pychrono_tutorials_pychrono_tutorials", "target": "doxygen_documentation_tutorials_python_chronopython_chrono_python_tutorials", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/pychrono/pychrono_tutorials.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_pychrono_pychrono_tutorials_pychrono_tutorials", "target": "doxygen_documentation_tutorials_pychrono_pychrono_tutorials_pychrono_module", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/pychrono/pychrono_tutorials.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_pychrono_pychrono_tutorials_pychrono_tutorials", "target": "doxygen_documentation_tutorials_pychrono_pychrono_tutorials_demo_ch_buildsystem", "relation": "references", "confidence": "EXTRACTED", "conf