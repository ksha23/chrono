{"nodes": [{"id": "doxygen_documentation_manuals_deme_deme_usage_deme_usage", "label": "DEM-Engine usage", "file_type": "document", "source_file": "doxygen/documentation/manuals/deme/deme_usage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_deme_deme_usage_deme", "label": "DEME (DEM-Engine) GPU DEM solver", "file_type": "concept", "source_file": "doxygen/documentation/manuals/deme/deme_usage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs on up to two GPUs, uses clumped-sphere particle shapes, and mirrors Chrono's API design so Chrono users can pick it up quickly."}, {"id": "doxygen_documentation_manuals_deme_deme_usage_clumped_spheres", "label": "Clumped-sphere particle representation", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/deme/deme_usage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Complex particle shapes are approximated by rigid clumps of spheres, which keeps contact detection cheap enough for GPU throughput."}, {"id": "doxygen_documentation_manuals_deme_deme_usage_custom_force_model", "label": "Customizable contact force models", "file_type": "concept", "source_file": "doxygen/documentation/manuals/deme/deme_usage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Users can add non-standard cohesive or electrostatic repulsive forces."}, {"id": "doxygen_documentation_manuals_deme_deme_usage_wildcards", "label": "Wildcards (custom per-entity properties)", "file_type": "concept", "source_file": "doxygen/documentation/manuals/deme/deme_usage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Arbitrary extra properties attached to simulation entities, usable inside the force model, mutable during the run and writable to output."}, {"id": "doxygen_documentation_manuals_deme_deme_usage_chrono_cosimulation", "label": "DEME-Chrono co-simulation", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/deme/deme_usage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DEME alone cannot express joint-connected multibody vehicles or mesh-mesh collisions, so it is used as a library that handles only the granular material while Chrono owns the multibody physics."}, {"id": "doxygen_documentation_manuals_deme_deme_usage_checkpoint_terrain", "label": "Checkpointed settled granular terrain", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/deme/deme_usage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Saving a settled terrain to a checkpoint file lets drawbar-pull tests start instantly instead of re-settling the bed each run."}, {"id": "doxygen_documentation_manuals_deme_deme_usage_ptx_version_mismatch", "label": "CUDA_ERROR_UNSUPPORTED_PTX_VERSION pitfall", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/deme/deme_usage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runtime CUDA must match the version used to compile, otherwise demos fail or silently detect no contacts."}], "edges": [{"source": "doxygen_documentation_manuals_deme_deme_usage_deme_usage", "target": "doxygen_documentation_manuals_deme_deme_usage_deme", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/deme/deme_usage.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_deme_deme_usage_deme", "target": "doxygen_documentation_manuals_deme_deme_usage_clumped_spheres",