{"nodes": [{"id": "doxygen_documentation_manuals_parsers_manual_parsers_chrono_parsers", "label": "Chrono::Parsers Module", "file_type": "document", "source_file": "doxygen/documentation/manuals/parsers/manual_parsers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bundles YAML model/simulation specification, third-party model import (URDF/OpenSim/Adams) and C++-to-Python interaction into one optional module so the Chrono core does not carry external parser library dependencies."}, {"id": "doxygen_documentation_manuals_parsers_manual_parsers_yaml_parsers", "label": "YAML Parsers", "file_type": "concept", "source_file": "doxygen/documentation/manuals/parsers/manual_parsers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parsers cache model information and simulation settings from YAML input files first, then populate a Chrono, Chrono::Vehicle or Chrono::FSI system, so model description is decoupled from system construction."}, {"id": "doxygen_documentation_manuals_parsers_manual_parsers_chpythonengine", "label": "ChPythonEngine", "file_type": "concept", "source_file": "doxygen/documentation/manuals/parsers/manual_parsers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs generic Python code from C++ and exchanges variable data; explicitly NOT PyChrono, which is the reverse direction (using Chrono from Python). The manual calls out the confusion because both involve Python plus Chrono."}, {"id": "doxygen_documentation_manuals_parsers_manual_parsers_importsolidworkssystem", "label": "ChPythonEngine::ImportSolidWorksSystem", "file_type": "concept", "source_file": "doxygen/documentation/manuals/parsers/manual_parsers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Imports SolidWorks-exported Python models into C++; the manual stresses this is not the only way to import SolidWorks models."}, {"id": "doxygen_documentation_manuals_parsers_manual_parsers_chmeshfileloader", "label": "ChMeshFileLoader", "file_type": "concept", "source_file": "doxygen/documentation/manuals/parsers/manual_parsers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lives in the main Chrono module rather than PARSERS so FE mesh import (Abaqus, TetGen, GMF/LS-DYNA, OBJ) needs no optional module; it is deliberately limited to specific elements and is not a full FE import tool."}, {"id": "doxygen_documentation_manuals_parsers_manual_parsers_third_party_model_import", "label": "Third-Party Model Import (URDF, OpenSim, Adams)", "file_type": "concept", "source_file": "doxygen/documentation/manuals/parsers/manual_parsers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "URDF import requires an external library, which is why these importers are gated behind the optional PARSERS module."}], "edges": [{"source": "doxygen_documentation_manuals_parsers_manual_parsers_chrono_parsers", "target": "doxygen_documentation_manuals_parsers_manual_parsers_yaml_parsers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/parsers/manual_parsers.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_parsers_manual_parsers_chrono_parsers", "target": "doxygen_documentation_manuals_parsers_manual_parsers_chpythonengine", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/parsers/manual_parsers.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_parsers_manual_parsers_chrono_parsers", "target": "doxygen_documentation_manuals_parsers_manual_parsers_third_party_model_import", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/parsers/manual_parsers.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_parsers_manual_parsers_chpythonengine", "target": "doxygen_documentation_manuals_parsers_manual_parsers_importsolidworkssystem", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/parsers/manual_parsers.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_parsers_manual_parsers_chrono_parsers", "target": "doxygen_documentation_manuals_parsers_manual_parsers_chmeshfileloader", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/parsers/manual_parsers.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_parsers_manual_parsers_chpythonengine", "target": "doxygen_documentation_manuals_pychrono_pychrono_introduction_pychrono", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/parsers/manual_parsers.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_parsers_manual_parsers_importsolidworkssystem", "target": "doxygen_documentation_manuals_solidworks_manual_chrono_solidworks_chrono_solidworks", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/parsers/manual_parsers.md", "source_location": null, "weight": 1.0}], "hyperedges": []}