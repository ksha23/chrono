{"nodes": [{"id": "doxygen_documentation_manuals_synchrono_vehicle_synchronization_vehicle_synchronization", "label": "Wheeled and Tracked Vehicle Synchronization", "file_type": "document", "source_file": "doxygen/documentation/manuals/synchrono/vehicle_synchronization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_synchrono_vehicle_synchronization_synwheeledvehicleagent", "label": "SynWheeledVehicleAgent", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/vehicle_synchronization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A thin wrapper around a ChWheeledVehicle pointer; description carries chassis, wheel and tire visual files plus wheel count so configurations beyond four wheels work, and state carries chassis plus per-wheel poses (tires share wheel poses)."}, {"id": "doxygen_documentation_manuals_synchrono_vehicle_synchronization_syntrackedvehicleagent", "label": "SynTrackedVehicleAgent", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/vehicle_synchronization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wraps a ChTrackedVehicle pointer; left and right meshes are sent separately for sprockets, idlers and road wheels since sides may differ, and counts are sent so arbitrary running-gear configurations reconstruct."}, {"id": "doxygen_documentation_manuals_synchrono_vehicle_synchronization_space_coherent_limitation", "label": "Space-coherent but not space-interactive", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/synchrono/vehicle_synchronization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only position and orientation are shared, never contact forces, so agents know about each other but cannot physically interact - the deliberate consequence of the weak-coupling assumption."}], "edges": [{"source": "doxygen_documentation_manuals_synchrono_vehicle_synchronization_vehicle_synchronization", "target": "doxygen_documentation_manuals_synchrono_vehicle_synchronization_synwheeledvehicleagent", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/synchrono/vehicle_synchronization.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_synchrono_vehicle_synchronization_vehicle_synchronization", "target": "doxygen_documentation_manuals_synchrono_vehicle_synchronization_syntrackedvehicleagent", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/synchrono/vehicle_synchronization.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_synchrono_vehicle_synchronization_vehicle_synchronization", "target": "doxygen_documentation_manuals_synchrono_vehicle_synchronization_space_coherent_limitation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/synchrono/vehicle_synchronization.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_synchrono_vehicle_synchronization_vehicle_synchronization", "target": "doxygen_documentation_manuals_synchrono_state_synchronization_state_synchronization", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/synchrono/vehicle_synchronization.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_synchrono_vehicle_synchronization_vehicle_synchronization", "target": "doxygen_documentation_manuals_vehicle_vehicle_overview_vehicle_overview", "relation": "references", "confidence": "EXTRACTED"