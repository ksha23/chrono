{"nodes": [{"id": "doxygen_documentation_manuals_vehicle_wheeled_tire_rigid_tire_model_class", "label": "Rigid Tire Model Class", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_tire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Simplest class: the tire is fully rigid and interacts through the same friction/contact algorithms as any rigid body. Useful for debugging, for runtime-critical runs, and whenever the terrain is much softer than the tire."}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_tire_handling_tire_model_class", "label": "Handling (Semi-Empirical) Tire Model Class", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_tire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Designed for flat road surfaces with single- or four-point contact; not suitable for off-road simulation on deformable terrain, where only rigid or FEA tires apply."}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_tire_fea_tire_model_class", "label": "FEA-Based Tire Model Class", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_tire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most accurate but most expensive class; uniquely able to represent flexibility of tire and ground simultaneously, which matters for off-road mobility studies."}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_tire_chrigidtire", "label": "ChRigidTire", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_tire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_tire_chpac89tire", "label": "ChPac89Tire (Pacejka 89)", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_tire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_tire_chpac02tire", "label": "ChPac02Tire (Pacejka 2002)", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_tire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Extends the earlier Magic Formula with contact-patch slip state equations so that transient (non steady-state slip) maneuvers are accurate; inflation-pressure and large-camber terms were left out for lack of reference data."}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_tire_chtmeasytire", "label": "ChTMeasyTire (Tire Model Made Easy)", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_tire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen for ease of parameterization: a full parameter set can be estimated from few inputs using known truck/car sets. The Chrono port omits belt dynamics and dynamic parking torque of the commercial version."}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_tire_chfialatire", "label": "ChFialaTire", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_tire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Brush-model based with few coefficients and slip state equations for good behavior at low/zero forward speed, but it assumes zero camber and generates no overturning moment, so it should not be used for serious handling work."}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_tire_chancftire", "label": "ChANCFTire (ANCF shell deformable tire)", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_tire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_tire_chreissnertire", "label": "ChReissnerTire (Reissner shell deformable tire)", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_tire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_tire_envelope_contact_algorithm", "label": "Envelope Contact Algorithm (Sui & Hershey)", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_tire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Added so handling tire models can be used for ride tests on undulated roads and obstacle crossing, which single-point contact cannot represent, while keeping numerical effort low."}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_tire_magic_formula", "label": "Pacejka Magic Formula", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_tire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_tire_steady_state_cornering_test", "label": "Steady State Cornering (SSC) Validation Test", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_tire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vehicle circles starting at the Ackermann speed with speed raised in steps until maximum lateral acceleration or engine power is exhausted; run in both left and right turns to expose vehicle asymmetry."}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_tire_krc_fed_alpha_data", "label": "KRC FED-alpha Experimental Data", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_tire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_tire_tmsimple_tire", "label": "TMsimple Tire Model", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_tire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_tire_understeer_oversteer", "label": "Understeer vs Oversteer Safety Criterion", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_tire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A road vehicle for average drivers should understeer: oversteering vehicles turn toward the circle origin and go unstable because the rear wheels run out of lateral slip reserve."}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_tire_rill_castro_road_vehicle_dynamics", "label": "Road Vehicle Dynamics - Fundamentals and Modeling with MATLAB (Rill & Castro, CRC Press 2020)", "file_type": "paper", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_tire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_tire_adams_car_tir_file", "label": "Adams/Car-Compatible TIR File", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_tire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "doxygen_documentation_manuals_vehicle_wheeled_tire_chrigidtire", "target": "doxygen_documentation_manuals_vehicle_wheeled_tire_rigid_tire_model_class", "relation": "implements", "confidence":