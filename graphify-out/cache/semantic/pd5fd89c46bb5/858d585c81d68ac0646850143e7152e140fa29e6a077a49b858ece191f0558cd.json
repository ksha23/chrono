{"nodes": [{"id": "src_chrono_parsers_cmakelists_chrono_parsers", "label": "Chrono_parsers library target", "file_type": "code", "rationale": "Acts as the fan-in point of the build graph: it optionally links PardisoMKL, MUMPS, FSI, FSI-SPH, FSI-TDPF, vehicle and VSG so that a single YAML/URDF/Adams/OpenSim entry point can instantiate models from any enabled module. Feature availability is published to consumers through the generated ChConfigParsers.h (CHRONO_HAS_URDF / PYTHON / ROS).", "source_file": "src/chrono_parsers/CMakeLists.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_chrono_parsers_cmakelists_ch_use_urdf", "label": "Optional URDF parser support (CH_USE_URDF)", "file_type": "concept", "rationale": "Enabled only when urdfdom plus all of urdfdom_headers, console_bridge and tinyxml2 are found; the flag is exported to PARENT_SCOPE because other modules (robot models, ROS) gate their own sources on it.", "source_file": "src/chrono_parsers/CMakeLists.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_chrono_parsers_cmakelists_yaml_parser_set", "label": "Conditional YAML parser file set", "file_type": "concept", "rationale": "ChParserYAML/ChParserMbsYAML are the base; FSI, SPH, TDPF and vehicle YAML parsers are appended only when the corresponding modules are enabled, so one parser library grows to cover whatever the build contains instead of forcing a hard module dependency.", "source_file": "src/chrono_parsers/CMakeLists.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "src_chrono_parsers_cmakelists_chrono_parsers", "target": "src_chrono_pardisomkl_cmakelists_chrono_pardisomkl", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/chrono_parsers/CMakeLists.txt", "source_location": null, "weigh