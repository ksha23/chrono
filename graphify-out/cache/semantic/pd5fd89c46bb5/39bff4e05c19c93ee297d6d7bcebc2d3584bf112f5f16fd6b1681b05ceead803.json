{"nodes": [{"id": "src_chrono_sensor_cmakelists_chrono_sensor", "label": "Chrono_sensor Library Target", "file_type": "code", "source_file": "src/chrono_sensor/CMakeLists.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_chrono_sensor_cmakelists_chrono_sensor_ptx", "label": "Chrono_sensor_ptx OBJECT Target", "file_type": "code", "source_file": "src/chrono_sensor/CMakeLists.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separate object library for the OptiX ray-tracing device sources so they are compiled to PTX apart from the host library."}, {"id": "src_chrono_sensor_cmakelists_per_feature_gpu_requirement", "label": "Per-Feature GPU Requirement Declaration", "file_type": "rationale", "source_file": "src/chrono_sensor/CMakeLists.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GPU requirements are declared per feature, not per module: Chrono::Sensor itself needs no GPU backend because its default renderer is vendor-neutral Vulkan RT, and only the optional OptiX renderer is CUDA-and-NVIDIA-only. Attaching 'requires CUDA' to the module would wrongly disable the whole module on AMD hardware that can run most of it."}, {"id": "src_chrono_sensor_cmakelists_vulkan_rt_backend", "label": "Vulkan RT Renderer Backend", "file_type": "concept", "source_file": "src/chrono_sensor/CMakeLists.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default renderer, ON by default and vendor-neutral. The GPU path needs glslangValidator to compile shaders and fails configuration loudly if it is missing, so a CPU-only build must be requested explicitly via CH_USE_SENSOR_VULKAN_RT_GPU=OFF rather than happening silently."}, {"id": "src_chrono_sensor_cmakelists_optix_backend", "label": "Legacy OptiX Renderer Backend", "file_type": "concept", "source_file": "src/chrono_sensor/CMakeLists.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OFF by default and described as legacy; gates the camera and lidar sensor headers (which include optix.h) and therefore also gates the corresponding Chrono::ROS handlers and their installation."}], "edges": [{"source": "src_chrono_sensor_cmakelists_chrono_sensor", "target": "src_chrono_cmakelists_chrono_core", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/chrono_sensor/CMakeLists.txt", "source_location": null, "weight": 1.0}, {"source": "src_chrono_sensor_cmakelists_chrono_sensor", "target": "src_chrono_fsi_sph_cmakelists_chrono_fsisph", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/chrono_sensor/CMakeLists.txt", "source_location": null, "weight": 1.0}, {"source": "src_chrono_sensor_cmakelists_chrono_sensor_ptx", "target": "src_chrono_sensor_cmakelists_optix_backend", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/chrono_sensor/CMakeLists.txt", "source_location": null, "weight": 1.0}, {"source": "src_chrono_sensor_cmakelists_per_feature_gpu_requirement", "target": "src_chrono_sensor_cmakelists_chrono_sensor", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/chrono_sensor/CMakeLists.txt", "source_location": null, "weight": 1.0}, {"source": "src_chrono_sensor_cmakelists_per_feature_gpu_requirement", "target": "src_chrono_sensor_cmakelists_optix_backend", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/chrono_sensor/CMakeLists.txt", "source_location": null, "weight": 1.0}, {"source": "src_chrono_sensor_cmakelists_vulkan_rt_backend", "target": "src_chrono_sensor_cmakelists_chrono_sensor", "relation": "implements",