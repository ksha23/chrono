{"nodes": [{"id": "doxygen_documentation_manuals_parsers_yaml_parser_overview_yaml_parser_overview", "label": "Chrono YAML parser overview", "file_type": "document", "source_file": "doxygen/documentation/manuals/parsers/YAML_parser_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_parsers_yaml_parser_overview_yaml_file_hierarchy", "label": "Three-file YAML specification hierarchy", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/parsers/YAML_parser_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Model, solver and simulation concerns are split into three files (top-level simulation file plus a model file and a solver file) so models and solver settings can be reused independently. FSI deepens the hierarchy because a coupled problem must reference both an MBS simulation file and a fluid simulation file."}, {"id": "doxygen_documentation_manuals_parsers_yaml_parser_overview_model_reference_frame", "label": "Model reference frame (M)", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/parsers/YAML_parser_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All body poses, joint frames and TSDA endpoints are given relative to an implied model frame rather than the global frame; the caller supplies the global-to-model transform at instantiation so the same YAML model can be placed multiple times in one scene at different locations and orientations."}, {"id": "doxygen_documentation_manuals_parsers_yaml_parser_overview_body_reference_frame", "label": "Body reference frame vs centroidal frame", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/parsers/YAML_parser_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bodies are specified in the most general and flexible way: an arbitrary body reference frame B, with the centroidal frame C given as a transform from B, inertia expressed in C, and all collision/visualization geometry expressed in B."}, {"id": "doxygen_documentation_manuals_parsers_yaml_parser_overview_run_chrono", "label": "run_chrono runner application", "file_type": "concept", "source_file": "doxygen/documentation/manuals/parsers/YAML_parser_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single executable that runs any simulation fully described by YAML; --no_output and --no_visualization override the YAML settings so a scripted or headless run needs no file edits. The output directory is created if missing but its parents must already exist."}], "edges": [{"source": "doxygen_documentation_manuals_parsers_yaml_parser_overview_yaml_parser_overview", "target": "doxygen_documentation_manuals_parsers_yaml_parser_overview_yaml_file_hierarchy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/parsers/YAML_parser_overview.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_parsers_yaml_parser_overview_yaml_parser_overview", "target": "doxygen_documentation_manuals_parsers_yaml_parser_overview_model_reference_frame", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/parsers/YAML_parser_overview.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_parsers_yaml_parser_overview_yaml_parser_overview", "target": "doxygen_documentation_manuals_parsers_yaml_parser_overview_body_reference_frame", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/parsers/YAML_parser_overview.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_parsers_yaml_parser_overview_yaml_parser_overview", "target": "doxygen_documentation_manuals_parsers_yaml_parser_overview_run_chrono", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/parsers/YAML_parser_overview.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_parsers_yaml_parser_overview_model_reference_frame", "target": "doxygen_documentation_manuals_parsers_yaml_parser_overview_body_reference_frame", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/parsers/YAML_parser_overview.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_parsers_yaml_parser_overview_run_chrono", "target": "doxygen_documentation_manuals_parsers_yaml_parser_overview_yaml_file_hierarchy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/parsers/YAML_parser_overview.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_parsers_yaml_parser_overview_run_chrono", "target": "doxygen_documentation_manuals_parsers_yaml_schema_mbs_simulation_mbs_simulation_schema", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/parsers/YAML_parser_overview.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_parsers_yaml_parser_overview_run_chrono", "target": "doxygen_documentation_manuals_parsers_yaml_schema_vehicle_simulation_vehicle_simulation_schema", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/parsers/YAML_parser_overview.md", "source_location": null, "weight": 1.0}, {"source": "doxyg