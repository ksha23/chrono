{"nodes": [{"id": "doxygen_documentation_manuals_chrono_visualization_system_visualization_system", "label": "Visualization System (Chrono manual page)", "file_type": "document", "source_file": "doxygen/documentation/manuals/chrono/visualization_system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chrono is deliberately not bound to any renderer: a common abstract base plus renderer-agnostic assets makes adding a new rendering backend cheap."}, {"id": "doxygen_documentation_manuals_chrono_visualization_system_chvisualsystem", "label": "ChVisualSystem", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/visualization_system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defined in the core module and holds a pointer to a ChSystem so it is notified of simulation updates; may render several Chrono systems at once."}, {"id": "doxygen_documentation_manuals_chrono_visualization_system_chvisualmodel", "label": "ChVisualModel", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/visualization_system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Holds all visual assets of one object. Attached to a ChPhysicsItem the assets follow the object; attached directly to a ChVisualSystem they are fixed to ground."}, {"id": "doxygen_documentation_manuals_chrono_visualization_system_chvisualshape", "label": "ChVisualShape", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/visualization_system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_chrono_visualization_system_chvisualshapefea", "label": "ChVisualShapeFEA", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/visualization_system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_chrono_visualization_system_chvisualmaterial", "label": "ChVisualMaterial", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/visualization_system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Added implicitly the first time a non-default appearance property is set; multiple materials are typical for OBJ meshes."}, {"id": "doxygen_documentation_manuals_chrono_visualization_system_chphysicsitem", "label": "ChPhysicsItem", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/visualization_system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_chrono_visualization_system_chvisualshapemodelfile", "label": "ChVisualShapeModelFile", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/visualization_system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_chrono_visualization_system_visual_ref_frame", "label": "Visual assets attach to the REF frame", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/chrono/visualization_system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For ChBodyAuxRef the visual model frame is REF, not COG, which is the usual source of misplaced geometry."}], "edges": [{"source": "doxygen_documentation_manuals_chrono_visualization_system_visualization_system", "target": "doxygen_documentation_manuals_chrono_visualization_system_chvisualsystem", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/docum