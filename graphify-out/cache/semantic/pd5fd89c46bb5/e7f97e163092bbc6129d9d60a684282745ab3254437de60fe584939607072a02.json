{"nodes": [{"id": "doxygen_documentation_tutorials_solidworks_demo_engine_demo_engine", "label": "Demo Engine Tutorial", "file_type": "document", "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_tutorials_solidworks_demo_engine_assembly_to_python_export", "label": "Assembly to Chrono .py Export", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'Save as Python' emits a module of statements that construct one ChBody per moving SolidWorks part and one ChLink per mating constraint, so the exported file is inspectable and editable text rather than an opaque binary."}, {"id": "doxygen_documentation_tutorials_solidworks_demo_engine_mate_to_chlink_mapping", "label": "SolidWorks Mate to ChLink Mapping", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Concentric + Coincident mates authored in the CAD Mate tool become the joint set of the Chrono system; only mating constraints are exported, never actuation."}, {"id": "doxygen_documentation_tutorials_solidworks_demo_engine_flexible_subassembly", "label": "Flexible Subassembly Solve Mode", "file_type": "rationale", "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A subassembly defaults to 'Solve as Rigid', which would freeze the piston/conrod articulation on export; it must be switched to 'Solve as Flexible' so the internal joint survives into Chrono. Similarly the first inserted part defaults to Fixed and must be set Floating when a revolute joint will constrain it instead."}, {"id": "doxygen_documentation_tutorials_solidworks_demo_engine_test_py_stub", "label": "Generated test.py Stub", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The exporter optionally generates a runnable stub that loads the exported model into a ChSystem and runs a visualization loop; it is intentionally minimal so users copy and extend it. It takes -f/--filename plus optional -d/-T/-v/-p flags, and can be launched by hand (e.g. from an Anaconda shell) when SolidWorks cannot find a global Python interpreter."}, {"id": "doxygen_documentation_tutorials_solidworks_demo_engine_povray_rendering_pipeline", "label": "POVray Postprocessing Rendering Pipeline", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Offline alternative to the Irrlicht realtime view: the postprocessor writes rendering_frames.pov.ini, POVray raytraces a .bmp sequence into anim/, and VirtualDub assembles them into an AVI with an Mpeg4/DivX codec at 25-30 fps."}, {"id": "doxygen_documentation_tutorials_solidworks_demo_engine_shapes_obj_export", "label": "engine_shapes .obj Visualization Meshes", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Visualization geometry is written beside the .py as separate .obj meshes so it can be simplified or replaced in a 3D tool such as Blender without re-exporting the mechanism."}], "edges": [{"source": "doxygen_documentation_tutorials_solidworks_demo_engine_demo_engine", "target": "doxygen_documentation_tutorials_solidworks_demo_engine_advanced_demo_engine_advanced", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_solidworks_demo_engine_demo_engine", "target": "doxygen_documentation_tutorials_solidworks_chronosolidworks_chrono_solidworks_addin", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_solidworks_demo_engine_assembly_to_python_export", "target": "doxygen_documentation_tutorials_solidworks_chronosolidworks_chrono_solidworks_addin", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_solidworks_demo_engine_mate_to_chlink_mapping", "target": "doxygen_documentation_tutorials_solidworks_demo_engine_assembly_to_python_export", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_solidworks_demo_engine_flexible_subassembly", "target": "doxygen_documentation_tutorials_solidworks_demo_engine_mate_to_chlink_mapping", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_solidworks_demo_engine_test_py_stub", "target": "doxygen_documentation_tutorials_solidworks_demo_engine_assembly_to_python_export", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_solidworks_demo_engine_test_py_stub", "target": "doxygen_documentation_tutorials_pychrono_pychrono_tutorials_pychrono_module", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_solidworks_demo_engine_povray_rendering_pipeline", "target": "doxygen_documentation_tutorials_solidworks_demo_engine_shapes_obj_export", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_solidworks_demo_engine_shapes_obj_export", "target": "doxygen_documentation_tutorials_solidworks_demo_engine_assembly_to_python_export", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_solidworks_demo_engine_shapes_obj_export", "target": "doxygen_documentation_tutorials_pychrono_pychrono_tutorials_mesh_collision_tradeoff", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine.md", "source_location": null, "weight": 1.0}], "hyperedges": []}