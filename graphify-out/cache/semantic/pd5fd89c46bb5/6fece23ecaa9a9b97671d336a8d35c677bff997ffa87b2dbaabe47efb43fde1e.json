{"nodes": [{"id": "src_chrono_vehicle_cmakelists_chrono_vehicle", "label": "Chrono_vehicle Library Target", "file_type": "code", "source_file": "src/chrono_vehicle/CMakeLists.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single monolithic library aggregating base, chassis, driver, powertrain, terrain, wheeled-vehicle and tracked-vehicle sources; optional subsystems (FEA tires/track shoes, OpenCRG terrain, CRM terrain) are added to the source lists conditionally rather than split into separate targets, keeping one linkable Chrono_vehicle regardless of enabled modules."}, {"id": "src_chrono_vehicle_cmakelists_chrono_vehicle_irrlicht", "label": "Chrono_vehicle_irrlicht Visualization Library", "file_type": "code", "source_file": "src/chrono_vehicle/CMakeLists.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_chrono_vehicle_cmakelists_chrono_vehicle_vsg", "label": "Chrono_vehicle_vsg Visualization Library", "file_type": "code", "source_file": "src/chrono_vehicle/CMakeLists.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_chrono_vehicle_cmakelists_ch_enable_opencrg", "label": "CH_ENABLE_OPENCRG Terrain Option", "file_type": "rationale", "source_file": "src/chrono_vehicle/CMakeLists.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OpenCRG road-description support is opt-in and degrades gracefully: if the package is not found, CRG support is disabled with a warning rather than failing configuration, and CRGTerrain sources are simply dropped from the library. FindOpenCRG.cmake is copied and installed so downstream consumers can re-resolve the dependency."}, {"id": "src_chrono_vehicle_cmakelists_chconfigvehicle_header", "label": "ChConfigVehicle.h Generated Config Header", "file_type": "code", "source_file": "src/chrono_vehicle/CMakeLists.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Build-time capability flags (CHRONO_OPENCRG, CHRONO_CRM) are baked into a generated header so C++ sources use #ifdef rather than duplicating CMake option logic; the header is installed alongside the module."}, {"id": "src_chrono_vehicle_cmakelists_stb_vendoring", "label": "STB Vendoring into Chrono_vehicle", "file_type": "concept", "source_file": "src/chrono_vehicle/CMakeLists.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "stb_image / stb_image_write translation units from src/chrono_thirdparty/stb are compiled directly into Chrono_vehicle (for terrain heightmap I/O) and their headers are installed under include/chrono_thirdparty."}], "edges": [{"source": "src_chrono_vehicle_cmakelists_ch_enable_opencrg", "target": "src_chrono_vehicle_cmakelists_chrono_vehicle", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/chrono_vehicle/CMakeLists.txt", "source_location": null, "weight": 1.0}, {"source": "src_chrono_vehicle_cmakelists_chrono_vehicle", "target": "src_chrono_vehicle_cmakelists_chconfigvehicle_header", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/chrono_vehicle/CMakeLists.txt", "source_location": null, "weight": 1.0}, {"source": "src_chrono_vehicle_cmakelists_ch_enable_opencrg", "target": "src_chrono_vehicle_cmakelists_chconfigvehicle_header", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/chrono_vehicle/CMakeLists.txt", "source_location": null, "weight": 1.0}, {"source": "src_chrono_vehicle_cmakelists_chrono_vehicle_irrlicht", "target": "src_chrono_vehicle_cmakelists_chrono_vehicle", "relation": "references", "confidence": "EXTRACTED", "confidence_score":