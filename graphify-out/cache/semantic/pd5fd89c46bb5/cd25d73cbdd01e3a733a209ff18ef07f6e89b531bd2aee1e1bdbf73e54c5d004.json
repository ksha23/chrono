{"nodes": [{"id": "doxygen_documentation_manuals_vehicle_vehicle_overview_vehicle_overview", "label": "Overview of vehicle modeling and simulation", "file_type": "document", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_overview_template_based_design", "label": "Template-based subsystem design", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A template fixes bodies, joints, force elements, topology and design parameters for a subsystem type; a concrete vehicle is an instantiation with hardpoints and inertias. This buys modularity without re-deriving each vehicle."}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_overview_json_specification", "label": "JSON vehicle specification hierarchy", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "As a middleware library Chrono::Vehicle normally needs user-written C++ classes per concrete template, which demands programming experience; nested JSON files provide the same instantiation without code."}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_overview_iso_frame", "label": "ISO vehicle reference frame", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chrono::Vehicle models exclusively in a right-handed ISO 8855:2011 frame (X forward, Z up, Y left); each subsystem's hardpoints are given in its own frame and placed relative to the chassis-aligned vehicle frame."}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_overview_chworldframe", "label": "ChWorldFrame", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets a vehicle be simulated in a scene authored in a non-ISO frame (e.g. Y-up) by storing the rotation from ISO to world; it must be set before any other Chrono::Vehicle call."}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_overview_synchronize_advance", "label": "Synchronize / Advance simulation loop", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A force-displacement co-simulation scheme where every system exposes Synchronize (data exchange) and Advance (own dynamics). Adopted for modularity, third-party auxiliary models, and co-simulation with external tools - though an all-Chrono setup still solves monolithically."}], "edges": [{"source": "doxygen_documentation_manuals_vehicle_vehicle_overview_vehicle_overview", "target": "doxygen_documentation_manuals_vehicle_vehicle_overview_template_based_design", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/vehicle/vehicle_overview.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_vehicle_vehicle_overview_vehicle_overview", "target": "doxygen_documentation_manuals_vehicle_vehicle_overview_json_specification", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/vehicle/vehicle_overview.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_vehicle_vehicle_overview_vehicle_over