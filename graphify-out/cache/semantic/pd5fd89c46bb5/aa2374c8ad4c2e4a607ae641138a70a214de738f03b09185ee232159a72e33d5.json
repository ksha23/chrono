{"nodes": [{"id": "doxygen_documentation_manuals_pychrono_pychrono_introduction_pychrono", "label": "PyChrono", "file_type": "document", "source_file": "doxygen/documentation/manuals/pychrono/pychrono_introduction.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A Python module giving access to a large part of the Chrono API without any C++ programming. Traded off deliberately: Python is simple, interpretable on the fly, has a rich third-party ecosystem (Matplotlib, NumPy) and needs a minimal install, but is slower than C++ and the Python module does not cover all C++ API features."}, {"id": "doxygen_documentation_manuals_pychrono_pychrono_introduction_numpy_interop", "label": "PyChrono linear algebra / NumPy interoperability", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/pychrono/pychrono_introduction.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ChMatrixDynamicd and ChVectorDynamicd are interfaced with plain Python lists (SetMatr/GetMatr), which lets any third-party package such as NumPy do the linear algebra without a dedicated binding layer."}, {"id": "doxygen_documentation_manuals_pychrono_pychrono_introduction_operator_overloading", "label": "Operator overloading in PyChrono vectors and quaternions", "file_type": "concept", "source_file": "doxygen/documentation/manuals/pychrono/pychrono_introduction.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most C++ operator overloads carry over (~ conjugate, ^ dot product, % quaternion product), so C++ example code translates almost literally."}, {"id": "doxygen_documentation_manuals_pychrono_pychrono_introduction_gym_chrono", "label": "gym-chrono", "file_type": "document", "source_file": "doxygen/documentation/manuals/pychrono/pychrono_introduction.md", "source_location": null, "source_url": "https://github.com/projectchrono/gym-chrono", "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_pychrono_pychrono_introduction_no_python_api_docs", "label": "No generated Python API documentation", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/pychrono/pychrono_introduction.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "There is no Sphinx automated generation of Python API docs; because most classes behave like their C++ counterparts, users are directed to the C++ API documentation and to IDE code completion instead."}], "edges": [{"source": "doxygen_documentation_manuals_pychrono_pychrono_introduction_pychrono", "target": "doxygen_documentation_manuals_pychrono_pychrono_installation_conda_package", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/pychrono/pychrono_introduction.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_pychrono_pychrono_introduction_pychrono", "target": "doxygen_documentation_manuals_pychrono_pychrono_reference_pychrono_reference", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/pychrono/pychrono_introduction.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_pychrono_pychrono_introduction_pychrono", "target": "doxygen_documentation_manuals_pychrono_pychrono_introduction_numpy_interop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/pychrono/pychrono_introduction.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_pychrono_pychrono_introduction_pychrono", "target": "doxygen_documentation_manuals_pychrono_pychrono_introduction_operator_overloadi