{"nodes": [{"id": "doxygen_documentation_tutorials_tutorials_tutorial_root", "label": "Chrono Tutorials Index", "file_type": "document", "source_file": "doxygen/documentation/tutorials/tutorials.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_tutorials_tutorials_chrono_types_make_shared", "label": "chrono_types::make_shared", "file_type": "rationale", "source_file": "doxygen/documentation/tutorials/tutorials.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Many Chrono classes hold fixed-size vectorizable Eigen members and overload operator new to return 16-byte-aligned pointers. std::make_shared uses placement new and bypasses that overload, so Chrono ships replacement functions in the chrono_types namespace that fall back to std::make_shared when safe and otherwise allocate aligned memory. User code should always use chrono_types::make_shared; STL containers of such classes need Eigen::aligned_allocator."}], "edges": [{"source": "doxygen_documentation_tutorials_tutorials_tutorial_root", "target": "doxygen_documentation_tutorials_ros_chronoros_chrono_ros_module", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/tutorials.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_tutorials_tutorial_root", "target": "doxygen_documentation_tutorials_slides_chrono_3_0_0_training_material", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/tutorials.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_tutorials_tutorial_root", "target": "doxygen_documentation_tutorials_solidworks_demo_engine_chrono_solidworks_addin", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0,