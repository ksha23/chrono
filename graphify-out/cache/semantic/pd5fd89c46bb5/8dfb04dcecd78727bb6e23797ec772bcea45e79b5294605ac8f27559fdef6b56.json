{"nodes": [{"id": "doxygen_documentation_tutorials_pychrono_demo_tensorflow_deep_reinforcement_learning_with_pychrono", "label": "Deep Reinforcement Learning with PyChrono and Tensorflow", "file_type": "document", "source_file": "doxygen/documentation/tutorials/pychrono/demo_tensorflow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_tutorials_pychrono_demo_tensorflow_deep_reinforcement_learning", "label": "Deep Reinforcement Learning (DRL)", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/pychrono/demo_tensorflow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen for robotic control because it copes with unstructured and mutable environments where classical control fails; a physics engine supplies the many required environment interactions virtually, cutting the time and risk of training on real hardware."}, {"id": "doxygen_documentation_tutorials_pychrono_demo_tensorflow_pychrono", "label": "PyChrono", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/pychrono/demo_tensorflow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Python bindings that let physical models be built and data exchanged with an arbitrary ML framework, making Chrono usable as an RL environment backend."}, {"id": "doxygen_documentation_tutorials_pychrono_demo_tensorflow_gym_chrono", "label": "gym-chrono", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/pychrono/demo_tensorflow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PyChrono-based OpenAI Gym environments, recommended for complex/realistic scenarios and for reusing Gym tooling such as OpenAI Baselines; positioned explicitly as an open-source alternative to MuJoCo environments."}, {"id": "doxygen_documentation_tutorials_pychrono_demo_tensorflow_proximal_policy_optimization", "label": "Proximal Policy Optimization (PPO)", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/pychrono/demo_tensorflow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On-policy actor-critic algorithm supplied standalone with the demos; it needs two networks (Policy prescribing an action from the state, Value Function evaluating the state), which is why Policy.py and VF.py are separate modules with separate checkpoint directories."}, {"id": "doxygen_documentation_tutorials_pychrono_demo_tensorflow_ppo_paper", "label": "Proximal Policy Optimization Algorithms (arXiv:1707.06347)", "file_type": "paper", "source_file": "doxygen/documentation/tutorials/pychrono/demo_tensorflow.md", "source_location": null, "source_url": "https://arxiv.org/abs/1707.06347", "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_tutorials_pychrono_demo_tensorflow_chronopendulum", "label": "ChronoPendulum Environment", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/pychrono/demo_tensorflow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inverted-pendulum balancing task with 1 action (force along z) and 4 observations (cart and pole position and speed); the minimal control benchmark used to validate the training loop."}, {"id": "doxygen_documentation_tutorials_pychrono_demo_tensorflow_chronoant", "label": "ChronoAnt Environment", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/pychrono/demo_tensorflow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "4-legged walker learning to walk straight as fast as possible, with 8 motor-torque actions and 30 observations; the higher-dimensional task that motivates parallel data collection."}, {"id": "doxygen_documentation_tutorials_pychrono_demo_tensorflow_policy_network", "label": "Policy Network (Policy.py)", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/pychrono/demo_tensorflow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_tutorials_pychrono_demo_tensorflow_value_function_network", "label": "Value Function Network (VF.py)", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/pychrono/demo_tensorflow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_tutorials_pychrono_demo_tensorflow_train_serial", "label": "train_serial.py", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/pychrono/demo_tensorflow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_tutorials_pychrono_demo_tensorflow_train_parallel", "label": "train_parallel.py", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/pychrono/demo_tensorflow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Collects rollout data over multiple simulations with the Python multiprocessing module; this pays off in advanced training stages when episodes last longer, since environment stepping then dominates wall-clock time."}, {"id": "doxygen_documentation_tutorials_pychrono_demo_tensorflow_tester", "label": "tester.py", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/pychrono/demo_tensorflow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Evaluates a trained Policy without further improving it, with an optional --VideoSave flag to capture render screenshots."}, {"id": "doxygen_documentation_tutorials_pychrono_demo_tensorflow_checkpoint_and_scaler", "label": "Checkpointing and Observation Scaler", "file_type": "rationale", "source_file": "doxygen/documentation/tutorials/pychrono/demo_tensorflow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TF variables live in the Policy and VF directories while the scaler means and variances go to scaler.dat as a numpy array. Because serial and parallel training share the same network architecture, checkpoints are interchangeable between them."}, {"id": "doxygen_documentation_tutorials_pychrono_demo_tensorflow_render_toggle_tradeoff", "label": "Run-Time Render Toggle (--renderON/--renderOFF)", "file_type": "rationale", "source_file": "doxygen/documentation/tutorials/pychrono/demo_tensorflow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Visualization is made an explicit command-line toggle because rendering slows the simulation and therefore the learning process; training runs headless while inspection runs with the render on."}, {"id": "doxygen_documentation_tutorials_pychrono_demo_tensorflow_tensorflow_1_dependency", "label": "Tensorflow 1 / Anaconda Environment Requirement", "file_type": "rationale", "source_file": "doxygen/documentation/tutorials/pychrono/demo_tensorflow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The demos pin Tensorflow 1 (conda tensorflow-gpu=1.14) alongside Numpy and Scikit-Learn. Anaconda is recommended, and if PyChrono was built from sources the environment's Python version must match the interpreter given to CMake, otherwise the bindings will not import."}], "edges": [{"source": "doxygen_documentation_tutorials_pychrono_demo_tensorflow_deep_reinforcement_learning_with_pychrono", "target": "doxygen_documentation_tutorials_pychrono_demo_tensorflow_deep_reinforcement_learning", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/pychrono/demo_tensorflow.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_pychrono_demo_tensorflow_deep_reinforcement_learning_with_pychrono", "target": "doxygen_documentation_tutorials_pychrono_demo_tensorflow_pychrono", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/pychrono/demo_tensorflow.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_pychrono_demo_tensorflow_deep_reinforcement_learning_with_pychrono", "target": "doxygen_documentation_tutorials_pychrono_demo_tensorflow_gym_chrono", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/pychrono/demo_tensorflow.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_pychrono_demo_tensorflow_gym_chrono", "target": "doxygen_documentation_tutorials_pychrono_demo_tensorflow_pychrono", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/pychrono/demo_tensorflow.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_pychrono_demo_tensorflow_deep_reinforcement_learning_with_pychrono", "target": "doxygen_documentation_tutorials_pychrono_demo_tensorflow_proximal_policy_optimization", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/pychrono/demo_tensorflow.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_pychrono_demo_tensorflow_proximal_policy_optimization", "target": "doxygen_documentation_tutorials_pychrono_demo_tensorflow_ppo