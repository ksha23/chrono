{"nodes": [{"id": "doxygen_documentation_tutorials_cosimulation_demo_cosim_hydraulics_tutorial_cosim_hydraulics", "label": "Tutorial: Cosimulation with Simulink (demo_COSIM_hydraulics.cpp)", "file_type": "document", "source_file": "doxygen/documentation/tutorials/cosimulation/demo_cosim_hydraulics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_tutorials_cosimulation_demo_cosim_hydraulics_two_way_cosimulation", "label": "Two-Way Co-Simulation Pattern", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/cosimulation/demo_cosim_hydraulics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The system state is partitioned between the two solvers, which advance independently and synchronize periodically; tightly coupled subsystems force frequent synchronization."}, {"id": "doxygen_documentation_tutorials_cosimulation_demo_cosim_hydraulics_tcp_socket_exchange", "label": "TCP/IP Socket Variable Exchange", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/cosimulation/demo_cosim_hydraulics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chrono acts as server and Simulink as client; the Chrono state is interpolated linearly over the Simulink sub-steps while the Simulink state is held as a Zero Order Hold on the Chrono side."}, {"id": "doxygen_documentation_tutorials_cosimulation_demo_cosim_hydraulics_zero_order_hold", "label": "Zero Order Hold Interpolation", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/cosimulation/demo_cosim_hydraulics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_tutorials_cosimulation_demo_cosim_hydraulics_cosimulate_block", "label": "Simulink CoSimulate Block", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/cosimulation/demo_cosim_hydraulics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only one CoSimulate block may exist per model; larger interfaces are handled by widening the input and output vectors with Mux/De-Mux rather than adding blocks."}, {"id": "doxygen_documentation_tutorials_cosimulation_demo_cosim_hydraulics_simulink", "label": "Simulink", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/cosimulation/demo_cosim_hydraulics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_tutorials_cosimulation_demo_cosim_hydraulics_simhydraulics_toolbox", "label": "SimHydraulics Toolbox", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/cosimulation/demo_cosim_hydraulics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_tutorials_cosimulation_demo_cosim_hydraulics_communication_step_size", "label": "Communication Step Size Selection", "file_type": "rationale", "source_file": "doxygen/documentation/tutorials/cosimulation/demo_cosim_hydraulics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hydraulic systems are stiff, so the exchange interval must be very small; larger steps make the latency of the extrapolated coupling variables produce numerical instability, while small steps slow the co-simulation down."}, {"id": "doxygen_documentation_tutorials_cosimulation_demo_cosim_hydraulics_subsystem_split_rule", "label": "Where to Split a System for Co-Simulation", "file_type": "rationale", "source_file": "doxygen/documentation/tutorials/cosimulation/demo_cosim_hydraulics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Split at an interface where the connecting variables carry low frequencies: the higher the frequency crossing the interface, the smaller the communication step must be."}, {"id": "doxygen_documentation_tutorials_cosimulation_demo_cosim_hydraulics_dead_linear_actuator_chlinktsda", "label": "Dead Linear Actuator (ChLinkTSDA with zero stiffness/damping)", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/cosimulation/demo_cosim_hydraulics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A zero-stiffness, zero-damping TSDA is used purely as the carrier for the externally supplied hydraulic force between two bodies."}], "edges": [{"source": "doxygen_documentation_tutorials_cosimulation_demo_cosim_hydraulics_tutorial_cosim_hydraulics", "target": "doxygen_documentation_tutorials_cosimulation_demo_cosim_hydraulics_two_way_cosimulation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/cosimulation/demo_cosim_hydraulics.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_cosimulation_demo_cosim_hydraulics_two_way_cosimulation", "target": "doxygen_documentation_tutorials_cosimulation_demo_cosim_hydraulics_tcp_socket_exchange", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/cosimulation/demo_cosim_hydraulics.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_cosimulation_demo_cosim_hydraulics_tcp_socket_exchange", "target": "doxygen_documentation_tutorials_cosimulation_demo_cosim_hydraulics_zero_order_hold", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/cosimulation/demo_cosim_hydraulics.md", "source_location": null, "weight": 