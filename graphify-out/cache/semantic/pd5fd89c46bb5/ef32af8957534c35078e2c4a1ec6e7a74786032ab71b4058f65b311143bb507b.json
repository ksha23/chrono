{"nodes": [{"id": "doxygen_documentation_manuals_parsers_yaml_schema_mbs_solver_mbs_solver_schema", "label": "MBS solver YAML schema", "file_type": "document", "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_mbs_solver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only contact_method is required; omitting integrator yields EULER_IMPLICIT_LINEARIZED with a 1e-3 step and omitting solver yields BARZILAI_BORWEIN with defaults. Carries no output or visualization settings - those belong to the MBS simulation file."}, {"id": "doxygen_documentation_manuals_parsers_yaml_schema_mbs_solver_contact_method", "label": "contact_method SMC vs NSC", "file_type": "concept", "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_mbs_solver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_parsers_yaml_schema_mbs_solver_integrator", "label": "Time integrator types", "file_type": "concept", "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_mbs_solver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "EULER_IMPLICIT_LINEARIZED / EULER_IMPLICIT_PROJECTED / EULER_IMPLICIT / HHT; both type and time_step are required whenever the integrator object is present. Tolerances are split into state and Lagrange-multiplier absolute tolerances because multipliers live on a different scale (default 1e2 vs 1e-4)."}, {"id": "doxygen_documentation_manuals_parsers_yaml_schema_mbs_solver_solver_types", "label": "DVI and linear solver types", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_mbs_solver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three families with distinct parameter sets: iterative DVI (BARZILAI_BORWEIN, APGD, PSOR) with overrelaxation and sharpness factors, iterative Krylov linear (BICGSTAB, MINRES, GMRES) with a residual tolerance, and direct sparse (SPARSE_LU, SPARSE_QR, PARDISO, MUMPS) with sparsity-pattern locking and a pattern learner available only for SPARSE_LU/SPARSE_QR. PARDISO and MUMPS require the corresponding optional Chrono module."}], "edges": [{"source": "doxygen_documentation_manuals_parsers_yaml_schema_mbs_solver_mbs_solver_schema", "target": "doxygen_documentation_manuals_parsers_yaml_schema_mbs_solver_contact_method", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_mbs_solver.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_parsers_yaml_schema_mbs_solver_mbs_solver_schema", "target": "doxygen_documentation_manuals_parsers_yaml_schema_mbs_solver_integrator", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_mbs_solver.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_parsers_yaml_schema_mbs_solver_mbs_solver_schema", "target": "doxygen_documentation_manuals_parsers_yaml_schema_mbs_solver_solver_types", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_mbs_solver.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_parsers_yaml_schema_mbs_solver_mbs_solver_schema", "target": "doxygen_documentation_manuals_parsers_yaml_schema_mbs_simulation_mbs_simulation_schema", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_mbs_solver.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_parsers_yaml_schema_mbs_solver_integrator"