{"nodes": [{"id": "doxygen_documentation_manuals_synchrono_synchrono_overview_synchrono", "label": "SynChrono", "file_type": "document", "source_file": "doxygen/documentation/manuals/synchrono/synchrono_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Developed at SBEL, UW-Madison to extend Chrono physics into the weakly-coupled multi-agent realm: agent dynamics matter individually but not through mutual interaction, so they can be distributed across nodes instead of solved in one monolithic system."}, {"id": "doxygen_documentation_manuals_synchrono_synchrono_overview_heartbeat", "label": "Heartbeat synchronization", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/synchrono/synchrono_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nodes step at the same constant timestep but at different real-world speeds; they only rendezvous every heartbeat. Between heartbeats zombie agents stay static, trading spatial fidelity for scalability."}, {"id": "doxygen_documentation_manuals_synchrono_synchrono_overview_zombie_agent", "label": "Zombie agent", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/synchrono_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A node's proxy of a remote agent: fixed bodies whose pose is driven entirely by incoming messages. State sent is the minimum needed to reconstruct it - what it looks like (once) and where it is (every heartbeat)."}, {"id": "doxygen_documentation_manuals_synchrono_synchrono_overview_flatbuffers_serialization", "label": "FlatBuffers state serialization", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/synchrono_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every synchronized agent needs a .fbs schema plus a class that packs and unpacks C++ objects into the wire format."}, {"id": "doxygen_documentation_manuals_synchrono_synchrono_overview_syncommunicator", "label": "SynCommunicator", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/synchrono_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Abstracts the transport: MPI and DDS backends exist and others can be added as long as they interchange binary state among all nodes."}, {"id": "doxygen_documentation_manuals_synchrono_synchrono_overview_vehicle_dependency", "label": "SynChrono dependency on Chrono::Vehicle", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/synchrono/synchrono_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Development focused on autonomous-vehicle simulation, so SynChrono currently requires Chrono::Vehicle; this is not fundamental and adds no extra build dependencies. Visualization goes through Chrono::Irrlicht or Chrono::Sensor."}], "edges": [{"source": "doxygen_documentation_manuals_synchrono_synchrono_overview_synchrono", "target": "doxygen_documentation_manuals_synchrono_synchrono_overview_heartbeat", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/synchrono/synchrono_overview.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_synchrono_synchrono_overview_synchrono", "target": "doxygen_documentation_manuals_synchrono_synchrono_overview_zombie_agent", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/synchrono/synchrono_overview.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_m