{"nodes": [{"id": "doxygen_documentation_manuals_ros_ros_overview_chrono_ros", "label": "Chrono::ROS module", "file_type": "document", "source_file": "doxygen/documentation/manuals/ros/ros_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Developed by SBEL at UW-Madison to provide a simple, extensible interface between Chrono and ROS 2 so Chrono can be dropped directly into ROS autonomy-stack development; built on ROS 2's existing network capabilities and reusing existing ROS concepts (publishers, subscribers, topics) rather than inventing new ones."}, {"id": "doxygen_documentation_manuals_ros_ros_overview_module_handler_coverage", "label": "Handler coverage across Chrono modules", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/ros/ros_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chrono::ROS is not tied to any one Chrono module; general-purpose handlers exist for Chrono::Vehicle and Chrono::Sensor for rapid prototyping, and anything else is reached by writing a custom handler. The PyChrono/Chrono::Python wrapper is supported."}], "edges": [{"source": "doxygen_documentation_manuals_ros_ros_overview_chrono_ros", "target": "doxygen_documentation_manuals_ros_ros_overview_module_handler_coverage", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/ros/ros_overview.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_ros_ros_overview_chrono_ros", "target": "doxygen_documentation_manuals_pychrono_pychrono_introduction_pychrono", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/ros/ros_overview.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_ros_ros_overview_module_h