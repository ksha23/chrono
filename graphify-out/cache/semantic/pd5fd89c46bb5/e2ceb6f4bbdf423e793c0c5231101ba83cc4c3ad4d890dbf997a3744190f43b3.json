{"nodes": [{"id": "doxygen_documentation_manuals_sensor_sensor_overview_sensor_overview", "label": "Overview of Chrono::Sensor", "file_type": "document", "source_file": "doxygen/documentation/manuals/sensor/sensor_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_sensor_sensor_overview_chsensormanager", "label": "ChSensorManager", "file_type": "concept", "source_file": "doxygen/documentation/manuals/sensor/sensor_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owns the scene and the sensor list; Update() is called each simulation loop iteration alongside DoStepDynamics."}, {"id": "doxygen_documentation_manuals_sensor_sensor_overview_filter_graph", "label": "Sensor filter graph", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/sensor/sensor_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each sensor carries an extensible ordered filter list so users can model sensor-specific artifacts and pick data formats without modifying the sensor class."}, {"id": "doxygen_documentation_manuals_sensor_sensor_overview_separate_data_thread", "label": "Separate sensor data thread", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/sensor/sensor_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dynamics runs at order 1 kHz while sensors run at 10-100 Hz, so data curation is moved to its own thread rather than stalling the physics loop."}, {"id": "doxygen_documentation_manuals_sensor_sensor_overview_multi_gpu_rendering", "label": "Multi-GPU render threads", "file_type": "concept", "source_file": "doxygen/documentation/manuals/sensor/sensor_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Multiple render threads each drive a separate GPU for a group of sensors, which matters for multi-agent scenes with many sensors at different update rates."}, {"id": "doxygen_documentation_manuals_sensor_sensor_overview_reproducible_stochastic_sensors", "label": "Reproducible stochastic sensors", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/sensor/sensor_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-pixel RNGs default to wall-clock seeding, which is right for simulation but blocks byte-exact comparison; ChSensorManager::SetRandomSeed pins a base seed instead."}, {"id": "doxygen_documentation_manuals_sensor_sensor_overview_setrandomseed", "label": "ChSensorManager::SetRandomSeed", "file_type": "concept", "source_file": "doxygen/documentation/manuals/sensor/sensor_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Must be called before AddSensor because the seed is read when a sensor's filters initialize inside AddSensor."}, {"id": "doxygen_documentation_manuals_sensor_sensor_overview_registration_order_contract", "label": "AddSensor registration-order contract", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/sensor/sensor_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Random streams derive from AddSensor order, so adding, removing or reordering sensors changes what other sensors draw even under a fixed seed; comparison runs must build the scene identically."}, {"id": "doxygen_documentation_manuals_sensor_sensor_overview_per_buffer_stream", "label": "Per-buffer independent random streams", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/sensor/sensor_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each buffer derives a distinct cuRAND seed from base seed plus sensor, filter and purpose identity so two cameras, or a camera and a lidar, never draw the same sequence - required for honest sensor-fusion studies."}, {"id": "doxygen_documentation_manuals_sensor_sensor_overview_default_visual_material", "label": "ChVisualMaterial::Default fallback shading", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/sensor/sensor_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A shape with no ChVisualMaterial renders with the same default Irrlicht and VSG use; values are copied into the device material pool at first sensor update, so mutating the shared default afterwards has no effect."}, {"id": "doxygen_documentation_manuals_sensor_sensor_overview_sensor_reference_frame", "label": "Sensor ISO reference frame", "file_type": "concept", "source_file": "doxygen/documentation/manuals/sensor/sensor_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sensors default to Z-up, X-forward, Y-left to match the vehicle ISO frame, so sensor poses compose directly with Chrono::Vehicle frames."}, {"id": "doxygen_documentation_manuals_sensor_sensor_overview_sensor_json_loading", "label": "Sensor creation from JSON", "file_type": "concept", "source_file": "doxygen/documentation/manuals/sensor/sensor_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "doxygen_documentation_manuals_sensor_sensor_overview_sensor_overview", "target": "doxygen_documentation_manuals_sensor_sensor_overview_chsensormanager", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/