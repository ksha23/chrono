{"nodes": [{"id": "doxygen_documentation_manuals_vehicle_vehicle_terrain_vehicle_terrain", "label": "Terrain models", "file_type": "document", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_terrain.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_terrain_chterrain", "label": "ChTerrain base class", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_terrain.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Height, normal and friction queries only matter for semi-empirical tire models; deformable terrains bypass them and interact through the Chrono collision/contact system with rigid or FEA tires and tracked vehicles."}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_terrain_frictionfunctor", "label": "ChTerrain::FrictionFunctor", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_terrain.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User-derived functor returning a position-dependent friction coefficient; it only reaches tire models that explicitly consume friction, not general contact."}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_terrain_flatterrain", "label": "FlatTerrain", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_terrain.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An infinite horizontal plane with no collision or contact information, so it works only with semi-empirical tire models."}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_terrain_rigidterrain", "label": "RigidTerrain", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_terrain.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A collection of box, OBJ-mesh or BMP-heightmap patches. GetHeight/GetNormal use relatively expensive vertical ray casting; large box patches should be tiled because one huge collision shape degrades collision detection, and mesh patches benefit from a small sweeping-sphere thickness."}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_terrain_rigidterrain_friction_cost", "label": "Per-contact terrain friction override cost", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_terrain.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Applying location-dependent friction to real contacts means traversing every contact in the Chrono system once per step to find terrain-patch contacts and rewrite composite material properties - expensive by construction."}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_terrain_crgterrain", "label": "CRGTerrain", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_terrain.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Procedural road built from an OpenCRG specification (requires the OpenCRG SDK at CMake time); carries no collision information so it is limited to semi-empirical tires, but can export the road mesh and Bezier center line."}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_terrain_scmterrain", "label": "SCMTerrain (Soil Contact Model)", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_terrain.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An implicit Cartesian grid deformed by vertical node deflection. The grid is never built explicitly - only deformed nodes live in a hash map - and ray casting, the costliest step, is multithreaded and can be confined to a moving patch. Lightweight enough for near real-time vehicle-terrain forces."}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_terrain_bekker_wong", "label": "Bekker-Wong pressure-sinkage formulation", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_terrain.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SCM generalizes Bekker's sigma = (k_c/b + k_phi) y^n to arbitrary 3D contact shapes. Since b (the short side of a rectangular footprint) is undefined for a generic patch, connected patches are found by flooding and b is approximated as 2A/L. Few parameters means easy calibration against experiment."}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_terrain_soilparameterscallback", "label": "SCMTerrain::SoilParametersCallback", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_terrain.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Custom callback returning all soil parameters at an (x,y) point in the terrain reference plane, enabling spatially varying soil."}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_terrain_granularterrain", "label": "GranularTerrain", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_terrain.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DEM patch of monodisperse spheres. Because large-scale granular dynamics is very expensive it supports a moving bin that follows a body (x direction only); fixed boundary particles inhibit bed sliding but conflict with the moving patch."}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_terrain_featerrain", "label": "FEATerrain", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_terrain.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deformable terrain from ChElementHexaANCF_3813_9 brick elements with plasticity parameters (yield stress, hardening slope, dilatancy and friction angles)."}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_terrain_crmterrain", "label": "CRMTerrain (SPH continuous representation)", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_terrain.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Solves soil-dynamics PDEs with the Chrono::FSI-SPH module; presented as an attractive alternative to granular DEM because it reaches similar accuracy and fidelity at much better computational performance."}], "edges": [{"source": "doxygen_documentation_manuals_vehicle_vehicle_terrain_vehicle_terrain", "target": "doxygen_documentation_manuals_vehicle_vehicle_terrain_chterrain", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/vehicle/vehicle_terrain.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_vehicle_vehicle_terrain_chterrain", "target": "doxygen_documentation_manuals_vehicle_vehicle_terrain_frictionfunctor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/vehicle/vehicle_terrain.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_vehicle_vehicle_terrain_flatterrain", "target": "doxygen_documentation_manuals_vehicle_vehicle_terrain_chterrain", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/vehicle/vehicle_terrain.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_vehicle_vehicle_terrain_rigidterrain", "target": "doxygen_documentation_manuals_vehicle_vehicle_terrain_chterrain", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/vehicle/vehicle_terrain.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_vehicle_vehicle_terrain_crgterrain", "target": "doxygen_documentation_manuals_vehicle_vehicle_terrain_chterrain", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/vehicle/vehicle_terrain.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_vehicle_vehicle_terrain_scmterrain", "target": "doxygen_documentation_manuals_vehicle_vehicle_terrain_chterrain", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/vehicle/vehicle_terrain.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_vehicle_vehicle_terrain_granularterrain", "target": "doxygen_documentation_manuals_vehicle_vehicle_terrain_chterrain", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/vehicle/vehicle_terrain.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_vehicle_vehicle_terrain_featerrain", "target": "doxygen_documentation_manuals_vehicle_vehicle_terrain_chterrain", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/vehicle/vehicle_terrain.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_vehicle_vehicle_terrain_crmterrain", "target": "doxygen_documentation_manuals_vehicle_vehicle_terrain_chterrain", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/vehicle/vehicle_terrain.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_vehicle_vehicle_terrain_rigidterrain", "target": "doxygen_documentation_manuals_vehicle_vehicle_terrain_rigidterrain_friction_cost", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/vehicle/vehicle_terrain.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_vehicle_vehicle_terrain_rigidterrain", "target": "doxygen_documentation_manuals_vehicle_vehicle_terrain_frictionfunctor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/vehicle/vehicle_terrain.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_vehicle_vehicle_terrain_flatterrain", "target": "doxygen_documentation_manuals_vehicle_vehicle_terrain_frictionfunctor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/vehicle/vehicle_terrain.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_vehicle_vehicle_terrain_scmterrain", "target": "doxygen_documentation_manuals_vehicle_vehicle_terrain_bekker_wong", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/vehicle/vehicle_terrain.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_vehicle_vehicle_terrain_scmterrain", "target": "doxygen_documentation_manuals_vehicle_vehicle_terrain_soilparameterscallback", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/vehicle/vehicle_terrain.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_vehicle_vehicle_terrain_scmterrain", "target": "doxygen_documentation_manuals_vehicle_vehicle_terrain_scm_gpu_scm_gpu_backends", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/vehicle/vehicle_terrain.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_vehicle_vehicle_terrain_crmterrain", "target": "doxygen_documentation_manuals_vehicle_vehicle_terrain_granularterrain", "relation": "semantically_similar_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/vehicle/vehicle_terrain.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "chrono_vehicle_deformable_terrain_family", "label": "Chrono::Vehicle deformable terrain family", "nodes": ["doxygen_documentation_manuals_vehicle_vehicle_terrain_chterrain", "doxygen_documentation_manuals_vehicle_vehicle_terrain_scmterrain", "doxygen_documentation_manuals_vehicle_vehicle_terrain_granularterrain", "doxygen_documentation_manuals_vehicle_vehicle_terrain_featerrain", "doxygen_documentation_manuals_vehicle_vehicle_terrain_crmterrain"], "relation": "implement", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/vehicle/vehicle_terrain.md"}]}