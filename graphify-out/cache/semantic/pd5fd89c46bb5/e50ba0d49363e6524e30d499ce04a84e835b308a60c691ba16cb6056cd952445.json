{"nodes": [{"id": "doxygen_documentation_manuals_vehicle_wheeled_steering_chsteering", "label": "ChSteering (steering mechanism base class)", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_steering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Base class contract: every derived steering template must expose a steering link body so that a steerable suspension can attach through its tierods; all hardpoints are given in a mechanism reference frame the template is free to choose."}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_steering_steering_link_body", "label": "Steering Link Body", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_steering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_steering_iso_reference_frame", "label": "ISO Reference Frame (vehicle)", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_steering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_steering_chpitmanarm", "label": "Pitman Arm Steering Template", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_steering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Modeled as a four-bar linkage: Pitman arm joined to the steering link by a universal joint and to the chassis by a revolute joint driven by the steering input; the idler arm is modeled as a composite revolute-spherical joint to avoid redundant constraints."}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_steering_chrackpinion", "label": "Rack-Pinion Steering Template", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_steering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Purely kinematic model: rather than modeling gear teeth, the rack displacement is computed from pinion radius, max pinion angle and normalized steering input, then imposed on a prismatic joint."}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_steering_rack_displacement_equation", "label": "Rack Displacement Equation d = r(alpha_max * s)", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_steering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_steering_chrotaryarm", "label": "Rotary Arm Steering Template", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_steering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A simple lever arm rotating about an axis; chosen for trucks, farm tractors and combine harvesters where it pairs with solid bellcrank and solid toebar axles."}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_steering_multiple_steering_mechanisms", "label": "Multiple Steering Mechanisms per Vehicle", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_steering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A wheeled vehicle may carry several steering mechanisms (one per steerable axle) and conversely one mechanism may drive several steerable axles."}], "edges": [{"source": "doxygen_documentation_manuals_vehicle_wheeled_steering_chpitmanarm", "target": "doxygen_documentation_manuals_vehicle_wheeled_steering_chsteering", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_