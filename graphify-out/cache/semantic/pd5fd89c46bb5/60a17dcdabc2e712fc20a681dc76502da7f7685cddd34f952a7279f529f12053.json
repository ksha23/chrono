{"nodes": [{"id": "doxygen_documentation_tutorials_postprocess_demo_gnuplot_demo_post_gnuplot", "label": "GNUplot Example (demo_POST_gnuplot.cpp)", "file_type": "document", "source_file": "doxygen/documentation/tutorials/postprocess/demo_gnuplot.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_tutorials_postprocess_demo_gnuplot_chgnuplot", "label": "chrono::postprocess::ChGnuPlot", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/postprocess/demo_gnuplot.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generates .gpl gnuplot scripts directly from C++ and auto-launches gnuplot on destruction. The class exists purely for convenience: the user could hand-write the script and .dat file, but the wrapper removes that manual round trip and provides shortcuts (SetGrid, SetLabelX/Y, Plot) for verbose gnuplot commands."}, {"id": "doxygen_documentation_tutorials_postprocess_demo_gnuplot_gnuplot", "label": "GNUplot (external tool)", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/postprocess/demo_gnuplot.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "External prerequisite (v4.6+) that must be on PATH; the module shells out to it, which is why the tutorial devotes a troubleshooting section to PATH and to running the .gpl script by hand to surface script errors."}, {"id": "doxygen_documentation_tutorials_postprocess_demo_gnuplot_embedded_data_plotting", "label": "Embedded-Data Plotting", "file_type": "rationale", "source_file": "doxygen/documentation/tutorials/postprocess/demo_gnuplot.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plot() can take in-memory data (ChVectorDynamic pairs, ChFunction, ChFunctionInterp, ChMatrixDynamic columns) and write the values inline in the .gpl file, removing the need for a separate .dat file. The documented cost is that Replot() no longer works with embedded data."}, {"id": "doxygen_documentation_tutorials_postprocess_demo_gnuplot_chfunctioninterp", "label": "chrono::ChFunctionInterp", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/postprocess/demo_gnuplot.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_tutorials_postprocess_demo_gnuplot_chvectordynamic", "label": "chrono::ChVectorDynamic", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/postprocess/demo_gnuplot.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_tutorials_postprocess_demo_gnuplot_chmatrixdynamic", "label": "chrono::ChMatrixDynamic", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/postprocess/demo_gnuplot.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "doxygen_documentation_tutorials_postprocess_demo_gnuplot_demo_post_gnuplot", "target": "doxygen_documentation_tutorials_postprocess_demo_gnuplot_chgnuplot", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/postprocess/demo_gnuplot.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_postprocess_demo_gnuplot_chgnuplot", "target": "doxygen_documentation_tutorials_postprocess_demo_gnuplot_gnuplot", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/postprocess/demo_gnuplot.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_postprocess_demo_gnuplot_chgnuplot", "target": "doxygen_documentati