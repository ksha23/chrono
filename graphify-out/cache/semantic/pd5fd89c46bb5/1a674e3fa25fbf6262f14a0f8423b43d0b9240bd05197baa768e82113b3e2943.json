{"nodes": [{"id": "doxygen_documentation_tutorials_solidworks_demo_engine_chrono_solidworks_addin", "label": "Chrono::SolidWorks Add-in", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses SolidWorks CAD as a preprocessor for Chrono: the CAD assembly already carries geometry, mass and inertia, so exporting it avoids hand-authoring a mechanism in code."}, {"id": "doxygen_documentation_tutorials_solidworks_demo_engine_solidworks_mate_to_chlink_export", "label": "Mate-to-ChLink Export Mapping", "file_type": "rationale", "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each moving SolidWorks part becomes a ChBody and each SolidWorks mating constraint becomes a ChLink; sub-assemblies must be switched from 'Solve as Rigid' to 'Solve as Flexible' or their internal joints are lost, and the first inserted part must be changed from Fixed to Floating so it can be constrained in Chrono instead."}, {"id": "doxygen_documentation_tutorials_solidworks_demo_engine_engine_py_exported_system", "label": "Exported Chrono System (.py)", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The exporter emits a Python module plus a <name>_shapes directory of .obj visualization meshes, separating simulation description from render geometry so meshes can be simplified in external tools such as Blender."}, {"id": "doxygen_documentation_tutorials_solidworks_demo_engine_test_py_runner", "label": "test.py / run_test.py Runner Stub", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auto-generated stub that loads the exported .py into a ChSystem, sets up Irrlicht or POV visualization and runs the loop; kept deliberately simple as a template the user is expected to copy and extend. Takes -f/--filename, -d/--timestep, -T/--Tlength, -v/--visualization, -p/--datapath."}, {"id": "doxygen_documentation_tutorials_solidworks_demo_engine_povray_postprocessing_pipeline", "label": "POVray Postprocessing Pipeline", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Batch alternative to the Irrlicht realtime view: Chrono postprocess emits .pov/.ini scripts, POVray raytraces .bmp frames into anim/, VirtualDub assembles them into an AVI (MPEG4/DivX suggested, 25-30 fps)."}, {"id": "doxygen_documentation_tutorials_solidworks_demo_engine_four_cylinder_engine_assembly", "label": "Four-Cylinder Engine Assembly", "file_type": "document", "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built by replicating the piston_rod subassembly three more times while avoiding redundant constraints."}], "edges": [{"source": "doxygen_documentation_tutorials_solidworks_demo_engine_chrono_solidworks_addin", "target": "doxygen_documentation_tutorials_solidworks_demo_engine_engine_py_exported_system", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_solidworks_demo_engine_solidworks_mate_to_chlink_export", "target": "doxygen_documentation_tutorials_solidworks_demo_engine