{"nodes": [{"id": "doxygen_documentation_manuals_vehicle_vehicle_visualization_vehicle_visualization", "label": "Vehicle visualization", "file_type": "document", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_visualization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chrono::VSG is the recommended run-time system, especially for CRM deformable terrain which the Irrlicht-based system does not support."}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_visualization_vsg_vehicle_plugin", "label": "VSG vehicle visualization plugin", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_visualization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adds vehicle-specific capabilities on top of base Chrono::VSG: chase camera, vehicle telemetry display, per-subsystem visibility control."}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_visualization_irrlicht_vehicle_apps", "label": "ChWheeledVehicleVisualSystemIrrlicht / ChTrackedVehicleVisualSystemIrrlicht", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_visualization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Extend ChVisualSystemIrrlicht with a vehicle-centric camera, vehicle statistics (speed, driver inputs, powertrain and sprocket torques) and contact-force rendering for tracked vehicles."}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_visualization_povray_workflow", "label": "POV-Ray off-line rendering workflow", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_visualization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WriteVisualizationAssets dumps per-frame CSV of body pose