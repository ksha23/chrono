{"nodes": [{"id": "src_chrono_dem_cmakelists_chrono_dem_target", "label": "Chrono_dem Library Target", "file_type": "code", "source_file": "src/chrono_dem/CMakeLists.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mixed CXX/CUDA-or-HIP target: it links Chrono_core PRIVATE and, on CUDA, the cudart_static/nvrtc/cuda_driver/cublas/cusparse toolkit targets PUBLIC; on HIP it links hip::host and adds the ROCm include directory instead. It also reaches back into ../chrono/gpu for ChGpuRuntime.h and ChGpuPrimitives.h, the shared GPU abstraction headers."}, {"id": "src_chrono_dem_cmakelists_gpu_backend_requirement", "label": "CUDA-or-HIP Requirement Gate", "file_type": "code", "source_file": "src/chrono_dem/CMakeLists.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If neither CHRONO_CUDA_FOUND nor CHRONO_HIP_FOUND is set the module force-disables its own option and returns, rather than failing the whole configure. The .cu sources are retagged LANGUAGE HIP when the HIP backend was resolved, so one source set serves both toolchains."}, {"id": "src_chrono_dem_cmakelists_eigen_version_gate", "label": "Eigen >= 3.3.6 Requirement", "file_type": "code", "source_file": "src/chrono_dem/CMakeLists.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An older Eigen self-disables Chrono::DEM with an explanatory message instead of producing a broken build."}, {"id": "src_chrono_dem_cmakelists_hip_architectures_off", "label": "HIP_ARCHITECTURES OFF for Mixed CXX/HIP Targets", "file_type": "rationale", "source_file": "src/chrono_dem/CMakeLists.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On a mixed-language target the HIP_ARCHITECTURES property leaks into ordinary CXX compilations (for example stb_image.cpp), making the host compiler see --offload-arch. The property is therefore disabled at target level and --offload-arch is passed only through COMPILE_LANGUAGE:HIP / LINK_LANGUAGE:HIP generator expressions."}, {"id": "src_chrono_dem_cmakelists_chconfigdem_header", "label": "ChConfigDem.h Generated Configuration Header", "file_type": "code", "source_file": "src/chrono_dem/CMakeLists.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Module-local mirror of the ChConfig.h pattern: substitution variables are configured into a header placed in the binary directory and installed to include/chrono_dem."}, {"id": "src_chrono_dem_cmakelists_chrono_dem_vsg_target", "label": "Chrono_dem_vsg Library Target", "file_type": "code", "source_file": "src/chrono_dem/CMakeLists.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Visualization is split into its own library so Chrono_dem does not gain a VSG dependency; it links Chrono_core and Chrono_dem PRIVATE and Chrono_vsg PUBLIC, and only exists when CH_ENABLE_MODULE_VSG is on."}], "edges": [{"source": "src_chrono_dem_cmakelists_chrono_dem_target", "target": "src_chrono_dem_cmakelists_gpu_backend_requirement", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/chrono_dem/CMakeLists.txt", "source_location": null, "weight": 1.0}, {"source": "src_chrono_dem_cmakelists_gpu_backend_requirement", "target": "src_cmakelists_chrono_gpu_backend_selection", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "src/chrono_dem/CMakeLists.txt", "source_location": null, "weight": 1.0}, {"source": "src_chrono_dem_cmakelists_hip_architectures_off", "target": "src_chrono_dem_cmakelists_chrono_dem_target", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/chrono_dem/CMakeLists.txt", "source_location": null, "weight": 1.0}, {"source": "src_chrono_dem_cmakelists_hip_architectures_off", "target": "src_cmakelists_chrono_gpu_backend_selection", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "src/chrono_dem/CMakeLists.txt", "source_location": null, "weight": 1.0}, {"source": "src_chrono_dem_cmakelists_eigen_version_gate", "target": "src_chrono_dem_cmakelists_gpu_backend_requirement", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "src/chrono_dem/CMakeLists.txt", "source_location": null, "weight": 1.0}, {"source": "src_chrono_dem_cmakelists_chconfigdem_header", "target": "src_cmakelists_chconfig_header_generation", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "src/chrono_dem/CMakeLists.txt", "source_location": null, "weight": 1.0}, {"source": "src_chrono_dem_cmakelists_chrono_dem_vsg_target", "target": "src_chrono_dem_cmakelists_chrono_dem_target", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/chrono_dem/CMakeLists.txt", "source_location": null, "weight": 1.0}, {"source": "src_chrono_dem_cmakelists_chrono_dem_vsg_target", "target": "src_chrono_cascade_cmakelists_cascade_irrlicht_optional_dependency", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "src/chrono_dem/CMakeLists.txt", "source_location": null, "weight": 1.0}, {"source": "src_chrono_dem_cmakelists_chrono_dem_target", "target": "src_chrono_cmakelists_chrono_core_target", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/chrono_dem/CMakeLists.txt", "source_location": null, "weight": 1.0}, {"source": "src_chrono_dem_cmakelists_chrono_dem_target", "target": "src_cmakelists_hip_eigen_alignment_workaround", "relation": "conceptually_related_to", "confidence": "AMBIGUOUS", "confidence_score": 0.3, "source_file": "src/chrono_dem/CMakeLists.txt", "source_location": null, "weight": 1.0}], "hyperedges": []}