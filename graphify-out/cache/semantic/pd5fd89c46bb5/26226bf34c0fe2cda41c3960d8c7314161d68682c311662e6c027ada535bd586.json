{"nodes": [{"id": "doxygen_documentation_manuals_parsers_yaml_schema_vehicle_model_vehicle_model_schema", "label": "Vehicle model YAML schema", "file_type": "document", "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_vehicle_model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rather than re-describing sub-systems in YAML, the vehicle model file only points at existing Chrono::Vehicle JSON specification files. Only model is a nested object; terrain_json, initial_position, initial_yaw and chase_camera sit at the top level as siblings of model."}, {"id": "doxygen_documentation_manuals_parsers_yaml_schema_vehicle_model_vehicle_json_subsystems", "label": "Vehicle JSON sub-system references", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_vehicle_model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "vehicle_json, engine_json and transmission_json are required and tire_json is required only for wheeled vehicles. The wheeled/tracked distinction is never stated in the YAML: it is inferred from the Template field of the vehicle JSON file, so one YAML shape serves both."}, {"id": "doxygen_documentation_manuals_parsers_yaml_schema_vehicle_model_chase_camera", "label": "chase_camera settings", "file_type": "concept", "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_vehicle_model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All-or-nothing block: if chase_camera is present then chassis_point, chase_distance and chase_height are all required."}, {"id": "doxygen_documentation_manuals_parsers_yaml_schema_vehicle_model_initial_yaw", "label": "initial_yaw degree convention", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_vehicle_model.md", 