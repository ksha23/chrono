{"nodes": [{"id": "doxygen_documentation_manuals_vehicle_vehicle_driver_vehicle_driver", "label": "Driver subsystem", "file_type": "document", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_driver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_driver_chdriver", "label": "ChDriver", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_driver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately minimal base: normalized throttle [0,1], steering [-1,1] and braking [0,1], plus Synchronize to receive vehicle state and Advance for internal dynamics. Derived templates may add gear selection or cross-drive."}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_driver_chinteractivedriver", "label": "ChInteractiveDriver", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_driver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Throttle and braking are coupled so acceleration first zeroes braking; supports lock/unlock of inputs and record/playback via an embedded data driver. Controller handling is tied to Irrlicht, inheriting its button-count limits."}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_driver_controller_json", "label": "controller.json axis and button mapping", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_driver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Real rigs spread pedals, wheel, H-shifter, sequential shifter, handbrake and button box across several USB devices, so each control names its device plus axis/button and a raw-to-scaled calibration range."}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_driver_chdatadriver", "label": "ChDataDriver", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_driver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Open-loop, no feedback: a four-column ASCII file of time, steering, throttle, braking is piecewise-linearly interpolated and held constant past the last entry - suited to standardized test maneuvers and design-of-experiment runs."}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_driver_pid_path_follower", "label": "PID path-follower controller", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_driver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pure P leaves residual lateral deviation and oscillates if the gain is too high; I-gain at 5-10% of P removes the residual but must be reset about every two minutes to avoid instability, and D-gain damps oscillation."}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_driver_sentinel_target_lookahead", "label": "Sentinel point and look-ahead distance", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_driver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Models a human driver's anticipation: error is the deviation between a sentinel point ahead of the vehicle and its projection (target point) onto the Bezier path."}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_driver_chpathfollowerdriver", "label": "ChPathFollowerDriver", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_driver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PID lateral plus PID speed control; works well in extreme maneuvers such as a double lane change."}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_driver_chpathfollowerdriversr", "label": "ChPathFollowerDriverSR", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_driver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Alternative for standard road driving: lateral strategy accounts for human and vehicle properties and anticipates by look-ahead time, so effective look-ahead distance scales with speed."}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_driver_chhumandriver", "label": "ChHumanDriver", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_driver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optimal-speed controller for long curved roads: both lateral and speed control use human behavior, vehicle properties, anticipation and driver field of view; lateral law is shared with ChPathFollowerDriverSR."}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_driver_chbeziercurve_path", "label": "Bezier-curve desired path", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_driver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "doxygen_documentation_manuals_vehicle_vehicle_driver_vehicle_driver", "target": "doxygen_documentation_manuals_vehicle_vehicle_driver_chdriver", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/vehicle/vehicle_driver.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_vehicle_vehicle_driver_chinteractivedriver", "target": "doxygen_documentation_manuals_vehicle_vehicle_driver_chdriver", "relation": "implements", "confidence": "EXTRACTED", "confidence_sco