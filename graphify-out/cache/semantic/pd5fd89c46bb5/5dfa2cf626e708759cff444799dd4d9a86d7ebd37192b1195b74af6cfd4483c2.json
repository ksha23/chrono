gen_documentation_manuals_vehicle_vehicle_driver_chdatadriver", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/vehicle/vehicle_driver.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_vehicle_vehicle_driver_chpathfollowerdriver", "target": "doxygen_documentation_manuals_vehicle_vehicle_driver_pid_path_follower", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/vehicle/vehicle_driver.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_vehicle_vehicle_driver_pid_path_follower", "target": "doxygen_documentation_manuals_vehicle_vehicle_driver_sentinel_target_lookahead", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/vehicle/vehicle_driver.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_vehicle_vehicle_driver_sentinel_target_lookahead", "target": "doxygen_documentation_manuals_vehicle_vehicle_driver_chbeziercurve_path", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/vehicle/vehicle_driver.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_vehicle_vehicle_driver_chhumandriver", "target": "doxygen_documentation_manuals_vehicle_vehicle_driver_chpathfollowerdriversr", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/vehicle/vehicle_driver.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_vehicle_vehicle_driver_chpathfollowerdriversr", "target": "doxygen_documentation_manuals_vehicle_vehicle_driver_pid_path_follower", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "doxyge