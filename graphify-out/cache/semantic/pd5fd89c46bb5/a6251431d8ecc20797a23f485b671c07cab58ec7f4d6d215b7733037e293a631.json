{"nodes": [{"id": "src_demos_csharp_cmakelists_findduplicates", "label": "FindDuplicates (CMake list-intersection helper)", "file_type": "code", "source_file": "src/demos/csharp/CMakeLists.txt", "source_location": "lines 3-25", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_demos_csharp_cmakelists_collectcsharpfiles", "label": "CollectCSharpFiles (SWIG .cs source collector)", "file_type": "code", "source_file": "src/demos/csharp/CMakeLists.txt", "source_location": "lines 29-157", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_demos_csharp_cmakelists_chrono_configure_csharp_demo", "label": "chrono_configure_csharp_demo (wrapper DLL reference injector)", "file_type": "code", "source_file": "src/demos/csharp/CMakeLists.txt", "source_location": "lines 194-207", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_demos_csharp_cmakelists_chrono_csharp_using_wrapper", "label": "CHRONO_CSHARP_USING_WRAPPER mode switch", "file_type": "rationale", "source_file": "src/demos/csharp/CMakeLists.txt", "source_location": "lines 176-207", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two build modes for C# demos. When CH_USE_CSHARP_WRAPPER is ON the demos reference the prebuilt managed chrono_csharp_wrapper.dll so each executable stays tiny; otherwise every demo falls back to embedding all generated SWIG .cs sources directly (the original approach), which keeps demos standalone-compilable but duplicates the wrapper code into each exe. The wrapper path additionally requires CMAKE_RUNTIME_OUTPUT_DIRECTORY to be set (FATAL_ERROR otherwise) because the DLL reference path is computed from it."}, {"id": "src_demos_csharp_cmakelists_chrono_csharp_module_dirs", "label": "chrono_csharp per-module generated source directories", "file_type": "concept", "source_file": "src/demos/csharp/CMakeLists.txt", "source_location": "lines 29-157", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SWIG output is laid out as ${PROJECT_BINARY_DIR}/../chrono_csharp/<module> for core, irrlicht, vsg, postprocess, vehicle, sensor and robot. Because SWIG emits overlapping helper .cs files per module, CollectCSharpFiles de-duplicates each later module against everything already collected before appending, so the same type is never compiled twice into one demo."}], "edges": [{"source": "src_demos_csharp_cmakelists_collectcsharpfiles", "target": "src_demos_csharp_cmakelists_findduplicates", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/demos/csharp/CMakeLists.txt", "source_location": "lines 57, 75, 93, 111, 129, 147", "weight": 1.0}, {"source": "src_demos_csharp_cmakelists_collectcsharpfiles", "target": "src_demos_csharp_cmakelists_chrono_csharp_module_dirs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/demos/csharp/CMakeLists.txt", "source_location": "lines 36, 51, 69, 87, 105, 123, 141", "weight": 1.0}, {"source": "src_demos_csharp_cmakelists_chrono_csharp_using_wrapper", "target": "src_demos_csharp_cmakelists_chrono_configure_csharp_demo", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/demos/csharp/CMakeLists.txt", "source_location": "lines 192-207", "weight": 1.0}, {"source": "src_demos_csharp_cmakelists_chrono_configure_csharp_demo", "target": "src_demos_csharp_ros_cmakelists_demos", "relation": "references", "confidence": "AMBIGUOUS", "confidence_score": 0.2, "source_file": "src/demos/csharp/CMakeLists.txt", "source_location": "lines 218-221", "weight": 1.0}, {"source": "src_demos_csharp_cmakelists_findduplicates", "target": "src_demos_csharp_cmakelists_chrono_configure_csharp_demo", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "src/demos/csharp/CMa