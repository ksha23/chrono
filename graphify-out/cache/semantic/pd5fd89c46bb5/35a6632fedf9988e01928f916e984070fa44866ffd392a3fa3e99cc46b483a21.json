xygen/documentation/tutorials/solidworks/demo_engine_advanced.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_solidworks_demo_engine_advanced_chpovrayassetcustom", "target": "doxygen_documentation_tutorials_solidworks_demo_engine_povray_rendering_pipeline", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine_advanced.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_solidworks_demo_engine_advanced_visual_debugging_overlays", "target": "doxygen_documentation_tutorials_solidworks_demo_engine_advanced_chpovrayassetcustom", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine_advanced.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_solidworks_demo_engine_advanced_visual_debugging_overlays", "target": "doxygen_documentation_tutorials_solidworks_demo_engine_advanced_chbodyauxref_reference_frame", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine_advanced.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_solidworks_demo_engine_advanced_chbodyauxref_reference_frame", "target": "doxygen_documentation_tutorials_solidworks_demo_engine_assembly_to_python_export", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/solidworks/demo_engine_advanced.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_solidworks_demo_engine_advanced_chbodyauxref_reference_frame", "target": "doxygen_documentation_tutorials_solidworks_demo_engine_flexible_subassembly", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confid