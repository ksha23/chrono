{"nodes": [{"id": "src_chrono_thirdparty_yaml_cpp_docs_tutorial_yaml_loadfile", "label": "YAML::LoadFile", "file_type": "concept", "source_file": "src/chrono_thirdparty/yaml-cpp/docs/Tutorial.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_chrono_thirdparty_yaml_cpp_docs_tutorial_yaml_load", "label": "YAML::Load", "file_type": "concept", "source_file": "src/chrono_thirdparty/yaml-cpp/docs/Tutorial.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_chrono_thirdparty_yaml_cpp_docs_tutorial_yaml_node", "label": "YAML::Node (new API)", "file_type": "concept", "source_file": "src/chrono_thirdparty/yaml-cpp/docs/Tutorial.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single Node type represents every node including the root, and collection nodes behave like STL vectors/maps so users reuse familiar idioms."}, {"id": "src_chrono_thirdparty_yaml_cpp_docs_tutorial_node_as", "label": "Node::as<T>", "file_type": "concept", "source_file": "src/chrono_thirdparty/yaml-cpp/docs/Tutorial.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_chrono_thirdparty_yaml_cpp_docs_tutorial_yaml_convert", "label": "YAML::convert<T> specialization", "file_type": "rationale", "source_file": "src/chrono_thirdparty/yaml-cpp/docs/Tutorial.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Custom types plug in by specializing a template with encode/decode rather than by overloading a stream operator, so conversion works in both directions and inside generic code such as as<T>()."}, {"id": "src_chrono_thirdparty_yaml_cpp_docs_tutorial_convert_encode", "label": "convert<T>::encode", "file_type": "concept", "source_file": "src/chrono_thirdparty/yaml-cpp/docs/Tutorial.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_chrono_thirdparty_yaml_cpp_docs_tutorial_convert_decode", "label": "convert<T>::decode", "file_type": "concept", "source_file": "src/chrono_thirdparty/yaml-cpp/docs/Tutorial.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_chrono_thirdparty_yaml_cpp_docs_tutorial_const_iterator", "label": "YAML::const_iterator", "file_type": "concept", "source_file": "src/chrono_thirdparty/yaml-cpp/docs/Tutorial.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_chrono_thirdparty_yaml_cpp_docs_tutorial_node_aliases", "label": "Node aliasing and anchors", "file_type": "rationale", "source_file": "src/chrono_thirdparty/yaml-cpp/docs/Tutorial.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Assigning one node into another creates an alias rather than a copy, which is what makes self-references and cyclic graphs expressible; emission then falls back on YAML anchors."}, {"id": "src_chrono_thirdparty_yaml_cpp_docs_tutorial_sequence_to_map", "label": "Sequence-to-map promotion", "file_type": "rationale", "source_file": "src/chrono_thirdparty/yaml-cpp/docs/Tutorial.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Indexing a sequence outside its range turns it into a map keyed by index; the single exception is an index one past the end, which grows the sequence instead."}, {"id": "src_chrono_thirdparty_yaml_cpp_docs_tutorial_non_creating_key_query", "label": "Non-creating key query", "file_type": "rationale", "source_file": "src/chrono_thirdparty/yaml-cpp/docs/Tutorial.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": nul