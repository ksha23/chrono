{"nodes": [{"id": "doxygen_documentation_manuals_chrono_collisions_collisions", "label": "Collisions (Chrono manual page)", "file_type": "document", "source_file": "doxygen/documentation/manuals/chrono/collisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_chrono_collisions_collision_detection", "label": "Collision detection phase", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/chrono/collisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Split from contact formulation: detection only finds point pairs that are, or may soon be, in contact."}, {"id": "doxygen_documentation_manuals_chrono_collisions_contact_formulation", "label": "Contact formulation", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/chrono/collisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defines the reaction forces between shapes in contact; the NSC/SMC choice can change usable timestep size by two or three orders of magnitude."}, {"id": "doxygen_documentation_manuals_chrono_collisions_chsystemnsc", "label": "ChSystemNSC / Non-Smooth Contact", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/collisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Treats contacts as hard constraints; no artificial stiffening so longer timesteps are allowed, but requires VI solvers."}, {"id": "doxygen_documentation_manuals_chrono_collisions_chsystemsmc", "label": "ChSystemSMC / Smooth Contact (penalty)", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/collisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Penalty approach using interpenetration times an artificial stiffness; needs much shorter timesteps but no VI solver."}, {"id": "doxygen_documentation_manuals_chrono_collisions_chcollisionsystembullet", "label": "ChCollisionSystemBullet", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/collisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_chrono_collisions_chcollisionsystemmulticore", "label": "ChCollisionSystemMulticore", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/collisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In-house multicore collision engine, enabled only when Thrust is available."}, {"id": "doxygen_documentation_manuals_chrono_collisions_chcollisionmodel", "label": "ChCollisionModel", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/collisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_chrono_collisions_chcollisionshape", "label": "ChCollisionShape", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/collisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_chrono_collisions_chgeometry", "label": "ChGeometry", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/collisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_chrono_collisions_chcontactmaterial", "label": "ChContactMaterial (NSC/SMC)", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/collisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stored by pointer so materials can be shared across bodies; a caveat is that cloned bodies share one instance, so edits propagate."}, {"id": "doxygen_documentation_manuals_chrono_collisions_chcontactsurface", "label": "fea::ChContactSurface", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/collisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Carries collision geometry for FEA meshes (ChContactSurfaceMesh, ChContactSurfaceNodeCloud) instead of a ChCollisionModel."}, {"id": "doxygen_documentation_manuals_chrono_collisions_collision_families", "label": "Collision families", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/chrono/collisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Up to 15 families allow selective collision filtering so bodies can be excluded from each other cheaply."}, {"id": "doxygen_documentation_manuals_chrono_collisions_collision_envelope", "label": "Collision envelope", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/chrono/collisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Outward tolerance that creates constraints before contact happens: too large wastes memory and time, too small risks tunneling."}, {"id": "doxygen_documentation_manuals_chrono_collisions_collision_margin", "label": "Collision margin", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/chrono/collisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inward shrink/expand tolerance: too large rounds off corners visibly, too small drops to the slower narrowphase algorithm too early."}, {"id": "doxygen_documentation_manuals_chrono_collisions_contact_breaking_threshold", "label": "Contact breaking threshold (Bullet only)", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/collisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_chrono_collisions_broadphasecallback", "label": "ChCollisionSystem::BroadphaseCallback", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/collisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_chrono_collisions_narrowphasecallback", "label": "ChCollisionSystem::NarrowphaseCallback", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/collisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_chrono_collisions_chbodyeasy", "label": "ChBodyEasyXXXX helper bodies", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/collisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Create body, visual shape and (optionally) collision shape in one command; collision is off unless explicitly requested."}, {"id": "doxygen_documentation_manuals_chrono_collisions_convex_decomposition", "label": "Convex decomposition of concave shapes", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/chrono/collisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Concave collision geometry is handled by decomposing it into a union of convex shapes; compound shapes slow the broadphase, so a single sphere at the COM is the cheapest possible model."}], "edges": [{"source": "doxygen_documentation_manuals_chrono_c