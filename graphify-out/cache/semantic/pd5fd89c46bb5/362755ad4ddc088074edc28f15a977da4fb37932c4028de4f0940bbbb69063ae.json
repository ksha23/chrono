{"nodes": [{"id": "doxygen_documentation_manuals_parsers_yaml_schema_fsisph_solver_sph_solver_schema", "label": "FSI-SPH solver YAML schema", "file_type": "document", "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_fsisph_solver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every object is optional and any omitted property keeps its default, so a minimal solver file is valid. The file carries no output or visualization settings; those belong to the FSI-SPH simulation file."}, {"id": "doxygen_documentation_manuals_parsers_yaml_schema_fsisph_solver_sph_method", "label": "Weakly compressible SPH method parameters", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_fsisph_solver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Base weakly compressible formulation: ISOTHERMAL or TAIT equation of state, delta-SPH density diffusion on by default to damp density noise, a max_velocity used for scaling, and a CRM-only free_surface_threshold compared against the divergence of the position field to flag free-surface particles."}, {"id": "doxygen_documentation_manuals_parsers_yaml_schema_fsisph_solver_kernel", "label": "SPH kernel and resolution", "file_type": "concept", "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_fsisph_solver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kernel length is defined as d0_multiplier * initial_spacing, so changing particle resolution rescales the smoothing length automatically."}, {"id": "doxygen_documentation_manuals_parsers_yaml_schema_fsisph_solver_discretization", "label": "Consistent (corrected) SPH discretization", "file_type": "concept", "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_fsisph_solver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optional G-matrix gradient and L-matrix Laplacian corrections, off by default because they cost more than the uncorrected operators."}, {"id": "doxygen_documentation_manuals_parsers_yaml_schema_fsisph_solver_boundary_conditions", "label": "Fluid-solid boundary treatment (ADAMI/HOLMES)", "file_type": "concept", "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_fsisph_solver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_parsers_yaml_schema_fsisph_solver_integration", "label": "SPH integration scheme and time step", "file_type": "concept", "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_fsisph_solver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "EULER/RK2/VERLET/SYMPLECTIC/IMPLICIT_SPH; time_step is mandatory whenever the integration object exists since there is no safe default fluid step."}, {"id": "doxygen_documentation_manuals_parsers_yaml_schema_fsisph_solver_proximity_search", "label": "Proximity (neighbor) search cadence", "file_type": "concept", "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_fsisph_solver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "num_proximity_search_steps trades neighbor-list accuracy against rebuild cost; defaults to rebuilding every step."}, {"id": "doxygen_documentation_manuals_parsers_yaml_schema_fsisph_solver_particle_shifting", "label": "Particle shifting algorithms", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_fsisph_solver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NONE/PPST/XSPH/PPST_XSPH/DIFFUSION/DIFFUSION_XSPH keep particle distributions regular; which coefficients matter depends on the selected method, and shifting_beta_implicit applies only under the IMPLICIT_SPH scheme."}, {"id": "doxygen_documentation_manuals_parsers_yaml_schema_fsisph_solver_viscosity", "label": "Viscosity treatment", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_fsisph_solver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LAMINAR uses the physical viscosity from the SPH model file's fluid_properties, while the ARTIFICIAL_* methods use the artificial_viscosity coefficient instead - so the model file and solver file are coupled through this choice."}], "edges": [{"source": "doxygen_documentation_manuals_parsers_yaml_schema_fsisph_solver_sph_solver_schema", "target": "doxygen_documentation_manuals_parsers_yaml_schema_fsisph_solver_sph_method", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_fsisph_solver.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_parsers_yaml_schema_fsisph_solver_sph_solver_schema", "target": "doxygen_documentation_manuals_parsers_yaml_schema_fsisph_solver_kernel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_fsisph_solver.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_parsers_yaml_schema_fsisph_solver_sph_solver_schema", "target": "doxygen_documentation_manuals_parsers_yaml_schema_fsisph_solver_discretization", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_fsisph_solver.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_parsers_yaml_schema_fsisph_solver_s