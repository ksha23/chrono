{"nodes": [{"id": "doxygen_documentation_manuals_sensor_camera_sensor_chcamerasensor", "label": "ChCameraSensor", "file_type": "concept", "source_file": "doxygen/documentation/manuals/sensor/camera_sensor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Setup automatically appends the OptiX render filter, and appends the image alias filter with an adjusted resolution when supersample_factor exceeds 1, so antialiasing is handled by the pipeline rather than by the user."}, {"id": "doxygen_documentation_manuals_sensor_camera_sensor_optix_ray_tracing", "label": "GPU Ray-Traced Synthetic Data (NVIDIA OptiX)", "file_type": "concept", "source_file": "doxygen/documentation/manuals/sensor/camera_sensor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OptiX is used for its hardware-accelerated and headless rendering capability, which is what makes synthetic sensor data generation viable without a display. A physically based BRDF shader recursively spawns secondary rays for shadows, reflection and refraction."}, {"id": "doxygen_documentation_manuals_sensor_camera_sensor_choptixengine", "label": "ChOptixEngine", "file_type": "concept", "source_file": "doxygen/documentation/manuals/sensor/camera_sensor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_sensor_camera_sensor_render_thread_decoupling", "label": "Render Thread Decoupling", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/sensor/camera_sensor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Camera update frequency is far below the physics rate, so ChOptixEngine spawns a rendering thread and the main thread only pushes cameras onto a render queue and later collects ready data, never blocking on the render itself."}, {"id": "doxygen_documentation_manuals_sensor_camera_sensor_chfilteroptixrender", "label": "ChFilterOptixRender", "file_type": "concept", "source_file": "doxygen/documentation/manuals/sensor/camera_sensor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_sensor_camera_sensor_chfilterimgalias", "label": "ChFilterImgAlias", "file_type": "concept", "source_file": "doxygen/documentation/manuals/sensor/camera_sensor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "doxygen_documentation_manuals_sensor_camera_sensor_chcamerasensor", "target": "doxygen_documentation_manuals_sensor_camera_sensor_optix_ray_tracing", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/sensor/camera_sensor.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_sensor_camera_sensor_chcamerasensor", "target": "doxygen_documentation_manuals_sensor_camera_sensor_chfilteroptixrender", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/sensor/camera_sensor.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_sensor_camera_sensor_chcamerasensor", "target": "doxygen_documentation_manuals_sensor_camera_sensor_chfilterimgalias", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/sensor/camera_sensor.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_sensor_camera_sensor_choptixengine", "target": "doxygen_documentation_manuals_sensor_camera_sensor_chfilteroptixrender", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation