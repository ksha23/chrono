{"nodes": [{"id": "doxygen_documentation_manuals_synchrono_adding_new_agent_flatc_compiler", "label": "flatc FlatBuffers Compiler", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/adding_new_agent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the FlatBuffers header is needed to run SynChrono, but a built flatc compiler is needed to edit schemas, which is unavoidable when adding a new agent because a new message schema is required."}, {"id": "doxygen_documentation_manuals_synchrono_adding_new_agent_agent_fbs_schema", "label": "Agent.fbs Schema", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/adding_new_agent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each agent contributes a State table (information passed every update) and a Description table (information needed for initialization), plus entries in the union Type so the message can be discriminated on the wire."}, {"id": "doxygen_documentation_manuals_synchrono_adding_new_agent_synagent", "label": "SynAgent", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/adding_new_agent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Abstract base whose pure virtuals a new agent must override: constructor (including a no-argument form used to build an agent from a description message), InitializeZombie, SynchronizeZombie, Update, GatherMessages and GatherDescriptionMessages."}, {"id": "doxygen_documentation_manuals_synchrono_adding_new_agent_syncopteragent", "label": "SynCopterAgent", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/adding_new_agent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Worked example of a non-vehicle agent; it guards Update with an early return when the local copter pointer is null because updating the state of a zombie is pointless. JSON initialization is available for vehicle agents but not for general new agents."}, {"id": "doxygen_documentation_manuals_synchrono_adding_new_agent_synmessage_conversion", "label": "SynMessage ConvertFromFlatBuffers / ConvertToFlatBuffers", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/adding_new_agent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_synchrono_adding_new_agent_synmessagefactory", "label": "SynMessageFactory", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/adding_new_agent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses dynamic cast on the FlatBuffers message_type to infer concrete message type, so every new message type requires an additional else-if branch in the states and descriptions chains."}, {"id": "doxygen_documentation_manuals_synchrono_adding_new_agent_agentfactory", "label": "AgentFactory", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/adding_new_agent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses dynamic casts to build a zombie agent from a description arriving from another rank, so it must be extended per agent type and must fully apply the description (mesh files, propeller count, key)."}, {"id": "doxygen_documentation_manuals_synchrono_adding_new_agent_zombie_lifecycle", "label": "Zombie Initialize/Synchronize Lifecycle", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/adding_new_agent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "InitializeZombie creates fixed bodies whose pose is driven entirely by remote messages; SynchronizeZombie applies incoming poses. Making zombie bodies fixed means the local solver never integrates them."}], "edges": [{"source": "doxygen_documentation_manuals_synchrono_adding_new_agent_flatc_compiler", "target": "doxygen_documentation_manuals_synchrono_adding_new_agent_agent_fbs_schema", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/synchrono/adding_new_agent.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_synchrono_adding_new_agent_agent_fbs_schema", "target": "doxygen_documentation_manuals_synchrono_synchrono_overview_flatbuffers_serialization", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/synchrono/adding_new_agent.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_synchrono_adding_new_agent_syncopteragent", "target": "doxygen_documentation_manuals_synchrono_adding_new_agent_synagent", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/synchrono/adding_new_agent.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_synchrono_adding_new_agent_synagent", "target": "doxygen_documentation_manuals_synchrono_adding_new_agent_zombie_lifecycle", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/synchrono/adding_new_agent.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_synchrono_adding_new_agent_synmessagefactory", "target": "doxygen_documentation_manuals_synchrono_adding_new_agent_agent_fbs_schema", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documen