{"nodes": [{"id": "doxygen_documentation_manuals_modal_manual_modal_chrono_modal", "label": "Chrono::Modal module", "file_type": "document", "source_file": "doxygen/documentation/manuals/modal/manual_modal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_modal_manual_modal_modal_analysis", "label": "Modal analysis", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/modal/manual_modal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Extracts mode shapes, frequencies and damping ratios of structures and mechanisms; supports finite elements, rigid bodies, constraints and rigid-body modes so a whole mechanism (not only an FE mesh) can be characterized."}, {"id": "doxygen_documentation_manuals_modal_manual_modal_modal_reduction", "label": "Modal reduction", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/modal/manual_modal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trades model fidelity for speed: replaces internal states with a reduced basis that preserves behavior over a chosen frequency band, giving fewer states and a large performance gain while the full internal state is still reconstructed for visualization. Limitation accepted by design: only linear dynamics of the subassembly is supported, so the subassembly cannot undergo large rotations (e.g. a helicopter blade)."}, {"id": "doxygen_documentation_manuals_modal_manual_modal_eigenvalue_solver", "label": "Eigenvalue solvers (pure-matrix layer)", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/modal/manual_modal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately decoupled from ChSystem/ChAssembly so they operate on pure matrices only; accept real matrices, implement shift-and-invert iterative methods, handle sparse matrices, and return the lowest eigenvalues relative to the shift. Not intended for direct use by the average user."}, {"id": "doxygen_documentation_manuals_modal_manual_modal_modal_solver", "label": "Modal solvers (ChAssembly interface layer)", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/modal/manual_modal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Interface classes that run an eigenvalue solver on a ChAssembly and can include damping; the preferred entry point for the average user. Split undamped vs damped because the damped problem is always unsymmetric and therefore requires an unsymmetric eigenvalue solver."}, {"id": "doxygen_documentation_manuals_modal_manual_modal_chsymgeneigenvaluesolver", "label": "ChSymGenEigenvalueSolver", "file_type": "concept", "source_file": "doxygen/documentation/manuals/modal/manual_modal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_modal_manual_modal_chunsymgeneigenvaluesolver", "label": "ChUnsymGenEigenvalueSolver", "file_type": "concept", "source_file": "doxygen/documentation/manuals/modal/manual_modal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_modal_manual_modal_chunsymgeneigenvaluesolverkrylovschur", "label": "ChUnsymGenEigenvalueSolverKrylovSchur", "file_type": "concept", "source_file": "doxygen/documentation/manuals/modal/manual_modal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_modal_manual_modal_chmodalsolverdamped", "label": "ChModalSolverDamped", "file_type": "concept", "source_file": "doxygen/documentation/manuals/modal/manual_modal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_modal_manual_modal_chmodalassembly", "label": "ChModalAssembly", "file_type": "concept", "source_file": "doxygen/documentation/manuals/modal/manual_modal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Splits its contents into boundary items (Add(), on the border with the external world) and internal items (AddInternal(), later reduced), so DoModalReduction() knows which DOFs must be retained for coupling and which may be condensed away."}, {"id": "doxygen_documentation_manuals_modal_manual_modal_domodalreduction", "label": "ChModalAssembly::DoModalReduction()", "file_type": "concept", "source_file": "doxygen/documentation/manuals/modal/manual_modal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_modal_manual_modal_chmodalvisualsystemirrlicht", "label": "ChModalVisualSystemIrrlicht", "file_type": "concept", "source_file": "doxygen/documentation/manuals/modal/manual_modal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Header-only and therefore not shipped in a shared library; CMake enables it automatically when the Irrlicht module is on, since mode-shape visualization requires Irrlicht. Templated on double or std::complex<double> to match the eigenvalue solver in use, and AttachAssembly must be called only after Solve()."}, {"id": "doxygen_documentation_manuals_modal_manual_modal_chassembly", "label": "ChAssembly (top-level system assembly)", "file_type": "concept", "source_file": "doxygen/documentation/manuals/modal/manual_modal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ChSystem holds one top-level ChAssembly which may nest further assemblies, so only a subset of the system can be analyzed or reduced by adding objects to a sub-assembly and the sub-assembly to the system."}, {"id": "doxygen_documentation_manuals_modal_manual_modal_demo_mod_analysis", "label": "demo_MOD_analysis", "file_type": "document", "source_file": "doxygen/documentation/manuals/modal/manual_modal.md", "source_location": null, "source_url": "https://github.com/projectchrono/chrono/blob/main/src/demos/modal/demo_MOD_analysis.cpp", "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_modal_manual_modal_demo_mod_reduction", "label": "demo_MOD_reduction", "file_type": "document", "source_file": "doxygen/documentation/manuals/modal/manual_modal.md", "source_location": null, "source_url": "https://github.com/projectchrono/chrono/blob/main/src/demos/modal/demo_MOD_reduction.cpp", "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "doxygen_documentation_manuals_modal_manual_modal_chrono_modal", "target": "doxygen_documentation_manuals_modal_manual_modal_modal_analysis", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/modal/manual_modal.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_modal_manual_modal_chrono_modal", "target": "doxygen_documentation_manuals_modal_manual_modal_modal_reduction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/modal/manual_modal.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_modal_manual_modal_modal_analysis", "target": "doxygen_documentation_manuals_modal_manual_modal_eigenvalue_solver", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/modal/manual_modal.md", "source_location": n