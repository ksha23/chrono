{"nodes": [{"id": "doxygen_documentation_manuals_parsers_yaml_schema_fsi_simulation_fsi_simulation_schema", "label": "FSI simulation YAML schema", "file_type": "document", "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_fsi_simulation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Top-level co-simulation file: references an MBS simulation file and a fluid simulation file by relative path, describes the coupling, and owns the co-simulation metastep, so any fluid solver implementing the Chrono::FSI API can be plugged in."}, {"id": "doxygen_documentation_manuals_parsers_yaml_schema_fsi_simulation_fsi_bodies", "label": "fsi_bodies coupling specification", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_fsi_simulation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Names MBS bodies that interact with the fluid plus the shapes used to generate fluid-solid interface markers. Lookup is by name and matches every instance of that body, so one entry covers a multiply-instantiated MBS model; an unmatched name is a warning, not an error, so partial models still run."}, {"id": "doxygen_documentation_manuals_parsers_yaml_schema_fsi_simulation_cosimulation_metastep", "label": "Co-simulation metastep", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_fsi_simulation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A separate outer time_step at which the MBS and fluid solvers exchange data, distinct from each solver's own internal integration step."}, {"id": "doxygen_documentation_manuals_parsers_yaml_schema_fsi_simulation_data_path", "label": "data_path relocatable file resolution", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_fsi_simulation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shared ABSOLUTE/RELATIVE + root convention used across every Chrono YAML schema so a specification directory can be moved without rewriting every referenced data file path; defaults to absolute paths."}, {"id": "doxygen_documentation_manuals_parsers_yaml_schema_fsi_simulation_output_options", "label": "FSI output options (format/mode/fps)", "file_type": "concept", "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_fsi_simulation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "format is mandatory whenever the output key is present, and HDF5 silently degrades to NONE in a build without HDF5 support so the same YAML runs on any build."}, {"id": "doxygen_documentation_manuals_parsers_yaml_schema_fsi_simulation_visualization_options", "label": "FSI run-time visualization options", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_fsi_simulation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Presence of the key alone enables rendering (no type entry at this level). Camera and general rendering settings live here, while body shapes come from the referenced MBS file and fluid-phase rendering from the referenced fluid file - one place per concern."}], "edges": [{"source": "doxygen_documentation_manuals_parsers_yaml_schema_fsi_simulation_fsi_simulation_schema", "target": "doxygen_documentation_manuals_parsers_yaml_schema_mbs_simulation_mbs_simulation_schema", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_fsi_simulation.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_parsers_yaml_schema_fsi_sim