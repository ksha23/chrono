{"nodes": [{"id": "doxygen_documentation_manuals_chrono_coordinate_transformations_coordinate_systems", "label": "Coordinate Systems (Chrono manual page)", "file_type": "document", "source_file": "doxygen/documentation/manuals/chrono/coordinate_transformations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_chrono_coordinate_transformations_chvector3", "label": "ChVector3", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/coordinate_transformations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not derived from Eigen vectors, so .eigen() is needed to reach Eigen algorithms."}, {"id": "doxygen_documentation_manuals_chrono_coordinate_transformations_chquaternion", "label": "ChQuaternion", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/coordinate_transformations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recommended representation for rotations; only unit-norm quaternions are valid and the scalar part is stored first."}, {"id": "doxygen_documentation_manuals_chrono_coordinate_transformations_chmatrix33", "label": "ChMatrix33 rotation matrix", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/coordinate_transformations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Used mainly for performance; orthonormal so the inverse is the transpose."}, {"id": "doxygen_documentation_manuals_chrono_coordinate_transformations_chcoordsys", "label": "ChCoordsys", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/coordinate_transformations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lightweight vector+quaternion pair; saves memory when the extra rotation matrix of ChFrame is not needed."}, {"id": "doxygen_documentation_manuals_chrono_coordinate_transformations_chframe", "label": "ChFrame", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/coordinate_transformations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Embeds a ChCoordsys plus a cached 3x3 rotation matrix to speed up transforms where quaternions would be slower."}, {"id": "doxygen_documentation_manuals_chrono_coordinate_transformations_chframemoving", "label": "ChFrameMoving", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/coordinate_transformations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Extends ChFrame with velocity and acceleration state; transformations automatically account for centripetal, relative and Coriolis terms."}, {"id": "doxygen_documentation_manuals_chrono_coordinate_transformations_chmarker", "label": "ChMarker", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/coordinate_transformations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auxiliary frame attached to a rigid body that can also move relative to it; used mostly by the ChLinkLock family."}, {"id": "doxygen_documentation_manuals_chrono_coordinate_transformations_transform_operators", "label": "'*' vs '>>' transformation operators", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/chrono/coordinate_transformations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'>>' composes left-to-right, matching the subscript chain and exploiting compiler left-to-right precedence so vector-first chains produce temporary vectors rather than temporary ChFrame objects; '*=' and '>>=' avoid temporaries entirely."}, {"id": "doxygen_documentation_manuals_chrono_coordinate_transformations_wrench_transformation", "label": "Wrench (force+torque) transformation", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/coordinate_transformations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Moving a force to a different frame introduces an extra torque term purely from the change of origin."}, {"id": "doxygen_documentation_manuals_chrono_coordinate_transformations_frame_inversion", "label": "GetInverse vs TransformParentToLocal", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/chrono/coordinate_transformations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GetInverse is readable but can be less efficient than the low-level TransformParentToLocal for solving a transform chain."}], "edges": [{"source": "doxygen_documentation_manuals_chrono_coordinate_transformations_coordinate_systems", "target": "doxygen_documentation_manuals_chrono_coordinate_transformations_chvector3", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/chrono/coordinate_transformations.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_chrono_coordinate_transformations_coordinate_systems", "target": "doxygen_documentation_manuals_chrono_coordinate_transformations_chquaternion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/chrono/coordinate_transformations.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_chrono_coordinate_transformations_coordinate_systems", "target": "doxygen_documentation_manuals_chrono_c