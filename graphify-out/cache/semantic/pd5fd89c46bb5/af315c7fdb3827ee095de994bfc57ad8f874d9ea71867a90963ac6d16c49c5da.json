{"nodes": [{"id": "doxygen_documentation_manuals_synchrono_adding_new_agent_adding_new_agent", "label": "How to Add a New Agent to SynChrono", "file_type": "document", "source_file": "doxygen/documentation/manuals/synchrono/adding_new_agent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_synchrono_adding_new_agent_flatc_compiler", "label": "flatc FlatBuffers compiler workflow", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/adding_new_agent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the FlatBuffers header is needed to run SynChrono, but editing schemas requires a built flatc to regenerate SynFlatBuffers_generated.h; FlatBuffers ships as a Chrono submodule so it can be built from source."}, {"id": "doxygen_documentation_manuals_synchrono_adding_new_agent_agent_fbs_schema", "label": "Agent.fbs State and Description tables", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/adding_new_agent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "State carries what must be passed every update; Description carries what is needed once for initialization. A new agent must also be added to the union Type."}, {"id": "doxygen_documentation_manuals_synchrono_adding_new_agent_syncopteragent", "label": "SynCopterAgent", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/adding_new_agent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Worked example of deriving from SynAgent: needs a no-argument constructor so it can be built from a description message, plus InitializeZombie, SynchronizeZombie, Update, GatherMessages and GatherDescriptionMessages. Update returns early when the agent is a zombie."}, {"id": "doxygen_documentation_manuals_synchrono_adding_new_agent_synagent_interface", "label": "SynAgent virtual interface", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/adding_new_agent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_synchrono_adding_new_agent_synmessage_conversion", "label": "SynMessage ConvertFrom/ToFlatBuffers", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/adding_new_agent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_synchrono_adding_new_agent_synmessagefactory", "label": "SynMessageFactory", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/adding_new_agent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses dynamic dispatch on the FlatBuffer message_type enum, so every new message type needs another else-if branch - a known extension cost of the factory design."}, {"id": "doxygen_documentation_manuals_synchrono_adding_new_agent_agentfactory", "label": "AgentFactory", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/adding_new_agent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses dynamic_pointer_cast on the incoming description to build a zombie agent from another rank; the description must be fully applied (meshes, propeller count) or the zombie is malformed."}], "edges": [{"source": "doxygen_documentation_manuals_synchrono_adding_new_agent_adding_new_agent", "target": "doxygen_documentation_manuals_synchrono_adding_new_agent_flatc_compiler", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxyg