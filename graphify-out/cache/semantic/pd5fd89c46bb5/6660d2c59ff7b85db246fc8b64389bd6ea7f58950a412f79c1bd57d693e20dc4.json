s_multicore_chronomulticore_smc_contact_formulation", "label": "Smooth (Penalty) Contact Formulation (SMC)", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/multicore/chronoMULTICORE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Penalty-based alternative to NSC: contact forces come from an interpenetration-dependent spring model, so no complementarity solve is needed but the time step must be small enough for the stiff contact springs."}, {"id": "doxygen_documentation_tutorials_multicore_chronomulticore_custom_contact_callbacks", "label": "Custom Contact Reporting Callbacks", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/multicore/chronoMULTICORE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_tutorials_multicore_chronomulticore_particle_container_3dof", "label": "3-DOF Homogeneous Spherical Particle Container", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/multicore/chronoMULTICORE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Container of identical spheres carrying only 3 translational DOFs each; dropping rotational states shrinks the state vector and the solver cost for very large particle counts, at the price of not resolving particle spin."}], "edges": [{"source": "doxygen_documentation_tutorials_multicore_chronomulticore_chrono_multicore_module_tutorials", "target": "doxygen_documentation_tutorials_multicore_chronomulticore_multicore_module", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/multicore/chronoMULTICORE.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_multicore_chronomulticore_chrono_multicore_module_tutorials", "targe