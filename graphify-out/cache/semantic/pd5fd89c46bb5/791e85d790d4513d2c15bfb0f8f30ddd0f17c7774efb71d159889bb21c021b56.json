{"nodes": [{"id": "doxygen_documentation_manuals_parsers_yaml_schema_mbs_simulation_mbs_simulation_schema", "label": "MBS simulation YAML schema", "file_type": "document", "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_mbs_simulation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "type must be MBS; binds a model file and a solver file by relative path and adds optional simulation, output and visualization blocks."}, {"id": "doxygen_documentation_manuals_parsers_yaml_schema_mbs_simulation_num_threads", "label": "num_threads (chrono/collision/eigen/pardiso)", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_mbs_simulation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Thread counts are set per parallel component rather than globally, because Chrono, collision detection, Eigen and PARDISO scale differently; the pardiso entry is honored only when the solver file selects the PARDISO solver type."}, {"id": "doxygen_documentation_manuals_parsers_yaml_schema_mbs_simulation_visualization_type", "label": "MBS visualization type gate", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_mbs_simulation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rendering is enabled only when the visualization key exists AND its type is other than NONE, so omitting the key and writing type: NONE are deliberately equivalent."}, {"id": "doxygen_documentation_manuals_parsers_yaml_schema_mbs_simulation_enforce_realtime", "label": "enforce_realtime and end_time", "file_type": "concept", "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_mbs_simulation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rat