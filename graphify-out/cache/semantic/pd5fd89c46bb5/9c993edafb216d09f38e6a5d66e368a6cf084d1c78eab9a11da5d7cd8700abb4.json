{"nodes": [{"id": "doxygen_documentation_tutorials_tutorials_tutorials_root", "label": "Chrono Tutorials Root", "file_type": "document", "source_file": "doxygen/documentation/tutorials/tutorials.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_tutorials_tutorials_eigen_alignment_requirement", "label": "Fixed-size Vectorizable Eigen Member Alignment", "file_type": "rationale", "source_file": "doxygen/documentation/tutorials/tutorials.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Many Chrono classes hold fixed-size vectorizable Eigen members, so they overload operator new (via an Eigen macro) to hand back 16-byte-aligned pointers. STL containers of such classes need an aligned allocator such as Eigen::aligned_allocator."}, {"id": "doxygen_documentation_tutorials_tutorials_chrono_types_make_shared", "label": "chrono_types::make_shared", "file_type": "rationale", "source_file": "doxygen/documentation/tutorials/tutorials.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "std::make_shared uses placement new and therefore bypasses the aligned operator new that Eigen-carrying classes rely on. Chrono provides a drop-in replacement that infers whether std::make_shared is safe and otherwise builds the shared pointer through an alignment-preserving path, so user code should always use chrono_types::make_shared."}], "edges": [{"source": "doxygen_documentation_tutorials_tutorials_tutorials_root", "target": "doxygen_documentation_tutorials_vehicle_chronovehicle_chrono_vehicle_tutorials", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/tutorials.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_tutorials_tutorials_root", "target": "d