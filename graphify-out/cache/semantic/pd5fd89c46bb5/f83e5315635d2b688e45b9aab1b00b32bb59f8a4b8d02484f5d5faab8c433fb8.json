{"nodes": [{"id": "doxygen_documentation_manuals_synchrono_terrain_synchronization_scm_terrain_sync", "label": "SCM Deformable Terrain Synchronization", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/terrain_synchronization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets multiple vehicles drive off-road and interact with ruts and deformation created by each other, which is otherwise impossible once dynamics are split across nodes."}, {"id": "doxygen_documentation_manuals_synchrono_terrain_synchronization_no_soil_history", "label": "Vertical-Only, History-Free Soil State", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/synchrono/terrain_synchronization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SCM soil is an integer grid where only deformed nodes are kept in a hash map, nodes displace only vertically, and there is no soil history because vertical displacement captures the full state. That is precisely why a list of (int x, int y, double z) triples is a complete synchronization payload."}, {"id": "doxygen_documentation_manuals_synchrono_terrain_synchronization_synscmterrainagent", "label": "SynSCMTerrainAgent", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/terrain_synchronization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The terrain's per-step deformed-node list is reset every physics step but messages go out only per heartbeat, so the agent merges deformed nodes into an owned map each step and clears it once per heartbeat."}, {"id": "doxygen_documentation_manuals_synchrono_terrain_synchronization_setmodifiednodes", "label": "SCMTerrain::SetModifiedNodes", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/terrain_synchronization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_synchrono_terrain_synchronization_terrain_sync_caveats", "label": "Terrain Synchronization Caveats", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/synchrono/terrain_synchronization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing prevents ranks from being configured with mismatched soil properties or dimensions, and if two vehicles modify the same node in one heartbeat the surviving update is random. The latter is judged acceptable because only nodes under a vehicle's wheels are modified, so it is no more restrictive than the existing no-collision requirement."}], "edges": [{"source": "doxygen_documentation_manuals_synchrono_terrain_synchronization_no_soil_history", "target": "doxygen_documentation_manuals_synchrono_terrain_synchronization_scm_terrain_sync", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/synchrono/terrain_synchronization.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_synchrono_terrain_synchronization_synscmterrainagent", "target": "doxygen_documentation_manuals_synchrono_terrain_synchronization_scm_terrain_sync", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/synchrono/terrain_synchronization.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_synchrono_terrain_synchronization_synscmterrainagent", "target": "doxygen_documentation_manuals_synchrono_terrain_synchronization_setmodifiednodes", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/synchrono/terrain_synchronization.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_synchrono_terrain_synchronization_synscmterrainagent", "target": "doxygen_documentation_manuals_synchrono_synchrono_overview_heartbeat", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/synchrono/terrain_synchronization.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_synchrono_terrain_synchronization_terrain_sync_caveats", "target": "doxygen_documentation_manuals_synchrono_terrain_synchronization_scm_terrain_sync", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/synchrono/terrain_synchronization.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_synchrono_terrain_synchronization_terrain_sync_caveats", "target": "doxygen_documentation_manuals_synchrono_vehicle_synchronization_space_coherent_not_interactive", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/synchrono/terrain_synchronization.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_synchrono_terrain_synchronization_synscmterrainagent", "target": "doxygen_documentation_manuals_synchrono_adding_new_agent_synagent", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "doxygen/documentation/manuals/synchrono/terrain_synchronization.md", "source_location": null, "weight": 1.0}], "hyperedges": []}