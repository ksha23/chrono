{"nodes": [{"id": "doxygen_documentation_manuals_synchrono_vehicle_synchronization_synwheeledvehicleagent", "label": "SynWheeledVehicleAgent", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/vehicle_synchronization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A thin wrapper holding a pointer to a ChWheeledVehicle; keeping it thin means SynChrono adds no dynamics of its own and only queries the vehicle for component poses."}, {"id": "doxygen_documentation_manuals_synchrono_vehicle_synchronization_syntrackedvehicleagent", "label": "SynTrackedVehicleAgent", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/vehicle_synchronization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Thin wrapper over ChTrackedVehicle; its state message is simply a long list of poses for track shoes, sprockets, idlers and road wheels."}, {"id": "doxygen_documentation_manuals_synchrono_vehicle_synchronization_description_message", "label": "Vehicle Description Message", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/vehicle_synchronization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sent during the initial handshake. Visual files are strings resolved relative to the Chrono data directory, and component counts (num_wheels, or num_track_shoes/sprockets/idlers/road_wheels) are transmitted to support configurations beyond the four-wheel default. Tracked vehicles send left and right files separately because the two sides may use different meshes."}, {"id": "doxygen_documentation_manuals_synchrono_vehicle_synchronization_state_message", "label": "Vehicle State Message", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/vehicle_synchronization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Carries only time plus chassis and per-component poses. Wheels and tires share one pose, and zombie bodies are created at the origin at initialization and merely repositioned as state messages arrive."}, {"id": "doxygen_documentation_manuals_synchrono_vehicle_synchronization_space_coherent_not_interactive", "label": "Space Coherent, Not Space Interactive", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/synchrono/vehicle_synchronization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only position and orientation are shared, never contact forces, so agents have knowledge of each other but cannot physically interact. This is the concrete expression of SynChrono's weak-coupling assumption and is what makes 10s to 100s of vehicles scalable."}], "edges": [{"source": "doxygen_documentation_manuals_synchrono_vehicle_synchronization_synwheeledvehicleagent", "target": "doxygen_documentation_manuals_synchrono_adding_new_agent_synagent", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/synchrono/vehicle_synchronization.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_synchrono_vehicle_synchronization_syntrackedvehicleagent", "target": "doxygen_documentation_manuals_synchrono_adding_new_agent_synagent", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/synchrono/vehicle_synchronization.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_synchrono_vehicle_synchronization_synwheeledvehicleagent", "target": "doxygen_documentation_manuals_synchrono_vehicle_synchronization_description_message", "relation": "shares_data_with", "confidence": "EXTRACTED", "c