{"nodes": [{"id": "doxygen_documentation_manuals_vehicle_vehicle_models_vehicle_models", "label": "Vehicle models library", "file_type": "document", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_models_hmmwv", "label": "HMMWV model", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "M966 troop carrier: double wishbone on both axles, all wheels driven, three-gear automatic with torque converter, Pitman-arm steering; accepts every Chrono tire model."}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_models_feda", "label": "FEDA model", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FED ALPHA concept vehicle, 4WD, double wishbone front and rear with anti-roll bar and Pitman-arm steering; only Pacejka 2002 and rigid tires implemented."}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_models_sedan", "label": "Sedan model", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_models_citybus", "label": "Citybus model", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Leaf-sprung solid axles are modeled functionally, so no leaf blades appear; demonstrates toebar (rotary arm) steering and double wheels."}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_models_fmtv", "label": "FMTV (LMTV / MTV) models", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both variants model torsional compliance between cabin and cargo; the 6x4 MTV adds a balancer-beam rear bogie."}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_models_man_kat1", "label": "MAN Kat 1 truck family (5t / 7t / 10t)", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Coil-sprung link-guided solid axles give very high wheel travel; the box-shaped frame has almost no torsion in the real truck, which justifies the rigid-chassis modeling choice."}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_models_uaz", "label": "UAZ 452 and UAZ 469 models", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The 469 shares axle and engine components with the 452, differing mainly in steering configuration."}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_models_gator", "label": "Gator model", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "John Deere electric utility vehicle instrumented for autonomous driving - single wishbone front, rigid rear axle, rear-only brakes, electric motor through a differential."}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_models_kraz", "label": "KRAZ semi-trailer model", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_models_generic_wheeled", "label": "Generic wheeled vehicle sandbox", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A testbed for templates and settings; its concrete subsystems are not necessarily mutually consistent because it represents no real vehicle."}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_models_m113", "label": "M113 tracked model", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ten road wheels, two sprockets, two idlers; configurable single- or double-pin track (rubber band track in development), track tension set through the idler tensioning suspension, bogie/torsion-bar road wheels."}, {"id": "doxygen_documentation_manuals_vehicle_vehicle_models_marder", "label": "Marder tracked model", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/vehicle_models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built only from public data and literature; although the real vehicle uses double-pin tracks the Chrono model currently implements a single-pin track."}], "edges": [{"source": "doxygen_documentation_manuals_vehicle_vehicle_models_vehicle_models", "target": "doxygen_documentation_manuals_vehicle_vehicle_models_hmmwv", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/vehicle/vehicle_models.md", "source_location": n