{"nodes": [{"id": "doxygen_documentation_manuals_sensor_sensor_overview_chrono_sensor", "label": "Chrono::Sensor", "file_type": "document", "source_file": "doxygen/documentation/manuals/sensor/sensor_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sensors attach to ChBody objects, which is what makes the module compatible with core rigid-body simulation, Chrono::Vehicle and SCMTerrain; FSI problems are explicitly not yet supported."}, {"id": "doxygen_documentation_manuals_sensor_sensor_overview_chsensormanager", "label": "ChSensorManager", "file_type": "concept", "source_file": "doxygen/documentation/manuals/sensor/sensor_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owns the scene (lights, ambient, background) and the sensor set; its Update() is called once per simulation loop iteration alongside DoStepDynamics."}, {"id": "doxygen_documentation_manuals_sensor_sensor_overview_filter_graph", "label": "Sensor Filter Graph", "file_type": "concept", "source_file": "doxygen/documentation/manuals/sensor/sensor_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each sensor carries an extensible, ordered filter list so users can customize the computation pipeline for specific sensor attributes or data formats without modifying the sensor class itself."}, {"id": "doxygen_documentation_manuals_sensor_sensor_overview_sensor_thread_separation", "label": "Separate Data-Curation Thread", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/sensor/sensor_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dynamics run around 1 kHz while sensors run at 10-100 Hz, so a separate thread manages data curation instead of stalling the physics loop at every sensor update."}, {"id": "doxygen_documentation_manuals_sensor_sensor_overview_multi_gpu_render_threads", "label": "Multi-GPU Render Threads", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/sensor/sensor_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Multiple render threads, each driving a separate GPU for a group of sensors, are provided for scenarios with many agents and numerous sensors running at various update frequencies."}, {"id": "doxygen_documentation_manuals_sensor_sensor_overview_reproducible_stochastic_sensors", "label": "Reproducible Stochastic Sensors", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/sensor/sensor_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Noise models and environment-lighting/global-illumination sampling draw from per-pixel RNGs seeded from the wall clock by default. That is the right default for a simulation but makes byte-exact run comparison impossible, so a fixed base seed can be pinned and later cleared."}, {"id": "doxygen_documentation_manuals_sensor_sensor_overview_setrandomseed", "label": "ChSensorManager::SetRandomSeed", "file_type": "concept", "source_file": "doxygen/documentation/manuals/sensor/sensor_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Must be called BEFORE adding sensors, because the seed is read when a sensor's filters initialize inside AddSensor; ClearRandomSeed restores clock-based seeding."}, {"id": "doxygen_documentation_manuals_sensor_sensor_overview_registration_order_contract", "label": "AddSensor Registration Order Contract", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/sensor/sensor_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each sensor's random streams derive from its AddSensor ordinal, so adding, removing or reordering sensors changes the numbers drawn by the OTHER sensors even under a fixed seed. Comparing two runs therefore requires building the scene identically in both."}, {"id": "doxygen_documentation_manuals_sensor_sensor_overview_per_buffer_random_stream", "label": "Per-Buffer Random Stream Derivation", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/sensor/sensor_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The pinned value is a base seed, not the cuRAND seed: each random-number buffer derives a distinct seed from the base plus sensor, filter and purpose identity, so two cameras, or a camera and a lidar, never draw the same sequence. This independence matters for sensor fusion studies."}, {"id": "doxygen_documentation_manuals_sensor_sensor_overview_sensor_json_loading", "label": "Sensor::CreateFromJSON", "file_type": "concept", "source_file": "doxygen/documentation/manuals/sensor/sensor_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_sensor_sensor_overview_iso_reference_frame", "label": "ISO Sensor Reference Frame (Z-up, X-forward, Y-left)", "file_type": "concept", "source_file": "doxygen/documentation/manuals/sensor/sensor_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sensors default to the vehicle ISO frame so sensor poses compose naturally with Chrono::Vehicle frames; for an RGB camera this puts z vertical in the image plane, y left, and x into the plane, and for lidar x along the zero-angle ray."}], "edges": [{"source": "doxygen_documentation_manuals_sensor_sensor_overview_chrono_sensor", "target": "doxygen_documentation_manuals_sensor_sensor_overview_chsensormanager", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/sensor/sensor_overview.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_sensor_sensor_overview_chrono_sensor", "target": "doxygen_documentation_manuals_sensor_sensor_overview_filter_graph", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/sensor/sensor_overview.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_sensor_sensor_overview_sensor_thread_separation", "target": "doxygen_documentation_manuals_sensor_sensor_overview_chsensormanager", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/sensor/sensor_overview.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_sensor_sensor_overview_multi_gpu_render_threads", "target": "doxygen_documentation_manuals_sensor_sensor_overview_chsensormanager", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/sensor/sensor_overview.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_sensor_sensor_overview_setrandomseed", "target": "doxygen_documentation_manuals_sensor_sensor_overview_reproducible_stochastic_sensors", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/sensor/sensor_overview.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_sensor_sensor_overview_registration_order_contract", "target": "doxygen_documentation_manuals_sensor_sensor_overview_setrandomseed", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/sensor/sensor_overview.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_sensor_sensor_overview_per_buffer_random_stream", "target": "doxygen_documentation_manuals_sensor_sensor_overview_setrandomseed", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/sensor/sensor_overview.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_sensor_sensor_overview_setrandomseed", "target": "doxygen_documentation_manuals_sensor_sensor_overview_chsensormanager", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/sensor/sensor_overview.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_sensor_sensor_overview_per_buffer_random_stream", "target": "doxygen_documentation_manuals_sensor_sensor_overview_filter_graph", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/sensor/sensor_overview.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_sensor_sensor_overview_sensor_json_loading", "target": "doxygen_documentation_manuals_sensor_sensor_overview_chsensormanager", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/sensor/sensor_overview.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_sensor_sensor_overview_sensor_json_loading", "target": "doxygen_documentation_manuals_parsers_manual_parsers_yaml_parsers", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "doxygen/documentation/manuals/sensor/sensor_overview.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_sensor_sensor_overview_sensor_json_loading", "target": "doxyg