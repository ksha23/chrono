{"nodes": [{"id": "src_chrono_cascade_cmakelists_chrono_cascade_target", "label": "Chrono_cascade Library Target", "file_type": "code", "source_file": "src/chrono_cascade/CMakeLists.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Off by default (CH_ENABLE_MODULE_CASCADE); links Chrono_core PRIVATE and the OCCT libraries PUBLIC, and self-disables by forcing the option back OFF if OpenCASCADE is not found. Platform defines WNT (Windows) and HAVE_IOSTREAM/HAVE_LIMITS_H (Unix) are what OpenCASCADE headers expect."}, {"id": "src_chrono_cascade_cmakelists_occt_libs", "label": "OCCT_LIBS Link List", "file_type": "code", "source_file": "src/chrono_cascade/CMakeLists.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An explicit hand-maintained list of OpenCASCADE toolkits (TKernel, TKMath, TKBRep, TKDESTEP, TKXCAF...) is linked PUBLIC instead of relying on an OpenCASCADE imported-target closure; the include directory is added SYSTEM to silence third-party warnings."}, {"id": "src_chrono_cascade_cmakelists_cascade_irrlicht_optional_dependency", "label": "Optional Irrlicht Dependency of Cascade", "file_type": "code", "source_file": "src/chrono_cascade/CMakeLists.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ChCascadeIrrMeshTools is compiled into the module and Chrono_irrlicht is linked only when the IRRLICHT module is enabled; the choice is also published upward through DEPENDENCIES_CASCADE in PARENT_SCOPE."}], "edges": [{"source": "src_chrono_cascade_cmakelists_chrono_cascade_target", "target": "src_chrono_cascade_cmakelists_occt_libs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/chrono_cascade/CMakeLists.txt", "source_location": null, "weight": 1.0}, {"source": "src_chrono_cascade_cmakelists_chrono_ca