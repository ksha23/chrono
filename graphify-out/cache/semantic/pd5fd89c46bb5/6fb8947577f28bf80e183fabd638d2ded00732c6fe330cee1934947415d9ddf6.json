{"nodes": [{"id": "doxygen_documentation_manuals_parsers_yaml_schema_fsisph_simulation_sph_simulation_schema", "label": "FSI-SPH simulation YAML schema", "file_type": "document", "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_fsisph_simulation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Binds an SPH model file to an SPH solver file and owns fluid-phase output and visualization; camera and general rendering deliberately belong to the parent FSI simulation file instead."}, {"id": "doxygen_documentation_manuals_parsers_yaml_schema_fsisph_simulation_particle_coloring", "label": "SPH particle color_map", "file_type": "concept", "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_fsisph_simulation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Colors particles by HEIGHT/VELOCITY/DENSITY/PRESSURE over an explicit min-max range; up applies only to HEIGHT and bimodal is required for PRESSURE because pressure is naturally two-sided about zero."}, {"id": "doxygen_documentation_manuals_parsers_yaml_schema_fsisph_simulation_marker_visibility", "label": "Half-space marker visibility", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_fsisph_simulation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hides markers by testing their position against a set of planes with ALL or ANY combination, giving cut-away views into a dense particle field without changing the simulation."}, {"id": "doxygen_documentation_manuals_parsers_yaml_schema_fsisph_simulation_splashsurf", "label": "splashsurf fluid surface reconstruction", "file_type": "concept", "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_fsisph_simulation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Marching-cubes iso-surface over the particle field; smoothing_length and cube_size are expressed in multiples of the particle radius and surface_threshold in multiples of rest density, so defaults stay resolution-independent."}, {"id": "doxygen_documentation_manuals_parsers_yaml_schema_fsisph_simulation_bce_markers", "label": "BCE marker rendering toggles", "file_type": "concept", "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_fsisph_simulation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "doxygen_documentation_manuals_parsers_yaml_schema_fsisph_simulation_sph_simulation_schema", "target": "doxygen_documentation_manuals_parsers_yaml_schema_fsisph_model_sph_model_schema", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_fsisph_simulation.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_parsers_yaml_schema_fsisph_simulation_sph_simulation_schema", "target": "doxygen_documentation_manuals_parsers_yaml_schema_fsisph_solver_sph_solver_schema", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_fsisph_simulation.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_parsers_yaml_schema_fsisph_simulation_sph_simulation_schema", "target": "doxygen_documentation_manuals_parsers_yaml_schema_fsisph_simulation_particle_coloring", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/parsers/YAML_schema_fsisph_simulation.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_parsers_yaml_schema_fsisph_simulation_sph_simulation_schema", "target": "doxygen_documentat