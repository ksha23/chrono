{"nodes": [{"id": "doxygen_documentation_manuals_pychrono_pychrono_installation_conda_package", "label": "PyChrono conda package install", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/pychrono/pychrono_installation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recommended route: precompiled modules for Linux, Windows and macOS and several Python 3 versions, installed in one step into a dedicated conda environment. Packages built from a release carry the 'release' label and those from the development branch the 'main' label. Caveat: cascade, vsg3d and ROS modules are not yet in the conda build."}, {"id": "doxygen_documentation_manuals_pychrono_pychrono_installation_build_from_source", "label": "Building PyChrono from the C++ API", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/pychrono/pychrono_installation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "More complicated but the only way to get the most up-to-date PyChrono and the modules missing from conda. Requires Python 3.2 or greater, and PYTHONPATH must be extended with the bin/ directory of the Chrono build tree."}, {"id": "doxygen_documentation_manuals_pychrono_pychrono_installation_amd_rocm", "label": "AMD GPU / ROCm PyChrono workflow", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/pychrono/pychrono_installation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CPU PyChrono can be built without the NVIDIA CUDA toolkit alongside a PyTorch ROCm stack on AMD Instinct or Radeon GPUs; docs/README_AMD_GPU.md covers the CPU vs HIP/FSI workflows, Eigen3 and SWIG prerequisites, and ROCR_VISIBLE_DEVICES on multi-GPU hosts."}], "edges": [{"source": "doxygen_documentation_manuals_pychrono_pychrono_installation_conda_package", "target": "doxygen_documentation_manuals_pychrono_pychrono_installation_build_from_source", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/pychrono/pychrono_installation.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_pychrono_pychrono_installation_conda_package", "target": "doxygen_documentation_manuals_ros_ros_overview_chrono_ros", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/pychrono/pychrono_installation.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_pychrono_pychrono_installation_build_from_source", "target": "doxygen_documentation_manuals_pychrono_pychrono_introduction_pychrono", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/pychrono/pychrono_installation.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_pychrono_pychrono_installation_amd_rocm", "target": "doxygen_documentation_manuals_pychrono_pychrono_installation_build_from_source", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/pychrono/pychrono_installation.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_pychrono_pychrono_installation_build_from_source", "target": "doxygen_documentation_manuals_pychrono_pychrono_reference_swig", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "doxygen/documentation/manuals/pychrono/pychrono_installation.md", "source_location": null, "weight": 1.0}], "hyperedges": []}