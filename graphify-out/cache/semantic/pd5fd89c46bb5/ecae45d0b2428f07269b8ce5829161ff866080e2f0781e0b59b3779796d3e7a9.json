{"nodes": [{"id": "doxygen_documentation_manuals_synchrono_state_synchronization_state_synchronization", "label": "State Synchronization with DDS and MPI", "file_type": "document", "source_file": "doxygen/documentation/manuals/synchrono/state_synchronization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_synchrono_state_synchronization_mpi_backend", "label": "MPI synchronization backend", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/state_synchronization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MPI is the SynChrono default because the runtime handles task launch and transport selection (shared memory, InfiniBand, TCP) and is ubiquitous on clusters. Each rank owns one ChSystem."}, {"id": "doxygen_documentation_manuals_synchrono_state_synchronization_allgather_two_phase", "label": "Two-phase MPI_Allgather / MPI_Allgatherv exchange", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/synchrono/state_synchronization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vehicles on rigid terrain send fixed-length messages, but deformable terrain does not, so ranks first Allgather message lengths and then run a variable-length Allgatherv to collect the data."}, {"id": "doxygen_documentation_manuals_synchrono_state_synchronization_dds_backend", "label": "DDS synchronization backend", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/state_synchronization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DDS uses Real-Time Publish-Subscribe topics rather than rank-to-rank calls; FastDDS was chosen over RTI Connext to keep with Chrono's open-source philosophy. Preferred outside clusters where MPI is less available and UDP flexibility helps."}, {"id": "doxygen_documentation_manuals_synchrono_state_synchronization_synddscommunicator", "label": "SynDDSCommunicator", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/state_synchronization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_synchrono_state_synchronization_synchronomanager", "label": "SynChronoManager", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/state_synchronization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Holds a handle to exactly one SynCommunicator, keeping the SynChrono-level API independent of the transport."}, {"id": "doxygen_documentation_manuals_synchrono_state_synchronization_dds_wrapper_classes", "label": "SynDDSPublisher / Subscriber / Topic wrappers", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/state_synchronization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Thin wrappers keep SynChrono's DDS usage as minimal as possible - one topic per agent, with data readers and writers handling each agent pair."}], "edges": [{"source": "doxygen_documentation_manuals_synchrono_state_synchronization_state_synchronization", "target": "doxygen_documentation_manuals_synchrono_state_synchronization_mpi_backend", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/synchrono/state_synchronization.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_synchrono_state_synchronization_state_synchronization", "target": "doxygen_documentation_manuals_synchrono_state_synchronization_dds_backend", "relation": "references", "confidence": 