{"nodes": [{"id": "doxygen_documentation_manuals_solidworks_manual_chrono_solidworks_chrono_solidworks", "label": "Chrono::SolidWorks add-in", "file_type": "document", "source_file": "doxygen/documentation/manuals/solidworks/manual_chrono_solidworks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exports SolidWorks assemblies, subassemblies and parts with materials, mates and collision shapes into Chrono; each SubAssembly is one rigid body unless flagged Flexible."}, {"id": "doxygen_documentation_manuals_solidworks_manual_chrono_solidworks_export_targets", "label": "Python / C++ / JSON export targets", "file_type": "concept", "source_file": "doxygen/documentation/manuals/solidworks/manual_chrono_solidworks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Python output runs under PyChrono or is parsed in C++ via Chrono::Parsers; C++ output must be compiled with the user project (limiting but useful for testing); JSON output is deserialized through Chrono serialization."}, {"id": "doxygen_documentation_manuals_solidworks_manual_chrono_solidworks_collision_shape_export", "label": "Collision shape specification on export", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/solidworks/manual_chrono_solidworks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Collision is the most expensive part of a simulation, so only explicitly flagged solid bodies collide. Wrapping complex bodies in primitives is preferred (their material becomes Air); mesh shapes use a sphere sweep whose radius trades robustness against accuracy."}, {"id": "doxygen_documentation_manuals_solidworks_manual_chrono_solidworks_motor_placeholder", "label": "Coordinate-system motor placeholder", "file_type": "concept", "source_file": "doxygen/documentation/manuals/solidworks/manual_chrono_solidworks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A top-level Coordinate System plus a custom property acts as the placeholder where a ChLinkMotor is instantiated at export; the property is transparent to SolidWorks installs without the add-in."}], "edges": [{"source": "doxygen_documentation_manuals_solidworks_manual_chrono_solidworks_chrono_solidworks", "target": "doxygen_documentation_manuals_solidworks_manual_chrono_solidworks_export_targets", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/solidworks/manual_chrono_solidworks.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_solidworks_manual_chrono_solidworks_chrono_solidworks", "target": "doxygen_documentation_manuals_solidworks_manual_chrono_solidworks_collision_shape_export", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/solidworks/manual_chrono_solidworks.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_solidworks_manual_chrono_solidworks_chrono_solidworks", "target": "doxygen_documentation_manuals_solidworks_manual_chrono_solidworks_motor_placeholder", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/solidworks/manual_chrono_solidworks.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_solidworks_manual_chrono_solidworks_collision_shape_export", "target": "doxygen_documentation_manuals_vehicle_vehicle_terrain_rigidterrain", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "doxygen/documentation/manuals/solidworks/manual_chrono_solidworks.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation