{"nodes": [{"id": "doxygen_documentation_tutorials_vehicle_chronovehicle_chrono_vehicle_tutorials", "label": "Chrono VEHICLE Module Tutorials", "file_type": "document", "source_file": "doxygen/documentation/tutorials/vehicle/chronoVehicle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_tutorials_vehicle_chronovehicle_template_based_vehicle_framework", "label": "Template-based Vehicle Framework", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/vehicle/chronoVehicle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wheeled and tracked vehicles are built from parameterized templates of vehicles and subsystems, so a concrete vehicle is a parameter set rather than new code; extension demos (articulated chassis, tractor-trailer) show subclassing the framework."}, {"id": "doxygen_documentation_tutorials_vehicle_chronovehicle_vehicle_models_library", "label": "Pre-defined Vehicle Models Library", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/vehicle/chronoVehicle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ships HMMWV, Sedan, Citybus, UAZ, M-role, MAN (5t/7t/10t), Kraz, FMTV, Gator and RC wheeled models plus M113 and Marder tracked models as a separate library alongside the main VEHICLE library."}, {"id": "doxygen_documentation_tutorials_vehicle_chronovehicle_scm_deformable_terrain", "label": "SCM Deformable Terrain (Bekker-Wong)", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/vehicle/chronoVehicle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_tutorials_vehicle_chronovehicle_granular_terrain", "label": "Granular Terrain with Moving Patch", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/vehicle/chronoVehicle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Granular terrain demos run through the MULTICORE module, and the moving-patch feature limits the simulated granular region to the neighborhood of the vehicle."}, {"id": "doxygen_documentation_tutorials_vehicle_chronovehicle_json_vehicle_specification", "label": "JSON Vehicle Specification", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/vehicle/chronoVehicle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both wheeled and tracked vehicles can be defined entirely through JSON specification files, giving the same model as the compiled-in variant without writing code."}, {"id": "doxygen_documentation_tutorials_vehicle_chronovehicle_test_rigs", "label": "Vehicle Test Rigs (suspension, tire, track assembly)", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/vehicle/chronoVehicle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Subsystems can be exercised in isolation on dedicated rigs rather than only inside a full vehicle."}], "edges": [{"source": "doxygen_documentation_tutorials_vehicle_chronovehicle_chrono_vehicle_tutorials", "target": "doxygen_documentation_tutorials_vehicle_chronovehicle_template_based_vehicle_framework", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/vehicle/chronoVehicle.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_vehicle_chronovehicle_vehicle_models_library", "target": "doxygen_documentation_tutorials_vehicle_chronovehicle_template_based_vehicle_framework", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "do