xygen_documentation_manuals_synchrono_synchrono_overview_synchrono", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/ros/sim_to_real.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_ros_sim_to_real_multi_sim_ros_graph", "target": "doxygen_documentation_manuals_synchrono_synchrono_overview_heartbeat", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "doxygen/documentation/manuals/ros/sim_to_real.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_ros_sim_to_real_lock_step_stepping", "target": "doxygen_documentation_manuals_synchrono_synchrono_overview_heartbeat", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "doxygen/documentation/manuals/ros/sim_to_real.md", "source_location": null, "weight": 1.0}], "hyperedges": []}