{"nodes": [{"id": "doxygen_documentation_manuals_ros_sim_to_real_ros_sim_to_real", "label": "Time Synchronization and Sim-to-Real Best Practices", "file_type": "document", "source_file": "doxygen/documentation/manuals/ros/sim_to_real.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_ros_sim_to_real_chrosclockhandler", "label": "ChROSClockHandler", "file_type": "concept", "source_file": "doxygen/documentation/manuals/ros/sim_to_real.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Publishes simulation time on /clock so the simulation, not the wall clock, is the master clock for the whole ROS graph."}, {"id": "doxygen_documentation_manuals_ros_sim_to_real_use_sim_time", "label": "use_sim_time parameter", "file_type": "concept", "source_file": "doxygen/documentation/manuals/ros/sim_to_real.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Set true in simulation and false on hardware so the same node code runs in both; a node with use_sim_time true and no /clock publisher blocks forever waiting for time."}, {"id": "doxygen_documentation_manuals_ros_sim_to_real_fixed_timestep_real_time_factor", "label": "Fixed timestep and real-time factor", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/ros/sim_to_real.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Simulation time is decoupled from wall time: the loop runs as fast as it can or is throttled to real time with ChRealtimeStepTimer. This matches the standard physics/robotics convention (Gazebo max-step-size and real-time-factor)."}, {"id": "doxygen_documentation_manuals_ros_sim_to_real_ros_clock_timer", "label": "ROS-clock timer vs create_wall_timer", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/ros/sim_to_real.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "create_wall_timer always uses the steady clock and ignores use_sim_time, so a control loop built on it runs at wall-clock rate regardless of simulation time - the most common source of sim/real timing mismatch."}, {"id": "doxygen_documentation_manuals_ros_sim_to_real_reproducibility", "label": "Behavioral vs bit reproducibility", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/ros/sim_to_real.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The simulation does not block on ROS, so OS scheduling and transport jitter shift command arrival by a step or two. Behavioral reproducibility is enough for tuning, validation and HIL; bit-exactness requires lock-step gating or running control in-process as a C++ ChROSHandler."}, {"id": "doxygen_documentation_manuals_ros_sim_to_real_lock_step_stepping", "label": "Lock-step (synchronous) stepping", "file_type": "concept", "source_file": "doxygen/documentation/manuals/ros/sim_to_real.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gating each step on the controller reply makes the closed loop bit-reproducible, but freezes the world while the controller computes so real compute latency is hidden - good for training and regression, wrong for latency-sensitive sim-to-real validation."}, {"id": "doxygen_documentation_manuals_ros_sim_to_real_waitformessage", "label": "ChROSSubscription::WaitForMessage", "file_type": "concept", "source_file": "doxygen/documentation/manuals/ros/sim_to_real.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_ros_sim_to_real_compute_latency_causality", "label": "Compute latency and causality", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/ros/sim_to_real.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On hardware, control and CV inference consume wall time while the world moves. Real-time-paced simulation reproduces that causally; lock-stepping is deterministic but optimistic."}, {"id": "doxygen_documentation_manuals_ros_sim_to_real_multi_sim_ros_graph", "label": "Multiple simulations in one ROS graph", "file_type": "concept", "source_file": "doxygen/documentation/manuals/ros/sim_to_real.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only one participant may publish /clock; followers subscribe and advance DoStepDynamics only up to the received time. This coordinates time only - for large-scale distributed multi-agent co-simulation SynChrono is the purpose-built tool."}, {"id": "doxygen_documentation_manuals_ros_sim_to_real_shared_tf", "label": "Shared /tf with unique frame ids", "file_type": "concept", "source_file": "doxygen/documentation/manuals/ros/sim_to_real.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "/tf is multi-publisher by convention and tf2 aggregates by frame pair, so namespaced frame ids (robot1/base_link) keep trees from colliding."}], "edges": [{"source": "doxygen_documentation_manuals_ros_sim_to_real_ros_sim_to_real", "target": "doxygen_documentation_manuals_ros_sim_to_real_chrosclockhandler", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/ros/sim_to_real.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_ros_sim_to_real_ros_sim_to_real", "target": "doxygen_documentation_manuals_ros_sim_to_real_use_sim_time", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/ros/sim_to_real.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_ros_sim_to_real_chrosclockhandler", "target": "doxygen_documentation_manuals_ros_sim_to_real_use_sim_time", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/ros/sim_to_real.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_ros_sim_to_real_ros_sim_to_real", "target": "doxygen_documentation_manuals_ros_sim_to_real_fixed_timestep_real_time_factor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/ros/sim_to_real.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_ros_sim_to_real_ros_clock_timer", "target": "doxygen_documentation_manuals_ros_sim_to_real_use_sim_time", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/ros/sim_to_real.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_ros_sim_to_real_ros_sim_to_real", "target": "doxygen_documentation_manuals_ros_sim_to_real_reproducibility", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/ros/sim_to_real.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_ros_sim_to_real_reproducibility", "target": "doxygen_documentation_manuals_ros_sim_to_real_lock_step_stepping", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/ros/sim_to_real.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_ros_sim_to_real_lock_step_stepping", "target": "doxygen_documentation_manuals_ros_sim_to_real_waitformessage", "relation"