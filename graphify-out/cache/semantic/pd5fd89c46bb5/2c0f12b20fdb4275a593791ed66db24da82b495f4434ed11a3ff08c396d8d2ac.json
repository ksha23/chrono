{"nodes": [{"id": "doxygen_documentation_manuals_chrono_simulation_system_simulation_system", "label": "Simulation system (ChSystem manual)", "file_type": "document", "source_file": "doxygen/documentation/manuals/chrono/simulation_system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_chrono_simulation_system_chsystem", "label": "ChSystem (abstract)", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/simulation_system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cornerstone container for bodies, links, meshes, integrator type and tolerances; abstract so a contact method must be chosen."}, {"id": "doxygen_documentation_manuals_chrono_simulation_system_chsystemnsc", "label": "ChSystemNSC", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/simulation_system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Complementarity solver for non-smooth contacts; efficient even with large time steps."}, {"id": "doxygen_documentation_manuals_chrono_simulation_system_chsystemsmc", "label": "ChSystemSMC", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/simulation_system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Penalty (deformable) contacts. Equivalent to NSC when no contacts exist at all."}, {"id": "doxygen_documentation_manuals_chrono_simulation_system_time_steppers", "label": "Time steppers / integrators", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/simulation_system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_chrono_simulation_system_euler_implicit_linearized", "label": "EULER_IMPLICIT_LINEARIZED", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/simulation_system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chrono default: fast, no sub-iterations, first-order accurate, works for DVI hard contacts, constraints kept closed by stabilization."}, {"id": "doxygen_documentation_manuals_chrono_simulation_system_hht", "label": "HHT integrator", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/simulation_system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Second-order accurate with adjustable numerical damping and exact constraint satisfaction via inner iterations, but slower and unusable for DVI hard contacts."}, {"id": "doxygen_documentation_manuals_chrono_simulation_system_newmark", "label": "Newmark integrator", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/simulation_system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Popular in the FEA community; first-order accurate except for the trapezoidal parameter choice."}, {"id": "doxygen_documentation_manuals_chrono_simulation_system_solvers", "label": "Solvers", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/simulation_system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Called by the time stepper to compute accelerations and reaction forces; usually the dominant computational cost."}, {"id": "doxygen_documentation_manuals_chrono_simulation_system_psor", "label": "PSOR solver", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/simulation_system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Low precision and may stall on odd mass ratios; used for small problems where accuracy is secondary."}, {"id": "doxygen_documentation_manuals_chrono_simulation_system_apgd", "label": "APGD solver", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/simulation_system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Very good convergence for DVI problems where high accuracy matters."}, {"id": "doxygen_documentation_manuals_chrono_simulation_system_barzilaiborwein", "label": "BARZILAIBORWEIN solver", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/simulation_system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Similar to APGD but potentially more robust with large mass ratios."}, {"id": "doxygen_documentation_manuals_chrono_simulation_system_minres", "label": "MINRES solver", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/simulation_system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Good convergence and FEA support, but no DVI hard-contact support."}, {"id": "doxygen_documentation_manuals_chrono_simulation_system_admm", "label": "ADMM solver (+ PardisoMKL)", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/simulation_system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only option covering FEA and DVI together; needs an inner linear solver, ideally PardisoMKL, else ChSolverSparseQR."}, {"id": "doxygen_documentation_manuals_chrono_simulation_system_solver_max_iterations", "label": "Iterative solver max-iteration tuning", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/chrono/simulation_system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Iterations must be raised until constraints stop being violated, which is the main knob for link-heavy models."}, {"id": "doxygen_documentation_manuals_chrono_simulation_system_max_penetration_recovery_speed", "label": "Max penetration recovery speed", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/chrono/simulation_system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Caps how fast interpenetrating bodies separate: large values make stacks jittery and bodies pop out, small values let objects sink when solver precision is low."}, {"id": "doxygen_documentation_manuals_chrono_simulation_system_min_bounce_speed", "label": "Min bounce speed", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/chrono/simulation_system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Below this incoming speed restitution is treated as zero, which stabilizes stacks at the cost of physical realism."}], "edges": [{"source": "doxygen_documentation_manuals_chrono_simulation_system_simulation_system", "target": "doxygen_documentation_manuals_chrono_simulation_system_chsystem", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/chrono/simulation_system.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_chrono_simulation_system_chsystemnsc", "target": "doxygen_documentation_manuals_chrono_simulation_system_chsystem", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/chrono/simulation_system.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_chrono_simulation_system_