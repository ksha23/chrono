{"nodes": [{"id": "doxygen_documentation_manuals_sensor_camera_sensor_camera_sensor_model", "label": "Camera Sensor Model", "file_type": "document", "source_file": "doxygen/documentation/manuals/sensor/camera_sensor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_sensor_camera_sensor_chcamerasensor", "label": "ChCameraSensor", "file_type": "concept", "source_file": "doxygen/documentation/manuals/sensor/camera_sensor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Synthetic images are generated with GPU ray tracing through NVIDIA OptiX headless rendering, using a physically based BRDF shader that recursively spawns shadow, reflection and refraction rays."}, {"id": "doxygen_documentation_manuals_sensor_camera_sensor_choptixengine", "label": "ChOptixEngine", "file_type": "concept", "source_file": "doxygen/documentation/manuals/sensor/camera_sensor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Camera update frequency is much lower than physics, so the engine spawns a dedicated rendering thread fed by a render queue and never blocks the main dynamics thread."}, {"id": "doxygen_documentation_manuals_sensor_camera_sensor_chfilteroptixrender", "label": "ChFilterOptixRender", "file_type": "concept", "source_file": "doxygen/documentation/manuals/sensor/camera_sensor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_sensor_camera_sensor_chfilterimgalias", "label": "ChFilterImgAlias", "file_type": "concept", "source_file": "doxygen/documentation/manuals/sensor/camera_sensor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Appended automatically when the camera supersample factor exceeds 1; the setup adjusts resolution and downsamples for antialiasing."}, {"id": "doxygen_documentation_manuals_sensor_camera_sensor_render_thread_model", "label": "Split main/render thread update model", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/sensor/camera_sensor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Main thread pushes cameras needing update into a render queue and later collects finished data; the render thread waits on the queue. Decouples slow sensor rates from fast physics stepping."}], "edges": [{"source": "doxygen_documentation_manuals_sensor_camera_sensor_camera_sensor_model", "target": "doxygen_documentation_manuals_sensor_camera_sensor_chcamerasensor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/sensor/camera_sensor.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_sensor_camera_sensor_chcamerasensor", "target": "doxygen_documentation_manuals_sensor_camera_sensor_choptixengine", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/sensor/camera_sensor.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_sensor_camera_sensor_chcamerasensor", "target": "doxygen_documentation_manuals_sensor_camera_sensor_chfilteroptixrender", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/sensor/camera_sensor.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_sensor_camera_sensor_chcamerasensor", "target": "doxygen_documentation_manuals_sensor_camera_sensor_chfilterimgalias", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/sensor/camera_sensor.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_sensor_camera_sensor_choptixengine", "target": "doxygen_documentation_manuals_sensor_camera_sensor_render_thread_model", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/sensor/camera_sensor.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_sensor_camera_sensor_render_thread_model", "target": "doxygen_documentation_manuals_sensor_sensor_overview_separate_data_thread", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "doxygen/documentation/manuals/sensor/camera_sensor.md", "source_location": null, "weight": 1.0}], "hyperedges": []}