{"nodes": [{"id": "doxygen_documentation_manuals_synchrono_synchrono_overview_synchrono", "label": "SynChrono", "file_type": "document", "source_file": "doxygen/documentation/manuals/synchrono/synchrono_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An SBEL project extending Chrono physics into the multi-agent realm by distributing each agent's dynamics across computing nodes instead of one monolithic simulation. Currently depends on Chrono::Vehicle, which the authors accept because Chrono::Vehicle itself adds no further dependencies; visualization is supported through Chrono::Irrlicht and Chrono::Sensor."}, {"id": "doxygen_documentation_manuals_synchrono_synchrono_overview_weak_coupling_assumption", "label": "Weak Inter-Agent Dynamic Coupling Assumption", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/synchrono/synchrono_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SynChrono is only suited to scenarios where each agent's dynamics matter individually but not through their interaction, as with autonomous vehicles absent a collision. Strongly coupled cases such as two underwater robots sharing a fluid belong in a single monolithic Chrono model instead."}, {"id": "doxygen_documentation_manuals_synchrono_synchrono_overview_heartbeat", "label": "Synchronization Heartbeat", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/synchrono_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All nodes advance at the same constant timestep but at different real-world speeds; they exchange state only after a fixed number of simulated timesteps, so faster nodes are not throttled every step. Between heartbeats zombie agents remain static."}, {"id": "doxygen_documentation_manuals_synchrono_synchrono_overview_zombie_agent", "label": "Zombie Agent", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/synchrono_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A remote agent's local stand-in, driven purely by received state. What it looks like (wheel count, chassis/wheel mesh files) is sent once at startup; where it is (poses) is sent every heartbeat, minimizing per-heartbeat payload."}, {"id": "doxygen_documentation_manuals_synchrono_synchrono_overview_flatbuffers_serialization", "label": "FlatBuffers Serialization", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/synchrono_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen to move agent state from C++ objects to wire bytes and back; every synchronized agent must supply a schema plus a class that packs and unpacks against it."}, {"id": "doxygen_documentation_manuals_synchrono_synchrono_overview_syncommunicator", "label": "SynCommunicator", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/synchrono_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transport abstraction taking charge of sending packed binary data to all other nodes. MPI and DDS exist today, but any backend satisfying the interchange contract can be added; DDS is usually preferred outside clusters where MPI is less available and UDP-capable, more flexible communication is needed."}, {"id": "doxygen_documentation_manuals_synchrono_synchrono_overview_state_information", "label": "Agent State Information", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/synchrono_overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately the minimum required to construct a zombie in another node's world, which is what keeps heartbeat bandwidth bounded as agent count grows."}], "edges": [{"source": "doxygen_documentation_manuals_synchrono_synchrono_overview_synchrono", "target": "doxygen_documentation_manuals_ros_ros_overview_sbel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/synchrono/synchrono_overview.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_synchrono_synchrono_overview_weak_coupling_assumption", "target": "doxygen_documentation_manuals_synchrono_synchrono_overview_synchrono", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/synchrono/synchrono_overview.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_synchrono_synchrono_overview_synchrono", "target": "doxygen_documentation_manuals_synchrono_synchrono_overview_heartbeat", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/synchrono/synchrono_overview.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_synchrono_synchrono_overview_heartbeat", "target": "doxygen_documentation_manuals_synchrono_synchrono_overview_zombie_agent", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/synchrono/synchrono_overview.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_synchrono_synchrono_overview_zombie_agent", "target": "doxygen_documentation_manuals_synchrono_synchrono_overview_state_information", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/synchrono/synchrono_overview.md", "so