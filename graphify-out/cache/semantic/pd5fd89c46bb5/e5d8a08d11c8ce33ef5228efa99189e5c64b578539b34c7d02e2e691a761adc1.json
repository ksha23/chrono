{"nodes": [{"id": "doxygen_documentation_manuals_vehicle_wheeled_suspension_chsuspension", "label": "ChSuspension (suspension base class)", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_suspension.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Base class contract: a suspension template must supply left/right wheel spindles on revolute joints plus two ChShaft spindle axles so a driveline can be attached; the suspension reference frame may be relocated but not reoriented, staying parallel to the chassis ISO frame."}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_suspension_chshaft", "label": "ChShaft (spindle axle)", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_suspension.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_suspension_hardpoint_mirroring", "label": "Left-Side Hardpoint Mirroring", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_suspension.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hardpoints are authored only for the left side and mirrored to build the right side, halving the specification data and guaranteeing symmetry by construction."}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_suspension_chdoublewishbone", "label": "ChDoubleWishbone (double wishbone suspension)", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_suspension.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_suspension_chdoublewishbonereduced", "label": "ChDoubleWishboneReduced (simplified double wishbone)", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_suspension.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Control arms are replaced by two distance constraints each; valid when control-arm mass and inertia are negligible relative to the other bodies, trading fidelity for fewer bodies."}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_suspension_chmacphersonstrut", "label": "ChMacPhersonStrut", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_suspension.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Preferred for small to mid-sized front-wheel-drive passenger cars with transverse engine/gearbox."}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_suspension_chmultilink", "label": "ChMultiLink", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_suspension.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Similar to a double wishbone axle but the trailing arm can carry high longitudinal forces."}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_suspension_chsemitrailingarm", "label": "ChSemiTrailingArm", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_suspension.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_suspension_chsolidaxle", "label": "ChSolidAxle (four-link solid axle)", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_suspension.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_suspension_chsolidthreelinkaxle", "label": "ChSolidThreeLinkAxle", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_suspension.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Allows very high wheel travel that leaf springs cannot deliver; air/coil springs require a link-guided axle, hence the three-link guidance."}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_suspension_chsolidbellcrankthreelinkaxle", "label": "ChSolidBellcrankThreeLinkAxle", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_suspension.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_suspension_chleafspringaxle", "label": "ChLeafspringAxle", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_suspension.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Work-alike model: the complex guiding behavior of leaf springs is replaced by a special joint at the center of the axle tube plus coil springs, which reproduces rolling behavior close to a real leaf-spring axle at much lower cost."}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_suspension_chtoebarleafspringaxle", "label": "ChToeBarLeafspringAxle", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_suspension.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_suspension_chsaeleafspringaxle", "label": "ChSAELeafspringAxle", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_suspension.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Follows the SAE Spring Design Handbook so that axle motion under wheel travel and the tie-up effect from longitudinal forces are reproduced correctly, unlike the work-alike leaf-spring model."}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_suspension_chsaetoebarleafspringaxle", "label": "ChSAEToeBarLeafspringAxle", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_suspension.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_suspension_sae_leaf_spring_model", "label": "SAE Leaf Spring Kinematic Model (5 points, 6 bodies)", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_suspension.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Leaf-spring kinematics defined by 5 points and realized as 6 rigid bodies (front leaf, front clamp, rear clamp, rear leaf, shackle) joined by rotational springs whose stiffness the user tunes."}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_suspension_chthreelinkirs", "label": "ChThreeLinkIRS (three-link independent rear suspension)", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_suspension.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_suspension_chrigidsuspension", "label": "ChRigidSuspension", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_suspension.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_vehicle_wheeled_suspension_chrigidpinnedaxle", "label": "ChRigidPinnedAxle", "file_type": "concept", "source_file": "doxygen/documentation/manuals/vehicle/wheeled_suspension.md", "source_location": null, "source_url": null, "captured_at": null, "aut