{"nodes": [{"id": "doxygen_documentation_manuals_chrono_rigid_bodies_rigid_bodies", "label": "Rigid Bodies (Chrono manual page)", "file_type": "document", "source_file": "doxygen/documentation/manuals/chrono/rigid_bodies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_chrono_rigid_bodies_chbody", "label": "ChBody", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/rigid_bodies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Position, rotation and their derivatives always refer to the center of mass; in the base ChBody the COM and the Ref frame coincide."}, {"id": "doxygen_documentation_manuals_chrono_rigid_bodies_chbodyauxref", "label": "ChBodyAuxRef", "file_type": "concept", "source_file": "doxygen/documentation/manuals/chrono/rigid_bodies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Introduces a secondary Ref frame that can be placed away from the COM, which is what visual and collision shapes are attached to."}, {"id": "doxygen_documentation_manuals_chrono_rigid_bodies_chbodyeasy", "label": "ChBodyEasy* primitive helpers", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/chrono/rigid_bodies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compute mass and inertia from a primitive shape and optionally build the visual and collision shapes, because plain ChBody ships with neither."}, {"id": "doxygen_documentation_manuals_chrono_rigid_bodies_com_vs_ref_frame", "label": "COM frame vs Ref frame distinction", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/chrono/rigid_bodies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": nul