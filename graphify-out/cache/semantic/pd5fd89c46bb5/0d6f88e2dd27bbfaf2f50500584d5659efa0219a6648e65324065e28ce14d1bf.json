{"nodes": [{"id": "src_chrono_vsg_cmakelists_chrono_vsg", "label": "Chrono_vsg Library Target", "file_type": "code", "source_file": "src/chrono_vsg/CMakeLists.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_chrono_vsg_cmakelists_vsgxchange_static_stb_guard", "label": "vsgXchange Static-Library STB Guard", "file_type": "rationale", "source_file": "src/chrono_vsg/CMakeLists.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If vsgXchange is a STATIC_LIBRARY it is assumed to already embed STB, so Chrono omits its own stb_image/stb_image_write translation units (and skips installing the stb headers); otherwise the link would fail with multiply-defined symbols. The target TYPE property is queried at configure time to decide."}, {"id": "src_chrono_vsg_cmakelists_vsgimgui_whole_archive", "label": "vsgImGui WHOLE_ARCHIVE Encapsulation", "file_type": "rationale", "source_file": "src/chrono_vsg/CMakeLists.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per imgui issue 586 there must be exactly one copy of ImGui in the final executable. When vsgImGui is static it is linked PRIVATE with $<LINK_LIBRARY:WHOLE_ARCHIVE,...> so it is hidden behind Chrono_vsg, while its include dirs, compile definitions and options are still re-exported PUBLIC; on MSVC /OPT:NOREF is added because Windows does not export static-library symbols by default."}], "edges": [{"source": "src_chrono_vehicle_cmakelists_stb_vendoring", "target": "src_chrono_vsg_cmakelists_vsgxchange_static_stb_guard", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "src/chrono_vsg/CMakeLists.txt", "source_location": null, "weight": 1.0}, {"source": "src_chrono_vsg_cmakelists_vsgxchange_static_stb_guard", "target": "src_chrono_vsg_cmakelists_chrono_vsg", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/chrono_vsg/CMakeLists.txt", "source_location": null, "weight": 1.0}, {"source": "src_chrono_vsg_cmakelists_vsgimgui_whole_archive", "target": "src_chrono_vsg_cmakelists_chrono_vsg", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/chrono_vsg/CMakeLists.txt", "source_location": null, "weight": 1.0}, {"source": "src_chrono_vsg_cmakelists_vsgimgui_whole_archive", "target": "src_chrono_vsg_cmakelists_vsgxchange_static_stb_guard", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "src/chrono_vsg/CMakeLists.txt", "source_location": null, "weight": 1.0}], "hyperedges": []}