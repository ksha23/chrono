{"nodes": [{"id": "doxygen_documentation_manuals_synchrono_state_synchronization_mpi_synchronization", "label": "MPI State Synchronization", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/state_synchronization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MPI is SynChrono's default because it is a robust 25-year-old standard with multiple implementations, ubiquitous in supercomputing clusters, and its runtime handles task launch and transport selection (shared memory, InfiniBand, TCP) for free. Each rank typically owns one ChSystem."}, {"id": "doxygen_documentation_manuals_synchrono_state_synchronization_mpi_two_call_exchange", "label": "MPI_Allgather / MPI_Allgatherv Two-Call Exchange", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/synchrono/state_synchronization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Message length is fixed for vehicles on rigid terrain but unknowable in advance for deformable terrain, so a first MPI_Allgather communicates each rank's message length and a second variable-length MPI_Allgatherv retrieves the payloads once buffers are sized."}, {"id": "doxygen_documentation_manuals_synchrono_state_synchronization_dds_synchronization", "label": "DDS State Synchronization", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/state_synchronization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DDS replaces MPI's rank-to-rank model with Real-Time Publish-Subscribe topics: one topic per agent, each agent owning a publisher and a subscriber, with data readers and writers handling each agent pair (four readers per agent in a five-node run). SynChrono's use of DDS is intentionally minimal, wrapping DDS concepts behind a small SynChrono API."}, {"id": "doxygen_documentation_manuals_synchrono_state_synchronization_fastdds", "label": "FastDDS", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/state_synchronization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Selected as the DDS vendor for the first release specifically to keep with Project Chrono's open source philosophy, rather than the more popular commercial RTI implementation."}, {"id": "doxygen_documentation_manuals_synchrono_state_synchronization_synchronomanager", "label": "SynChronoManager", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/state_synchronization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Holds a handle to exactly one SynCommunicator, which is the seam that lets the transport (MPI, DDS or a future backend) be swapped without touching agent code."}, {"id": "doxygen_documentation_manuals_synchrono_state_synchronization_syndds_wrappers", "label": "SynDDSCommunicator / SynDDSPublisher / SynDDSSubscriber / SynDDSTopic", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/state_synchronization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Thin SynChrono-level wrappers over DDS entities that expose accessors and setters for configuration and entity creation, so FlatBuffer message passing looks the same to agents regardless of backend."}], "edges": [{"source": "doxygen_documentation_manuals_synchrono_state_synchronization_mpi_two_call_exchange", "target": "doxygen_documentation_manuals_synchrono_state_synchronization_mpi_synchronization", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/synchrono/state_synchronization.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_synchrono_state_synchronization_mpi_synchronization", "target": "doxygen_documentation_manuals_synchrono_synchrono_overview_syncommunicator", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/synchrono/state_synchronization.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_synchrono_state_synchronization_dds_synchronization", "target": "doxygen_documentation_manuals_synchrono_synchrono_overview_syncommunicator", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/synchrono/state_synchronization.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_synchrono_state_synchronization_dds_synchronization", "target": "doxygen_documentation_manuals_synchrono_state_synchronization_fastdds", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/synchrono/state_synchronization.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_synchrono_state_synchronization_synchronomanager", "target": "doxygen_documentation_manuals_synchrono_synchrono_overview_syncommunicator", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/synchrono/state_synchronization.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_synchrono_state_synchronization_syndds_wrappers", "target": "doxygen_documentation_manuals_synchrono_state_synchronization_dds_synchronization", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/synchrono/state_synchronization.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_synchrono_state_syn