{"nodes": [{"id": "doxygen_documentation_tutorials_cascade_demo_robot_tutorial_demo_robot", "label": "Tutorial: Load a STEP File and Simulate a Robot (demo_CAS_robot.cpp)", "file_type": "document", "source_file": "doxygen/documentation/tutorials/cascade/demo_robot.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Marked obsolete in the docs and in need of deep updating to the latest Chrono version."}, {"id": "doxygen_documentation_tutorials_cascade_demo_robot_cascade_module", "label": "Chrono CASCADE Module", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/cascade/demo_robot.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_tutorials_cascade_demo_robot_chcascadedoc", "label": "ChCascadeDoc", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/cascade/demo_robot.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_tutorials_cascade_demo_robot_step_file_format", "label": "STEP File Format (ISO 10303)", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/cascade/demo_robot.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_tutorials_cascade_demo_robot_getnamedshape", "label": "ChCascadeDoc::GetNamedShape path lookup", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/cascade/demo_robot.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Addresses sub-assemblies like a Unix path with wildcards, and disambiguates repeated shape names with a #N instance suffix."}, {"id": "doxygen_documentation_tutorials_cascade_demo_robot_marker_placeholder_convention", "label": "Auxiliary Marker Placeholder Convention", "file_type": "rationale", "source_file": "doxygen/documentation/tutorials/cascade/demo_robot.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dummy 'marker' parts are inserted in the CAD assembly aligned with each joint axis, so the C++ side can recover joint positions and orientations from the STEP file instead of hard-coding coordinates."}, {"id": "doxygen_documentation_tutorials_cascade_demo_robot_solidedge_assembly_renaming_issue", "label": "SolidEdge Assembly Renaming Issue", "file_type": "rationale", "source_file": "doxygen/documentation/tutorials/cascade/demo_robot.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SolidEdge rewrites user assembly names to Assem1, Assem2, ... on STEP export, so the recommended workaround is to Dump the hierarchy and map the generated names back to the intended part names."}, {"id": "doxygen_documentation_tutorials_cascade_demo_robot_teaching_mode_inverse_kinematics", "label": "Teaching-Mode Inverse Kinematics via Lock Constraint", "file_type": "rationale", "source_file": "doxygen/documentation/tutorials/cascade/demo_robot.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Locking the hand marker to a driven marker yields inverse kinematics for any robot, including parallel manipulators and complex chains, without deriving an analytic IK expression."}, {"id": "doxygen_documentation_tutorials_cascade_demo_robot_minres_solver_choice", "label": "MINRES Solver Choice for Kinematic Chains", "file_type": "rationale", "source_file": "doxygen/documentation/tutorials/cascade/demo_robot.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed-point solvers (SOR, SSOR) converge poorly here because the hand at the end of the chain is far lighter than the other bodies; MINRES is fast and precise enough to keep the joints assembled, though unsuited to frictional collisions."}, {"id": "doxygen_documentation_tutorials_cascade_demo_robot_root_frame_transformation", "label": "Root Frame Transformation for CAD Axis Convention", "file_type": "rationale", "source_file": "doxygen/documentation/tutorials/cascade/demo_robot.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most CADs treat Y as horizontal while the simulation wants Y vertical, so a single root frame quaternion product pre-transforms every imported body."}, {"id": "doxygen_documentation_tutorials_cascade_demo_robot_chfunction_motion_law", "label": "ChFunctionSequence / ChFunctionRepeat Motion Law", "file_type": "concept", "source_file": "doxygen/documentation/tutorials/cascade/demo_robot.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "doxygen_documentation_tutorials_cascade_demo_robot_tutorial_demo_robot", "target": "doxygen_documentation_tutorials_cascade_demo_robot_cascade_module", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/cascade/demo_robot.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_cascade_demo_robot_tutorial_demo_robot", "target": "doxygen_documentation_tutorials_cascade_demo_robot_chcascadedoc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/cascade/demo_robot.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_tutorials_cascade_demo_robot_chcascadedoc", "target": "doxygen_documentation_tutorials_cascade_demo_robot_step_file_format", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/tutorials/c