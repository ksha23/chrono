{"nodes": [{"id": "src_chrono_thirdparty_yaml_cpp_docs_how_to_parse_a_document__old_api__yaml_parser", "label": "YAML::Parser (old API)", "file_type": "concept", "source_file": "src/chrono_thirdparty/yaml-cpp/docs/How-To-Parse-A-Document-(Old-API).md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The parser accepts streams, not file names, so callers must open the file themselves; a YAML file may hold many documents, so they are pulled one at a time."}, {"id": "src_chrono_thirdparty_yaml_cpp_docs_how_to_parse_a_document__old_api__getnextdocument", "label": "YAML::Parser::GetNextDocument", "file_type": "concept", "source_file": "src/chrono_thirdparty/yaml-cpp/docs/How-To-Parse-A-Document-(Old-API).md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_chrono_thirdparty_yaml_cpp_docs_how_to_parse_a_document__old_api__yaml_node", "label": "YAML::Node (old API)", "file_type": "concept", "source_file": "src/chrono_thirdparty/yaml-cpp/docs/How-To-Parse-A-Document-(Old-API).md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Node is deliberately non-copyable; Clone() exists so a node can outlive the document scope."}, {"id": "src_chrono_thirdparty_yaml_cpp_docs_how_to_parse_a_document__old_api__yaml_iterator", "label": "YAML::Iterator", "file_type": "concept", "source_file": "src/chrono_thirdparty/yaml-cpp/docs/How-To-Parse-A-Document-(Old-API).md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dereferencing a map iterator is undefined; first()/second() must be used to reach key and value nodes."}, {"id": "src_chrono_thirdparty_yaml_cpp_docs_how_to_parse_a_document__old_api__findvalue", "label": "YAML::Node::FindValue (optional keys)", "file_type": "rationale", "source_file": "src/chrono_thirdparty/yaml-cpp/docs/How-To-Parse-A-Document-(Old-API).md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "operator[] throws on a missing key, so FindValue returns a pointer instead and is preferred whenever keys are optional."}, {"id": "src_chrono_thirdparty_yaml_cpp_docs_how_to_parse_a_document__old_api__extraction_operator", "label": "operator>> overload for user types", "file_type": "rationale", "source_file": "src/chrono_thirdparty/yaml-cpp/docs/How-To-Parse-A-Document-(Old-API).md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Overloading the extraction operator lets an arbitrary struct be read in one operation instead of composing scalar/sequence/map reads by hand at every call site."}, {"id": "src_chrono_thirdparty_yaml_cpp_docs_how_to_parse_a_document__old_api__map_key_lookup_cost", "label": "O(n) map key lookup", "file_type": "rationale", "source_file": "src/chrono_thirdparty/yaml-cpp/docs/How-To-Parse-A-Document-(Old-API).md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reading a map by key loops over all entries, so reading a whole map key-by-key is O(n^2); the docs advise against it for maps with more than ~100 entries."}, {"id": "src_chrono_thirdparty_yaml_cpp_docs_how_to_parse_a_document__old_api__yaml_exception", "label": "YAML::Exception", "file_type": "concept", "source_file": "src/chrono_thirdparty/yaml-cpp/docs/How-To-Parse-A-Document-(Old-API).md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_chrono_thirdparty_yaml_cpp_docs_how_to_parse_a_document__old_api__parserexception", "label": "YAML::ParserException", "file_type": "concept", "source_file": "src/chrono_thirdparty/yaml-cpp/docs/How-To-Parse-A-Document-(Old-API).md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_chrono_thirdparty_yaml_cpp_docs_how_to_parse_a_document__old_api__representationexception", "label": "YAML::RepresentationException", "file_type": "concept", "source_file": "src/chrono_thirdparty/yaml-cpp/docs/How-To-Parse-A-Document-(Old-API).md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Signals a programming error (wrong node kind, missing key) rather than malformed input; callers avoid it by checking Node::Type() first."}, {"id": "src_chrono_thirdparty_yaml_cpp_docs_how_to_parse_a_document__old_api__nodetype", "label": "YAML::NodeType::value", "file_type": "concept", "source_file": "src/chrono_thirdparty/yaml-cpp/docs/How-To-Parse-A-Document-(Old-API).md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_chrono_thirdparty_yaml_cpp_docs_how_to_parse_a_document__old_api__clone", "label": "YAML::Node::Clone", "file_type": "concept", "source_file": "src/chrono_thirdparty/yaml-cpp/docs/How-To-Parse-A-Document-(Old-API).md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_chrono_thirdparty_yaml_cpp_docs_how_to_parse_a_document__old_api__monsters_example", "label": "monsters.yaml worked example", "file_type": "document", "source_file": "src/chrono_thirdparty/yaml-cpp/docs/How-To-Parse-A-Document-(Old-API).md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "src_chrono_thirdparty_yaml_cpp_docs_how_to_parse_a_document__old_api__yaml_parser", "target": "src_chrono_thirdparty_yaml_cpp_docs_how_to_parse_a_document__old_api__yaml_node", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/chrono_thirdparty/yaml-cpp/docs/How-To-Parse-A-Document-(Old-API).md", "source_location": null, 