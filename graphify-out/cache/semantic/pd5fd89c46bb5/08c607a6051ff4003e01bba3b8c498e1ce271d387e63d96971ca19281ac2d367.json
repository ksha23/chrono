{"nodes": [{"id": "doxygen_documentation_manuals_synchrono_terrain_synchronization_terrain_synchronization", "label": "Deformable Terrain Synchronization", "file_type": "document", "source_file": "doxygen/documentation/manuals/synchrono/terrain_synchronization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets multiple vehicles drive off-road and interact with the ruts and deformation each other leaves behind."}, {"id": "doxygen_documentation_manuals_synchrono_terrain_synchronization_scm_sync_state", "label": "SCM deformed-node state message", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/synchrono/terrain_synchronization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SCM keeps only deformed nodes in a hash map, displaces them only vertically, and carries no soil history, so a list of (int x, int y, double z) fully captures the shared state."}, {"id": "doxygen_documentation_manuals_synchrono_terrain_synchronization_synscmterrainagent", "label": "SynSCMTerrainAgent", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/terrain_synchronization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The terrain resets its deformed-node list every physics step but SynChrono only sends every heartbeat, so the agent merges per-step lists into its own map and clears it once per heartbeat."}, {"id": "doxygen_documentation_manuals_synchrono_terrain_synchronization_setmodifiednodes", "label": "SCMTerrain::SetModifiedNodes", "file_type": "concept", "source_file": "doxygen/documentation/manuals/synchrono/terrain_synchronization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doxygen_documentation_manuals_synchrono_terrain_synchronization_terrain_sync_caveats", "label": "Terrain synchronization caveats", "file_type": "rationale", "source_file": "doxygen/documentation/manuals/synchrono/terrain_synchronization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing stops ranks from configuring different soil properties, and if two vehicles modify the same node in one heartbeat the winning update is arbitrary - acceptable because only nodes under the wheels are touched and vehicles are already assumed not to collide."}], "edges": [{"source": "doxygen_documentation_manuals_synchrono_terrain_synchronization_terrain_synchronization", "target": "doxygen_documentation_manuals_synchrono_terrain_synchronization_synscmterrainagent", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/synchrono/terrain_synchronization.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_synchrono_terrain_synchronization_terrain_synchronization", "target": "doxygen_documentation_manuals_synchrono_terrain_synchronization_scm_sync_state", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/synchrono/terrain_synchronization.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_synchrono_terrain_synchronization_terrain_synchronization", "target": "doxygen_documentation_manuals_synchrono_terrain_synchronization_terrain_sync_caveats", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doxygen/documentation/manuals/synchrono/terrain_synchronization.md", "source_location": null, "weight": 1.0}, {"source": "doxygen_documentation_manuals_synchrono_terrain_synchronization_terrain_synchronization", "target": "doxygen_documentation_manuals_vehicle_vehicle_terrain_scmterrain", "relation": "references", "confidence": "EXTRACTED